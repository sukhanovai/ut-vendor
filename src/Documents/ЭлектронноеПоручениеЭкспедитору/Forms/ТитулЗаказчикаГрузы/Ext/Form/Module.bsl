&НаКлиенте
Процедура ТитулЗаказчикаГрузыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
		
	ИменаПолей = Новый Массив;
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыУказКлнт"); 
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСвТС");
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСвКонтейн");
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСопрДокПарт");
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыРеквЗакПост"); 
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСвУсл");
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСвУведСторон"); 	
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСвСтрахПолис");
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаГрузыСвСтрахУслСтрах"); 
	ИменаПолей.Добавить("ЗаполнитьТитулЗаказчикаОписаниеГруза");
	
	Если ИменаПолей.Найти(Поле.Имя) <> Неопределено Тогда
		ОбменСГИСЭПДКлиент.ВывестиФормуВводаДанных(ЭтотОбъект, Поле.Имя, Элемент.ТекущиеДанные);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТитулЗаказчикаГрузыПередУдалением(Элемент, Отказ)
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторСтроки = Неопределено;
		ТекущиеДанные.Свойство("ИдентификаторСтроки", ИдентификаторСтроки);
		ОбменСГИСЭПДКлиент.ОчиститьПодчиненныеТаблицы(ЭтотОбъект, Элемент.Имя, ИдентификаторСтроки, Отказ);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТитулЗаказчикаГрузыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	ОбменСГИСЭПДКлиент.ТаблицаПриНачалеРедактирования(Элемент, ЭтотОбъект, НоваяСтрока, Копирование);
	
	Если НоваяСтрока Тогда
		ТекущиеДанные = Элемент.ТекущиеДанные; 
		ТекущиеДанные.ПрУведСторон = Ложь;
		ТекущиеДанные.ПрзПрвз = "0";
	КонецЕсли;

КонецПроцедуры 

