КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

&НаКлиенте
Процедура Подключаемый_ВыполнитьПереопределяемуюКоманду(Команда)
	
	СобытияФормКлиент.ВыполнитьПереопределяемуюКоманду(ЭтотОбъект, Команда);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОжидаетсяПоставкаПриИзменении(Элемент)
	
	Использовать = ЗначениеЗаполнено(Состояние);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
			Список,
			"ОжидаетсяПоставка",
			Состояние,
			ВидСравненияКомпоновкиДанных.Равно,,
			Использовать);
	
КонецПроцедуры

&НаКлиенте
Процедура СостояниеОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Состояние = Неопределено;
	ОжидаетсяПоставкаПриИзменении(Элемент);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СоздатьПриобретениеТоваровУслугНаОснованииЗавершение(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОткрытьПриобретениеНаОсновании(ВыбранныйЭлемент.Значение, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьПриобретениеНаОсновании(Склад, ДОПП)
	
	Основание = Новый Структура();
	Основание.Вставить("ДокументОснование", ДОПП);
	Основание.Вставить("Склад", Склад);
	
	ПараметрыОткрытия = Новый Структура();
	ПараметрыОткрытия.Вставить("Основание", Основание);
	
	ОткрытьФорму("Документ.ПриобретениеТоваровУслуг.Форма.ФормаДокумента", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УсловияВыбораВариантаВыполнены(ЗаказПоставщику, СписокСкладов)
	
	Если Не ЗначениеЗаполнено(ЗаказПоставщику) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Склад = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗаказПоставщику, "Склад");
	Если Не ЗначениеЗаполнено(Склад) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВыборГруппы = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Склад, "ВыборГруппы");
	
	РазрешитьВЗаказах = ВыборГруппы = Перечисления.ВыборГруппыСкладов.РазрешитьВЗаказах;
	
	Если РазрешитьВЗаказах Тогда
		СписокСкладов = СкладыЗаказаПоставщику(ЗаказПоставщику);
	КонецЕсли;
	
	Возврат РазрешитьВЗаказах;
	
КонецФункции

&НаСервереБезКонтекста
Функция СкладыЗаказаПоставщику(ЗаказПоставщику)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Товары.Склад КАК Склад
		|ИЗ
		|	Документ.ЗаказПоставщику.Товары КАК Товары
		|ГДЕ
		|	Товары.Ссылка = &Ссылка
		|	И Товары.Склад <> ЗНАЧЕНИЕ(Справочник.Склады.ПустаяСсылка)
		|УПОРЯДОЧИТЬ ПО
		|	Склад";
	Запрос.УстановитьПараметр("Ссылка", ЗаказПоставщику);
	
	СписокСкладов = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокСкладов.Добавить(Выборка.Склад);
	КонецЦикла;
	
	Возврат СписокСкладов;
	
КонецФункции

#КонецОбласти
