Процедура ПроверитьОтсутствиеТранзакции(Знач Контекст)
	ПроверитьСостояниеТранзакции(Контекст, Ложь);
КонецПроцедуры

// Параметры:
//  Контекст         - Строка
//  ЦелевоеСостояние - Булево
Процедура ПроверитьСостояниеТранзакции(Знач Контекст, Знач ЦелевоеСостояние)
	
	ТекущееСостояние      = ТранзакцияАктивна();
	ФорматированнаяСтрока = "БЛ='не активна'; БИ=активна;";
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		ТекущееСостояние = ЦелевоеСостояние,
		СтрШаблон(
			НСтр(
				"ru = 'Недопустимое состояние транзакции:
				|Текущее состояние: %1
				|Ожидаемое состояние: %2'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			Формат(ТекущееСостояние, ФорматированнаяСтрока),
			Формат(ЦелевоеСостояние, ФорматированнаяСтрока)),
		Контекст);
	
КонецПроцедуры

// Параметры:
//  Контекст - Строка
Процедура ПроверитьНаличиеПодсистемыБизнесСеть(Знач Контекст)
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		ОбщегоНазначения.ПодсистемаСуществует("ЭлектронноеВзаимодействие.БизнесСеть"),
		НСтр(
			"ru = 'Для отправки документов через сервис 1С:EDI требуется подсистема 1С:Бизнес-сеть'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Контекст);
	
КонецПроцедуры

// Параметры:
//  Контекст          - Строка
//  ИмяПараметра      - Строка
//  ЗначениеПараметра - Строка
Процедура ПроверитьИдентификатор(Знач Контекст, Знач ИмяПараметра, Знач ЗначениеПараметра)
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(Контекст, ИмяПараметра, ЗначениеПараметра, Тип("Строка"));
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не ПустаяСтрока(ЗначениеПараметра),
		СтрШаблон(
			НСтр(
				"ru = 'Значение параметра %1 не может содержать пустую строку'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			ИмяПараметра),
		Контекст);
	
КонецПроцедуры

// Параметры:
//  Контекст          - Строка
//  ИмяПараметра      - Строка
//  ЗначениеПараметра - Произвольный
//  ТипПараметра      - ОписаниеТипов
Процедура ПроверитьУчастника(Знач Контекст, Знач ИмяПараметра, Знач ЗначениеПараметра, Знач ТипПараметра)
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(Контекст, ИмяПараметра, ЗначениеПараметра, ТипПараметра);
	ОбщегоНазначенияКлиентСервер.Проверить(
		ЗначениеЗаполнено(ЗначениеПараметра),
		СтрШаблон(
			НСтр(
				"ru = 'Значение параметра %1 не может содержать пустое значение'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			ИмяПараметра),
		Контекст);
	
