// @strict-types

#Область СлужебныйПрограммныйИнтерфейс

#Область ОбновлениеКонфигурации

// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления.
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	РегистрыСведений.СведенияОФайлахСообщенийЭДО.ПриДобавленииОбработчиковОбновления(Обработчики);
КонецПроцедуры

#КонецОбласти

#Область РеализацияПрограммногоИнтерфейса

// См. СервисEDI.ПолучитьСообщения 
Функция ПолучитьСообщения() Экспорт
	
	РезультатПолученияДокументов = СинхронизацияЭДОСлужебный.НовыйРезультатПолученияДокументов();
	КлючиСинхронизации           = СинхронизацияЭДОКлиентСервер.НовыеКлючиСинхронизации();
	КонтекстДиагностики          = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
	РезультатыОтправкиПолучения  = ЭлектронныеДокументыЭДОКлиентСервер.НовыеРезультатыОтправкиПолучения();
	
	ПолучитьНовыеЭлектронныеДокументыЧерезСервис1СEDI(
		РезультатПолученияДокументов, 
		КлючиСинхронизации, 
		КонтекстДиагностики,
		РезультатыОтправкиПолучения);
	
	РаспаковатьКонтейнеры(РезультатПолученияДокументов.Контейнеры);
	
	Возврат РезультатПолученияДокументов.Контейнеры;
	
КонецФункции

#КонецОбласти

#Область ИнтеграцияОбменСКонтрагентами

// Отправляет транспортный контейнер через сервис 1С:EDI.
// 
// Параметры:
//  ПараметрыОтправки   - См. СинхронизацияЭДОСлужебный.НовыеПараметрыОтправкиТранспортногоКонтейнера
//  КонтекстДиагностики - См. ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики
// 
// Возвращаемое значение:
//  См. СинхронизацияЭДОСлужебный.НовыйРезультатОтправкиТранспортногоКонтейнера
Функция ОтправитьКонтейнер(Знач ПараметрыОтправки, КонтекстДиагностики) Экспорт
	
	Результат = СинхронизацияЭДОСлужебный.НовыйРезультатОтправкиТранспортногоКонтейнера();
	
	РезультатВыполнения = ОтправитьСообщение(ПараметрыОтправки);
	
	Если РезультатВыполнения.Отказ Тогда
		Ошибка = СинхронизацияЭДО.НоваяОшибкаПередачи();
		Ошибка.Код = КодОшибкиТранспорта();
		Ошибка.Блокирующая = Истина;
		Ошибка.Описание    = РезультатВыполнения.ТекстОшибки;
		
		Результат.Успех          = Ложь;
		Результат.ОшибкаПередачи = Ошибка;
		
		ВидОперации = НСтр(
			"ru = 'Отправка транспортного контейнера ЭДО через сервис 1С:EDI'",
			ОбщегоНазначения.КодОсновногоЯзыка());
		
		ТекстСообщения = 
			СтрШаблон(
				НСтр(
					"ru = 'Не удалось отправить сообщение через сервис 1С:EDI по причине: %1'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				РезультатВыполнения.ТекстОшибки);
		Ошибка = ОбработкаНеисправностейБЭД.НоваяОшибка(
			ВидОперации,
			ОбработкаНеисправностейБЭДКлиентСервер.ВидОшибкиНеизвестнаяОшибка(), 
			ТекстСообщения, 
			ТекстСообщения);
		ОбработкаНеисправностейБЭД.ДобавитьОшибку(КонтекстДиагностики, Ошибка,
			ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами);
	Иначе
		Результат.Успех = Истина;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли способ обмена через сервис 1С:EDI
// 
// Параметры:
//  СпособОбмена - ПеречислениеСсылка.СпособыОбменаЭД - Способ обмена
// 
// Возвращаемое значение:
//  Булево - Истина, если это обмен через сервис 1С:EDI
Функция ЭтоОбменЧерезСервис1СEDI(Знач СпособОбмена) Экспорт
	Возврат СпособыОбмена().Найти(СпособОбмена) <> Неопределено;
КонецФункции

// Возвращает способы обмена ЭД через сервис 1С:EDI
// 
// Возвращаемое значение:
//  Массив Из ПеречислениеСсылка.СпособыОбменаЭД - Способы обмена через сервис 1С:EDI
Функция СпособыОбмена() Экспорт
	
	Результат = Новый Массив; // Массив Из ПеречислениеСсылка.СпособыОбменаЭД
	
	Результат.Добавить(Перечисления.СпособыОбменаЭД.Через1СБизнесСеть);
	Результат.Добавить(Перечисления.СпособыОбменаЭД.ЧерезСервис1СEDI);
	
	Возврат Результат;
	
КонецФункции

// Получить новые электронные документы от оператора ЭДО.
//
// Параметры:
//  РезультатПолученияДокументов - См. СинхронизацияЭДОСлужебный.НовыйРезультатПолученияДокументов
//  КлючиСинхронизации           - См. СинхронизацияЭДОКлиентСервер.НовыеКлючиСинхронизации
//  КонтекстДиагностики          - См. ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики
//  РезультатыОтправкиПолучения  - См. ЭлектронныеДокументыЭДОКлиентСервер.НовыеРезультатыОтправкиПолучения
Процедура ПолучитьНовыеЭлектронныеДокументыЧерезСервис1СEDI(
	РезультатПолученияДокументов,
	КлючиСинхронизации, 
	КонтекстДиагностики, 
	РезультатыОтправкиПолучения) Экспорт
	
	Контекст      = "СервисEDIСлужебный.ПолучитьНовыеЭлектронныеДокументыЧерезСервис1СEDI";
	УчетныеЗаписи = УчетныеЗаписи();
	
	ПроверитьОтсутствиеТранзакции(Контекст);
	
	Для Каждого УчетнаяЗапись Из УчетныеЗаписи Цикл
		Попытка
			ПолучитьДокументыПоОрганизации(РезультатПолученияДокументов, УчетнаяЗапись);
		Исключение
			ТекстОшибки = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			Операция = НСтр("ru = 'Получение электронных документов через сервис 1С:EDI'");
			ПодробноеПредставлениеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ОбработкаНеисправностейБЭД.ОбработатьОшибку(
				Операция, ОбщегоНазначенияБЭДКлиентСервер.ПодсистемыБЭД().ОбменСКонтрагентами,
				ПодробноеПредставлениеОшибки, ТекстОшибки);
			Продолжить; // Не прерываем обработку других учетных записей
		КонецПопытки;
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, является ли переданный ключ ключом обмена через сервис 1С:EDI
// 
// Параметры:
//  КлючНастроекЭДО - См. НастройкиЭДОКлиентСервер.НовыйКлючНастроекОтправки
// 
// Возвращаемое значение:
//  Булево - Истина, если это ключ настроек для обмена через сервис 1С:EDI.
//           Ложь, в ином случае.
Функция ЭтоКлючНастроекЧерезСервис1СEDI(Знач КлючНастроекЭДО) Экспорт
	
	НастройкиОтправки = НастройкиЭДО.НастройкиОтправки(КлючНастроекЭДО);
	
	Если НастройкиОтправки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЭтоОбменЧерезСервис1СEDI(НастройкиОтправки.СпособОбмена);
	
КонецФункции

// Проверяет, является ли код ошибки кодом ошибки транспорта через сервис 1С:EDI
// 
// Параметры:
//  КодОшибки - Строка - Проверяемый код ошибки
// 
// Возвращаемое значение:
//  Булево - Истина, если это ошибка транспорта через сервис 1С:EDI
Функция ЭтоКодОшибкиТранспорта(Знач КодОшибки) Экспорт
	Возврат КодОшибки = КодОшибкиТранспорта();
КонецФункции

// Параметры:
//  СообщениеОбъект - ДокументОбъект.СообщениеЭДО
//  ОписаниеСообщения - см. ЭлектронныеДокументыЭДО.НовоеОписаниеСообщения
//  НастройкиДокумента - Структура:
//  * ТипДокумента           - ПеречислениеСсылка.ТипыДокументовЭДО
//  * ТипРегламента          - ПеречислениеСсылка.ТипыРегламентовЭДО
//  * ТребуетсяПодтверждение - Булево
//  * ОбменБезПодписи        - Булево
//  * СпособОбмена           - ПеречислениеСсылка.СпособыОбменаЭД
Процедура ЗафиксироватьСведенияОФайлахСообщенийЭДО(
	Знач СообщениеОбъект, 
	Знач ОписаниеСообщения, 
	Знач НастройкиДокумента) Экспорт
	
	ИдентификаторДокументооборота = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		СообщениеОбъект.ЭлектронныйДокумент, "ИдентификаторДокументооборота");
	ИмяФайла = ОписаниеСообщения.Данные.Документ.ИмяФайла; 
	СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайла);
	
	Сведения = РегистрыСведений.СведенияОФайлахСообщенийЭДО.НовыеСведенияОСообщении();
	
	Сведения.ФайлСообщенияЭДО              = СообщениеОбъект.ОсновнойФайл;
	Сведения.ИдентификаторДокументооборота = ИдентификаторДокументооборота;
	//@skip-check property-return-type
	//@skip-check statement-type-change
	Сведения.ИмяФайла                      = СтруктураИмениФайла.ИмяБезРасширения; // Строка
	
	РегистрыСведений.СведенияОФайлахСообщенийЭДО.Зафиксировать(Сведения);
	
КонецПроцедуры

// Параметры:
//  ОписаниеКонтейнера - См. ТранспортныеКонтейнерыЭДО.РаспаковатьФайлКонтейнера
Процедура ВыполнитьПоискИдентификаторовДокументооборотаПоИмениФайла(ОписаниеКонтейнера) Экспорт
	
	ДокументыКонтейнера = ОбщегоНазначенияБЭД.ЗначениеПоПути(
		ОписаниеКонтейнера, 
		"Метаданные.Документы"); // Массив из См. ТранспортныеКонтейнерыЭДО.НовоеОписаниеДокументаКонтейнера
		
	Если ДокументыКонтейнера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДокументКонтейнера Из ДокументыКонтейнера Цикл
		ВыполнитьПоискИдентификаторовДокументооборотаДокументаПоИмениФайла(ДокументКонтейнера);
	КонецЦикла;
	
КонецПроцедуры

// Параметры:
//  ТаблицаНастроек - ТаблицаЗначений:
//   * СпособОбменаЭД - ПеречислениеСсылка.СпособыОбменаЭД
//   * Формировать    - Булево
Процедура ПриЗаполненииНастроекОтправкиЭлектронныхДокументовПоВидам(ТаблицаНастроек) Экспорт 
	
	СпособыОбменаЭД = ТаблицаНастроек.ВыгрузитьКолонку("СпособОбменаЭД");
	СпособыОбменаЭД = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СпособыОбменаЭД);
	
	Индекс = СпособыОбменаЭД.Найти(Перечисления.СпособыОбменаЭД.ПустаяСсылка());
	
	Если Индекс <> Неопределено Тогда
		СпособыОбменаЭД.Удалить(Индекс);
	КонецЕсли;
	
	Если СпособыОбменаЭД.Количество() = 1
		И СпособыОбменаЭД[0] = СпособОбмена() Тогда
			
		Отбор = Новый Структура;
		Отбор.Вставить("СпособОбменаЭД", Перечисления.СпособыОбменаЭД.ПустаяСсылка());
		
		Строки = ТаблицаНастроек.НайтиСтроки(Отбор);
		
		Для каждого Строка Из Строки Цикл
			Строка.Формировать = Ложь;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиЭДО

// См. СервисEDIСлужебныйКлиент.ТребуетсяНастройкаОбмена
Функция ТребуетсяНастройкаОбмена(КлючНастроек) Экспорт
	
	Если ИспользуетсяКонтрагентДляВидаДокументаЭПД(КлючНастроек.ВидДокумента) Тогда
		Возврат ТребуетсяНастройкаОбменаСУчастником(
				КлючНастроек.Организация,
				КлючНастроек.Перевозчик,
				КлючНастроек.Договор,
				КлючНастроек.ВидДокумента)
			Или ТребуетсяНастройкаОбменаСУчастником(
				КлючНастроек.Организация,
				КлючНастроек.Контрагент,
				КлючНастроек.Договор,
				КлючНастроек.ВидДокумента);
	Иначе
		Возврат ТребуетсяНастройкаОбменаСУчастником(
			КлючНастроек.Организация,
			КлючНастроек.Перевозчик,
			КлючНастроек.Договор,
			КлючНастроек.ВидДокумента);
	КонецЕсли;

КонецФункции

// Получает настройки обмена по организации, контрагенту и виду документа
// 
// Параметры:
//  Организация  - ОпределяемыйТип.Организация        - Отправитель для настроек
//  Контрагент   - ОпределяемыйТип.УчастникЭДО        - Получатель для настроек
//  ВидДокумента - СправочникСсылка.ВидыДокументовЭДО - Вид документа для настроек
// 
// Возвращаемое значение:
//  См. НастройкиОтправкиЭДО.НастройкиОтправки
Функция НастройкиОбмена(Знач Организация, Знач Контрагент, Знач ВидДокумента) Экспорт
	
	КлючНастроекЭДО = НастройкиЭДОКлиентСервер.НовыйКлючНастроекОтправки();
	
	КлючНастроекЭДО.Отправитель   = Организация;
	КлючНастроекЭДО.Получатель    = Контрагент;
	КлючНастроекЭДО.Договор       = ПустойДоговор();
	КлючНастроекЭДО.ВидДокумента  = ВидДокумента;
	
	Результат = НастройкиЭДО.НастройкиОтправки(КлючНастроекЭДО);
	
	Если Результат = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Не ЭтоОбменЧерезСервис1СEDI(Результат.СпособОбмена) Тогда
		ВызватьИсключение(
			СтрШаблон(
				НСтр(
					"ru = 'Недопустим ввод настроек через сервис 1С:EDI. 
					|Настройки введены ранее для другого оператора:
					|- Организация: %1
					|- Контрагент: %2
					|- Вид документа: %3
					|- Способ обмена: %4'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				Организация,
				Контрагент,
				ВидДокумента,
				Результат.СпособОбмена));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор настроек обмена ЭТрН через сервис 1С:EDI
// 
// Возвращаемое значение:
//  Структура - Настройки:
//   * Организация               - ОпределяемыйТип.Организация                - Организация настроек
//                               - Неопределено                               - Не задан
//   * Контрагент                - ОпределяемыйТип.УчастникЭДО                - Контрагент настроек
//                               - Неопределено                               - Не задан
//   * Перевозчик                - ОпределяемыйТип.УчастникЭДО                - Перевозчик настроек
//                               - Неопределено                               - Не задан
//   * ИдентификаторОрганизации  - Строка                                     - Идентификатор ЭДО организации
//   * ИдентификаторКонтрагента  - Строка                                     - Идентификатор ЭДО контрагента
//   * ИдентификаторПеревозчика  - Строка                                     - Идентификатор ЭДО перевозчика
//   * Сертификат                - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Сертификат
//   * Доверенность              - ОпределяемыйТип.МашиночитаемаяДоверенность - Доверенность сертификата
//                               - Неопределено                               - Не задана
Функция НовыеНастройкиЭТрН() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация" , Неопределено);
	Результат.Вставить("Контрагент"  , Неопределено);
	Результат.Вставить("Перевозчик"  , Неопределено);
	
	Результат.Вставить("ИдентификаторОрганизации", "");
	Результат.Вставить("ИдентификаторКонтрагента", "");
	Результат.Вставить("ИдентификаторПеревозчика", "");
	
	Результат.Вставить("Сертификат"  , Справочники.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка());
	Результат.Вставить("Доверенность", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор настроек обмена ЭЗЗ через сервис 1С:EDI
// 
// Возвращаемое значение:
//  Структура - Настройки:
//   * Организация               - ОпределяемыйТип.Организация                - Организация настроек
//                               - Неопределено                               - Не задан
//   * Перевозчик                - ОпределяемыйТип.УчастникЭДО                - Перевозчик настроек
//                               - Неопределено                               - Не задан
//   * ИдентификаторОрганизации  - Строка                                     - Идентификатор ЭДО организации
//   * ИдентификаторПеревозчика  - Строка                                     - Идентификатор ЭДО перевозчика
//   * Сертификат                - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Сертификат
//   * Доверенность              - ОпределяемыйТип.МашиночитаемаяДоверенность - Доверенность сертификата
//                               - Неопределено                               - Не задана
Функция НовыеНастройкиЭЗЗ() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация" , Неопределено);
	Результат.Вставить("Перевозчик"  , Неопределено);
	
	Результат.Вставить("ИдентификаторОрганизации", "");
	Результат.Вставить("ИдентификаторПеревозчика", "");
	
	Результат.Вставить("Сертификат"  , Справочники.СертификатыКлючейЭлектроннойПодписиИШифрования.ПустаяСсылка());
	Результат.Вставить("Доверенность", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Записывает настройки обмена через сервис 1С:EDI.
// 
// Параметры:
//  Настройки - См. НовыеНастройкиЭТрН
Процедура ЗаписатьНастройкиЭТрН(Знач Настройки) Экспорт
	
	Контекст = "СервисEDIСлужебный.ЗафиксироватьНастройки";
	
	ПроверитьНаличиеПодсистемыБизнесСеть(Контекст);
	
	ВидДокументаЭЗЗ = ВидДокумента(Перечисления.ТипыДокументовЭДО.ЭЗЗ);
	ВидДокументаЭТрН = ВидДокумента(Перечисления.ТипыДокументовЭДО.ЭТрН);
	
	Организация = Настройки.Организация;
	Контрагент  = Настройки.Контрагент;
	Перевозчик  = Настройки.Перевозчик;
	
	ПроверитьУчастника(Контекст, "Настройки.Организация", Организация, Метаданные.ОпределяемыеТипы.Организация.Тип);
	ПроверитьУчастника(Контекст, "Настройки.Контрагент", Контрагент, Метаданные.ОпределяемыеТипы.УчастникЭДО.Тип);
	ПроверитьУчастника(Контекст, "Настройки.Перевозчик", Перевозчик, Метаданные.ОпределяемыеТипы.УчастникЭДО.Тип);
	
	ИдентификаторОрганизации = Настройки.ИдентификаторОрганизации;
	ИдентификаторКонтрагента = Настройки.ИдентификаторКонтрагента;
	ИдентификаторПеревозчика = Настройки.ИдентификаторПеревозчика;
	
	ПроверитьИдентификатор(Контекст, "Настройки.ИдентификаторОрганизации", ИдентификаторОрганизации);
	ПроверитьИдентификатор(Контекст, "Настройки.ИдентификаторКонтрагента", ИдентификаторКонтрагента);
	ПроверитьИдентификатор(Контекст, "Настройки.ИдентификаторПеревозчика", ИдентификаторПеревозчика);
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуУчетнойЗаписи(ИдентификаторОрганизации);
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокументаЭТрН, Организация, Контрагент);
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокументаЭТрН, Организация, Перевозчик);
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокументаЭЗЗ, Организация, Перевозчик);
		
		ЗаписатьУчетнуюЗапись(
			Организация, 
			ИдентификаторОрганизации);
		ЗаписатьСертификатУчетнойЗаписи(
			ИдентификаторОрганизации, 
			Настройки.Сертификат,
			Настройки.Доверенность);
		ЗаписатьИдентификаторы(
			ВидДокументаЭТрН,
			Организация, 
			Контрагент, 
			ИдентификаторОрганизации, 
			ИдентификаторКонтрагента);
		ЗаписатьИдентификаторы(
			ВидДокументаЭТрН,
			Организация, 
			Перевозчик, 
			ИдентификаторОрганизации, 
			ИдентификаторПеревозчика);
		ЗаписатьИдентификаторы(
			ВидДокументаЭЗЗ,
			Организация, 
			Перевозчик, 
			ИдентификаторОрганизации, 
			ИдентификаторПеревозчика);	
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
		
КонецПроцедуры

// Записывает настройки обмена через сервис 1С:EDI.
// 
// Параметры:
//  Настройки - См. НовыеНастройкиЭЗЗ
Процедура ЗаписатьНастройкиЭЗЗ(Знач Настройки) Экспорт
	
	Контекст = "СервисEDIСлужебный.ЗафиксироватьНастройки";
	
	ПроверитьНаличиеПодсистемыБизнесСеть(Контекст);
	
	ВидДокументаЭЗЗ = ВидДокумента(Перечисления.ТипыДокументовЭДО.ЭЗЗ);
	ВидДокументаЭТрН = ВидДокумента(Перечисления.ТипыДокументовЭДО.ЭТрН);
	
	Организация = Настройки.Организация;
	Перевозчик  = Настройки.Перевозчик;
	
	ПроверитьУчастника(Контекст, "Настройки.Организация", Организация, Метаданные.ОпределяемыеТипы.Организация.Тип);
	ПроверитьУчастника(Контекст, "Настройки.Перевозчик", Перевозчик, Метаданные.ОпределяемыеТипы.УчастникЭДО.Тип);
	
	ИдентификаторОрганизации = Настройки.ИдентификаторОрганизации;
	ИдентификаторПеревозчика = Настройки.ИдентификаторПеревозчика;
	
	ПроверитьИдентификатор(Контекст, "Настройки.ИдентификаторОрганизации", ИдентификаторОрганизации);
	ПроверитьИдентификатор(Контекст, "Настройки.ИдентификаторПеревозчика", ИдентификаторПеревозчика);
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуУчетнойЗаписи(ИдентификаторОрганизации);
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокументаЭЗЗ, Организация, Перевозчик);
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокументаЭТрН, Организация, Перевозчик);
		
		ЗаписатьУчетнуюЗапись(
			Организация, 
			ИдентификаторОрганизации);
		ЗаписатьСертификатУчетнойЗаписи(
			ИдентификаторОрганизации, 
			Настройки.Сертификат,
			Настройки.Доверенность);
		ЗаписатьИдентификаторы(
			ВидДокументаЭЗЗ,
			Организация, 
			Перевозчик, 
			ИдентификаторОрганизации, 
			ИдентификаторПеревозчика);
		ЗаписатьИдентификаторы(
			ВидДокументаЭТрН,
			Организация, 
			Перевозчик, 
			ИдентификаторОрганизации, 
			ИдентификаторПеревозчика);	
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
		
КонецПроцедуры

// Используется контрагент для типа документа ЭПД.
// 
// Параметры:
//  ВидДокумента - СправочникСсылка.ВидыДокументовЭДО - Ссылка на вид электронного документа.
// 
// Возвращаемое значение:
//  Булево - Используется контрагент для типа документа
Функция ИспользуетсяКонтрагентДляВидаДокументаЭПД(ВидДокумента) Экспорт
	
	Массив = Новый Массив; // Массив из СправочникСсылка.ВидыДокументовЭДО - Ссылка на вид электронного документа.
	Массив.Добавить(ИнтерфейсДокументовЭДО.ВидДокументаПоТипу(Перечисления.ТипыДокументовЭДО.ЭТрН));
	
	//@skip-check invocation-parameter-type-intersect
	НайденныйВидДокумента = Массив.Найти(ВидДокумента);
	
	Возврат НайденныйВидДокумента <> Неопределено;
	
КонецФункции

// Фиксирует настройки обмена ЭТрН через сервис 1С:EDI
