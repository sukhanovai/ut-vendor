//                                Ложь, в ином случае.
// * ТекстОшибки - Строка       - Текст ошибки при выполнении операции
// * Данные      - Произвольный - Результат выполнения операции
//               - Неопределено - Выходные данные отсутствуют
Функция НовыйРезультатВыполненияОперации()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Отказ"       , Ложь);
	Результат.Вставить("ТекстОшибки" , "");
	Результат.Вставить("Данные"      , Неопределено);
	
	Возврат Результат;
	
