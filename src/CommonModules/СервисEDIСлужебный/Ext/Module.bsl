#Область ЗапросСвязьИдентификаторовУчастников

// Метод-конструктор сведений об участнике связи
// 
// Возвращаемое значение:
//  Структура - Сведения об участнике связи:
//   * Идентификатор   - Строка          - Идентификатор ЭПД участника
//   * Идентификаторы  - ТаблицаЗначений - Допустимые идентификаторы участника:
//    ** Идентификатор - Строка          - Допустимый идентификатор ЭПД участника
//    ** Наименование  - Строка          - Наименование участника
//    ** Комментарий   - Строка          - Комментарий к идентификатору ЭПД
Функция НовыеСведенияОбУчастникеСвязи() Экспорт
	
	Результат = Новый Структура;
	
	Идентификаторы = Новый ТаблицаЗначений;
	Идентификаторы.Колонки.Добавить("Идентификатор" , Новый ОписаниеТипов("Строка"));
	Идентификаторы.Колонки.Добавить("Наименование"  , Новый ОписаниеТипов("Строка"));
	Идентификаторы.Колонки.Добавить("Комментарий"   , Новый ОписаниеТипов("Строка"));
	
	Результат.Вставить("Идентификатор", "");
	Результат.Вставить("Идентификаторы", Идентификаторы);
	
	Возврат Результат;
	
КонецФункции

// Метод конструктор параметров запроса связи идентификаторов участников
// 
// Возвращаемое значение:
//  Структура:
// * Организация   - ОпределяемыйТип.Организация
//                 - Неопределено 
// * УчастникиЭТрН - См. НовыеУчастникиЭТрН
Функция НовыеПараметрыЗапросаСвязьИдентификаторовУчастников()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация"   , Неопределено);
	Результат.Вставить("УчастникиЭТрН" , НовыеУчастникиЭТрН());
	
	Возврат Результат;
	
КонецФункции

// Параметры запроса связи идентификаторов участников.
// 
// Параметры:
//  Организация   - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:Бизнес-сеть
//  УчастникиЭТрН - См. НовыеУчастникиЭТрН
// 
// Возвращаемое значение:
//  См. НовыеПараметрыЗапросаСвязьИдентификаторовУчастников
Функция ПараметрыЗапросаСвязьИдентификаторовУчастников(Знач Организация, Знач УчастникиЭТрН)
	
	Результат = НовыеПараметрыЗапросаСвязьИдентификаторовУчастников();
	
	Результат.Организация   = Организация;
	Результат.УчастникиЭТрН = УчастникиЭТрН;
	
	Возврат Результат;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
// * inn - Строка
// * kpp - Строка
Функция ТелоЗапросаСвязьИдентификаторУчастника()
	
	Результат = Новый Структура;
	
	Результат.Вставить("inn" , "");
	Результат.Вставить("kpp" , "");
	
	Возврат Результат;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
// * seller  - См. ТелоЗапросаСвязьИдентификаторУчастника
// * buyer   - См. ТелоЗапросаСвязьИдентификаторУчастника
Функция ТелоЗапросаСвязьИдентификаторовУчастников()
	
	Результат = Новый Структура;
	
	Результат.Вставить("seller"  , ТелоЗапросаСвязьИдентификаторУчастника());
	Результат.Вставить("buyer"   , ТелоЗапросаСвязьИдентификаторУчастника());
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ТелоЗапроса      - См. ТелоЗапросаСвязьИдентификаторУчастника
//  ДанныеУчастников - См. НовыеДанныеУчастников
//  Участник         - ЛюбаяСсылка
Процедура ЗаполнитьДанныеУчастникаСвязи(ТелоЗапроса, Знач ДанныеУчастников, Знач Участник)
	
	ДанныеУчастника = ДанныеУчастника(ДанныеУчастников, Участник);
	
	ТелоЗапроса.inn = ДанныеУчастника.ИНН;
	ТелоЗапроса.kpp = ДанныеУчастника.КПП;
	
КонецПроцедуры

// Сериализатор набора участников в модель сервиса
// 
// Параметры:
//  УчастникиЭТрН - См. НовыеУчастникиЭТрН
// 
// Возвращаемое значение:
//  См. ТелоЗапросаСвязьИдентификаторовУчастников
Функция УчастникиЭТрНВМоделиСервиса(Знач УчастникиЭТрН)
	
	Результат = ТелоЗапросаСвязьИдентификаторовУчастников();
	
	ТаблицаУчастников = НоваяТаблицаУчастников();
	
	ДобавитьОрганизацию(ТаблицаУчастников, УчастникиЭТрН.Организация);
	ДобавитьКонтрагента(ТаблицаУчастников, УчастникиЭТрН.Контрагент);
	
	ДанныеУчастников = ДанныеУчастников(ТаблицаУчастников);
	
	ЗаполнитьДанныеУчастникаСвязи(Результат.seller, ДанныеУчастников, УчастникиЭТрН.Организация);
	ЗаполнитьДанныеУчастникаСвязи(Результат.buyer, ДанныеУчастников, УчастникиЭТрН.Контрагент);
	
	Возврат Результат;
	
КонецФункции

// Формирует запрос к сервису для получения идентификаторов ЭПД
// 
// Параметры:
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаСвязьИдентификаторовУчастников
// 
// Возвращаемое значение:
//  См. НовыйЗапрос
Функция ЗапросСервисаСвязьИдентификаторовУчастников(Знач ПараметрыЗапроса)
	
	Результат = НовыйЗапрос(
		"ПолучитьИдентификаторыУчастников", 
		ИнтернетСоединениеБЭД.HTTPМетоды().POST,
		ПараметрыЗапроса.Организация,
		"hub/identifiers/relation");
	
	Результат.ТипЗапроса   = "application/vnd.1cedi.identifiers.relation.filter.v1+json";
	Результат.ТипОтвета    = "application/vnd.1cedi.identifiers.relation.v1+json";
	Результат.Тело         = УчастникиЭТрНВМоделиСервиса(ПараметрыЗапроса.УчастникиЭТрН);
	Результат.ФорматОтвета = ФорматыОтвета().HTTPОтвет;
	Результат.КодыОтвета.Добавить(404);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Ответ - HTTPОтвет - Ответ от сервиса
// 
// Возвращаемое значение:
//  См. НоваяСвязьИдентификаторовУчастниковЭТрН
Функция СвязьИдентификаторовУчастниковИзМоделиСервиса(Знач Ответ)
	
	Результат = НоваяСвязьИдентификаторовУчастниковЭТрН();
	
	Если Ответ.КодСостояния <> 200 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТелоОтвета = ДанныеJSON(Ответ); // Структура
	
	Идентификатор = ЗначениеАтрибута(ТелоОтвета, "seller"); // Строка
	Результат.Организация.Идентификатор = Идентификатор;
	
	Идентификатор = ЗначениеАтрибута(ТелоОтвета, "buyer"); // Строка
	Результат.Контрагент.Идентификатор = Идентификатор;
	
	Возврат Результат;
	
КонецФункции

// Получает идентификаторы ЭПД из сервиса 1С:EDI по таблице поиска
// 
// Параметры:
//  Организация   - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:Бизнес-сеть
//  УчастникиЭТрН - См. НовыеУчастникиЭТрН
// 
// Возвращаемое значение:
//  См. НоваяСвязьИдентификаторовУчастниковЭТрН
Функция СвязьИдентификаторовУчастников(Знач Организация, Знач УчастникиЭТрН)
	
	ПараметрыЗапроса = ПараметрыЗапросаСвязьИдентификаторовУчастников(Организация, УчастникиЭТрН);
	ЗапросСервиса    = ЗапросСервисаСвязьИдентификаторовУчастников(ПараметрыЗапроса);
	РезультатЗапроса = ВыполнитьЗапрос(ЗапросСервиса);
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не РезультатЗапроса.Отказ,
		СтрШаблон(
			НСтр(
				"ru = 'Ошибка получения идентификаторов из сервиса 1С:EDI по причине: %1'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			РезультатЗапроса.ТекстОшибки),
		"СервисEDIСлужебный.ИдентификаторыУчастниковПровайдераЭПД");
	
	Возврат СвязьИдентификаторовУчастниковИзМоделиСервиса(РезультатЗапроса.Данные);
	
КонецФункции

#КонецОбласти

#Область ИдентификаторыУчастниковЭТрН

// Метод-конструктор таблицы идентификаторов участников
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Идентификаторы участников:
// * Участник - ЛюбаяСсылка       - Участник ЭПД
// * ИдентификаторСтроки - Строка - Идентификатор строки таблицы (для поиска)
// * ИдентификаторЭПД    - Строка - Идентификатор ЭПД
// * Комментарий - Строка         - Комментарий для идентификатора ЭПД
Функция НовыеИдентификаторыУчастников() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("Участник"            , ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	Результат.Колонки.Добавить("ИдентификаторСтроки" , Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдентификаторЭПД"    , Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Комментарий"         , Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор таблицы идентификаторов участников (по данным сервиса)
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Идентификаторы участников:
// * ИдентификаторСтроки - Строка - Идентификатор строки таблицы (для поиска)
// * ИдентификаторЭПД    - Строка - Идентификатор ЭПД
// * Комментарий - Строка         - Комментарий для идентификатора ЭПД
Функция НоваяТаблицаИдентификаторов()
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("ИдентификаторСтроки" , Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдентификаторЭПД"    , Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Комментарий"         , Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
	
КонецФункции

// Метод конструктор параметров запроса идентификаторов участников
// 
// Возвращаемое значение:
//  Структура:
// * Организация   - ОпределяемыйТип.Организация
//                 - Неопределено 
// * ТаблицаПоиска - См. НоваяТаблицаПоискаИдентификаторов
Функция НовыеПараметрыЗапросаИдентификаторыУчастников()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация"   , Неопределено);
	Результат.Вставить("ТаблицаПоиска" , НоваяТаблицаПоискаИдентификаторов());
	
	Возврат Результат;
	
КонецФункции

// Получает идентификаторы ЭПД из сервиса 1С:EDI по таблице участников
// 
// Параметры:
//  Организация   - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:Бизнес-сеть
//  ТаблицаУчастников - См. НоваяТаблицаУчастников
// 
// Возвращаемое значение:
//  См. НовыеИдентификаторыУчастников
Функция ИдентификаторыУчастниковЭПД(Знач Организация, Знач ТаблицаУчастников)
	
	Результат = НовыеИдентификаторыУчастников();
	
	Если ТаблицаУчастников.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДанныеУчастников = ДанныеУчастников(ТаблицаУчастников);
	
	ТаблицаПоиска = НоваяТаблицаПоискаИдентификаторов();
	Индекс        = 0;
	
	ИдентификаторыСтрокУчастников = Новый Соответствие;
	
	Для Каждого ДанныеУчастника Из ДанныеУчастников Цикл
		Если ЭтоИННКПП(ДанныеУчастника.ИНН, ДанныеУчастника.КПП) Тогда
			Индекс = Индекс + 1;
			
			НоваяСтрока = ТаблицаПоиска.Добавить();
			НоваяСтрока.ИдентификаторСтроки = XMLСтрока(Индекс);
			НоваяСтрока.ИНН                 = ДанныеУчастника.ИНН;
			НоваяСтрока.КПП                 = ДанныеУчастника.КПП;
			
			ИдентификаторыСтрокУчастников.Вставить(НоваяСтрока.ИдентификаторСтроки, ДанныеУчастника.Участник);
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаПоиска.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИдентификаторыУчастников = ИдентификаторыУчастниковПровайдераЭПД(Организация, ТаблицаПоиска);
	
	Для Каждого ИдентификаторУчастника Из ИдентификаторыУчастников Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Участник            = ИдентификаторыСтрокУчастников[ИдентификаторУчастника.ИдентификаторСтроки];
		НоваяСтрока.ИдентификаторСтроки = ИдентификаторУчастника.ИдентификаторСтроки;
		НоваяСтрока.ИдентификаторЭПД    = ИдентификаторУчастника.ИдентификаторЭПД;
		НоваяСтрока.Комментарий         = ИдентификаторУчастника.Комментарий;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор таблицы идентификаторов участников
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Идентификаторы участников:
// * ИдентификаторСтроки - Строка - Идентификатор строки таблицы (для поиска)
// * ИНН                 - Строка - Идентификатор ЭПД
// * КПП                 - Строка - Идентификатор ЭПД
Функция НоваяТаблицаПоискаИдентификаторов()
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("ИдентификаторСтроки" , Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИНН"                 , ОбщегоНазначения.ОписаниеТипаСтрока(12));
	Результат.Колонки.Добавить("КПП"                 , ОбщегоНазначения.ОписаниеТипаСтрока(9));
	
	Возврат Результат;
	
КонецФункции

// Параметры запроса идентификаторы участников.
// 
// Параметры:
//  Организация   - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:Бизнес-сеть
//  ТаблицаПоиска - См. НоваяТаблицаПоискаИдентификаторов
// 
// Возвращаемое значение:
//  См. НовыеПараметрыЗапросаИдентификаторыУчастников
Функция ПараметрыЗапросаИдентификаторыУчастников(Знач Организация, Знач ТаблицаПоиска)
	
	Результат = НовыеПараметрыЗапросаИдентификаторыУчастников();
	
	Результат.Организация   = Организация;
	Результат.ТаблицаПоиска = ТаблицаПоиска;
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор тела запроса для поиска идентификаторов участников.
// 
// Возвращаемое значение:
//  Структура - Тело запроса:
// * legal - Массив Из См. ТелоЗапросаИдентификаторУчастника 
Функция ТелоЗапросаИдентификаторыУчастников()
	
	Результат = Новый Структура;
	
	Результат.Вставить("legal", Новый Массив);
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор элемента тела запроса поиска идентификатор участника.
// 
// Возвращаемое значение:
//  Структура - Идентификатор участника:
// * id  - Строка - Идентификатор строки поиска
// * inn - Строка - ИНН участника
// * kpp - Строка - КПП участника
Функция ТелоЗапросаИдентификаторУчастника()
	
	Результат = Новый Структура;
	
	Результат.Вставить("id"  , "");
	Результат.Вставить("inn" , "");
	Результат.Вставить("kpp" , "");
	
	Возврат Результат;
	
КонецФункции

// Таблица поиска идентификаторов в модели сервиса.
// 
// Параметры:
//  ТаблицаПоиска - См. НоваяТаблицаПоискаИдентификаторов
// 
// Возвращаемое значение:
//  См. ТелоЗапросаИдентификаторыУчастников
Функция ТаблицаПоискаИдентификаторовВМоделиСервиса(Знач ТаблицаПоиска)
	
	Результат = ТелоЗапросаИдентификаторыУчастников();
	
	Для Каждого СтрокаТаблицыПоиска Из ТаблицаПоиска Цикл
		Элемент = ТелоЗапросаИдентификаторУчастника();
		
		Элемент.id  = СтрокаТаблицыПоиска.ИдентификаторСтроки;
		Элемент.inn = СтрокаТаблицыПоиска.ИНН;
		Элемент.kpp = СтрокаТаблицыПоиска.КПП;
		
		Результат.legal.Добавить(Элемент);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Формирует запрос к сервису для получения идентификаторов ЭПД
// 
// Параметры:
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаИдентификаторыУчастников
// 
// Возвращаемое значение:
//  См. НовыйЗапрос
Функция ЗапросСервисаИдентификаторыУчастников(Знач ПараметрыЗапроса)
	
	Результат = НовыйЗапрос(
		"ПолучитьИдентификаторыУчастников", 
		ИнтернетСоединениеБЭД.HTTPМетоды().POST,
		ПараметрыЗапроса.Организация,
		"hub/identifiers");
	
	Результат.ТипЗапроса   = "application/vnd.1cedi.identifiers.filter.v1+json";
	Результат.ТипОтвета    = "application/vnd.1cedi.identifiers.list.v1+json";
	Результат.Тело         = ТаблицаПоискаИдентификаторовВМоделиСервиса(ПараметрыЗапроса.ТаблицаПоиска);
	Результат.ФорматОтвета = ФорматыОтвета().JSON;
	
	Возврат Результат;
	
КонецФункции

// Читает идентификаторы участников из модели сервиса.
// 
// Параметры:
//  Ответ - Массив Из Структура - Тело ответа
// 
// Возвращаемое значение:
//  См. НоваяТаблицаИдентификаторов
Функция ИдентификаторыУчастниковИзМоделиСервиса(Знач Ответ)
	
	Результат = НоваяТаблицаИдентификаторов();
	
	Для Каждого ИдентификаторУчастника Из Ответ Цикл
		НоваяСтрока = Результат.Добавить();
		//@skip-check statement-type-change - Работа с JSON
		НоваяСтрока.ИдентификаторСтроки = ЗначениеАтрибута(ИдентификаторУчастника, "id"); // Строка
		//@skip-check statement-type-change - Работа с JSON
		НоваяСтрока.ИдентификаторЭПД    = ЗначениеАтрибута(ИдентификаторУчастника, "providerId"); // Строка
		//@skip-check statement-type-change - Работа с JSON
		НоваяСтрока.Комментарий         = ЗначениеАтрибута(ИдентификаторУчастника, "comment"); // Строка
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает идентификаторы ЭПД из сервиса 1С:EDI по таблице поиска
// 
// Параметры:
//  Организация   - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:Бизнес-сеть
//  ТаблицаПоиска - См. НоваяТаблицаПоискаИдентификаторов
// 
// Возвращаемое значение:
//  См. НоваяТаблицаИдентификаторов
Функция ИдентификаторыУчастниковПровайдераЭПД(Знач Организация, Знач ТаблицаПоиска)
	
	ПараметрыЗапроса = ПараметрыЗапросаИдентификаторыУчастников(Организация, ТаблицаПоиска);
	ЗапросСервиса    = ЗапросСервисаИдентификаторыУчастников(ПараметрыЗапроса);
	РезультатЗапроса = ВыполнитьЗапрос(ЗапросСервиса);
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не РезультатЗапроса.Отказ,
		СтрШаблон(
			НСтр(
				"ru = 'Ошибка получения идентификаторов из сервиса 1С:EDI по причине: %1'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			РезультатЗапроса.ТекстОшибки),
		"СервисEDIСлужебный.ИдентификаторыУчастниковПровайдераЭПД");
	
	Возврат ИдентификаторыУчастниковИзМоделиСервиса(РезультатЗапроса.Данные);
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область Сообщения

#Область ЗапросОтправитьСообщение

// Метод-конструктор параметров для запроса отправить сообщение.
// 
// Возвращаемое значение:
//  Структура - Новые параметры запроса отправить сообщение:
// * Организация    - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:EDI
//                  - Неопределено                - Не задана
// * ДвоичныеДанные - ДвоичныеДанные              - Двоичные данные сообщения
//                  - Неопределено                - Не заданы
// * ИмяФайла       - Строка                      - Имя файла отправляемого сообщения
Функция НовыеПараметрыЗапросаОтправитьСообщение()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация"    , Неопределено);
	Результат.Вставить("ДвоичныеДанные" , Неопределено);
	Результат.Вставить("ИмяФайла"       , "");
	
	Возврат Результат;
	
КонецФункции

// Формирует параметры для запроса отправить сообщение.
// 
// Параметры:
//  ПараметрыОтправки - См. СинхронизацияЭДОСлужебный.НовыеПараметрыОтправкиТранспортногоКонтейнера
// 
// Возвращаемое значение:
//  См. НовыеПараметрыЗапросаОтправитьСообщение
Функция ПараметрыЗапросаОтправитьСообщение(Знач ПараметрыОтправки)
	
	Результат = НовыеПараметрыЗапросаОтправитьСообщение();
	
	Результат.Организация    = УчетныеЗаписиЭДО.ОрганизацияУчетнойЗаписи(
		ПараметрыОтправки.РеквизитыКонтейнера.Отправитель);
	Результат.ДвоичныеДанные = ПараметрыОтправки.ДанныеДляОтправки.ДвоичныеДанные;
	Результат.ИмяФайла       = ПараметрыОтправки.ДанныеДляОтправки.Наименование;
	
	Возврат Результат;
	
КонецФункции

// Формирует запрос к сервису для отправки сообщения
// 
// Параметры:
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаОтправитьСообщение
// 
// Возвращаемое значение:
//  См. НовыйЗапрос
Функция ЗапросСервисаОтправитьСообщение(Знач ПараметрыЗапроса)
	
	Результат = НовыйЗапрос(
		"ОтправитьСообщение", 
		ИнтернетСоединениеБЭД.HTTPМетоды().POST,
		ПараметрыЗапроса.Организация,
		"hub/messages",
		201);
	
	Результат.ТипЗапроса   = "application/zip";
	Результат.Тело         = ПараметрыЗапроса.ДвоичныеДанные;
	Результат.ФорматОтвета = ФорматыОтвета().Неопределено;
	
	Результат.Заголовки.Вставить(ЗаголовкиHTTP().ИмяФайла, ПараметрыЗапроса.ИмяФайла);
	
	Возврат Результат;
	
КонецФункции

// Отправляет сообщение через сервис 1С:EDI.
// 
// Параметры:
//  ПараметрыОтправки - См. СинхронизацияЭДОСлужебный.НовыеПараметрыОтправкиТранспортногоКонтейнера
// 
// Возвращаемое значение:
//  См. НовыйРезультатВыполненияОперации
Функция ОтправитьСообщение(Знач ПараметрыОтправки)
	
	РезультатВыполнения = НовыйРезультатВыполненияОперации();
	ПараметрыЗапроса    = ПараметрыЗапросаОтправитьСообщение(ПараметрыОтправки);
	ЗапросСервиса       = ЗапросСервисаОтправитьСообщение(ПараметрыЗапроса);
	РезультатЗапроса    = ВыполнитьЗапрос(ЗапросСервиса);
	
	Если РезультатЗапроса.Отказ Тогда
		РезультатВыполнения.Отказ       = Истина;
		РезультатВыполнения.ТекстОшибки = РезультатЗапроса.ТекстОшибки;
	КонецЕсли;
	
	Возврат РезультатВыполнения;
	
КонецФункции

#КонецОбласти

#Область ЗапросПолучитьПорциюДокументов

// Возвращаемое значение:
//  Структура:
// * Организация      - ОпределяемыйТип.Организация
//                    - Неопределено
// * РазмерСтраницы   - Число
//                    - Неопределено
// * ПоложениеКурсора - Строка
//                    - Неопределено
Функция НовыеПараметрыЗапросаПолучитьПорциюДокументов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация"      , Неопределено);
	Результат.Вставить("РазмерСтраницы"   , Неопределено);
	Результат.Вставить("ПоложениеКурсора" , Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Организация - ОпределяемыйТип.Организация
//  Пагинация   - См. НоваяПагинация 
// 
// Возвращаемое значение:
//  См. НовыеПараметрыЗапросаПолучитьПорциюДокументов
Функция ПараметрыЗапросаПолучитьПорциюДокументов(Знач Организация, Знач Пагинация)
	
	Результат = НовыеПараметрыЗапросаПолучитьПорциюДокументов();
	
	Результат.Организация      = Организация;
	Результат.РазмерСтраницы   = Пагинация.РазмерСтраницы;
	Результат.ПоложениеКурсора = Пагинация.ПоложениеКурсора;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаПолучитьПорциюДокументов
// 
// Возвращаемое значение:
//  См. НовыйЗапрос
Функция ЗапросСервисаПолучитьПорциюДокументов(Знач ПараметрыЗапроса)
	
	Результат = НовыйЗапрос(
		"ПолучитьСообщения", 
		ИнтернетСоединениеБЭД.HTTPМетоды().GET,
		ПараметрыЗапроса.Организация,
		"hub/messages",
		200);
	
	Результат.ТипОтвета    = "application/vnd.1cedi.messages.list.v1+json";
	Результат.ФорматОтвета = ФорматыОтвета().JSON;
	
	Результат.Параметры.Вставить("size"   , ПараметрыЗапроса.РазмерСтраницы);
	Результат.Параметры.Вставить("cursor" , ПараметрыЗапроса.ПоложениеКурсора);
	
	Возврат Результат;
	
КонецФункции

// Возвращаемое значение:
//  Структура:
// * Список - См. НовыеДокументыОрганизации
// * ПоложениеКурсора - Строка
//                    - Неопределено
Функция НоваяПорцияДокументов()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Список"           , НовыеДокументыОрганизации());
	Результат.Вставить("ПоложениеКурсора" , Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Данные - Структура
// 
// Возвращаемое значение:
//  См. НоваяПорцияДокументов
Функция ПорцияДокументовИзМоделиСервиса(Знач Данные)
	
	Результат = НоваяПорцияДокументов();
	
	Результат.ПоложениеКурсора = ЗначениеПоПути(Данные, "page.next"); // Строка
	Файлы                      = ЗначениеПоПути(Данные, "embedded", Новый Массив); // Массив Из Структура
	
	Для Каждого Файл Из Файлы Цикл
		Идентификатор = ЗначениеПоПути(Файл, "id"); // Строка
		
		НоваяСтрока = Результат.Список.Добавить();
		НоваяСтрока.Идентификатор = Идентификатор;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Организация - ОпределяемыйТип.Организация
//  Пагинация   - См. НоваяПагинация 
// 
// Возвращаемое значение:
//  См. НоваяПорцияДокументов
Функция ПолучитьПорциюДокументов(Знач Организация, Знач Пагинация)
	
	ПараметрыЗапроса    = ПараметрыЗапросаПолучитьПорциюДокументов(Организация, Пагинация);
	ЗапросСервиса       = ЗапросСервисаПолучитьПорциюДокументов(ПараметрыЗапроса);
	РезультатЗапроса    = ВыполнитьЗапрос(ЗапросСервиса);
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не РезультатЗапроса.Отказ,
		СтрШаблон(
			НСтр(
				"ru = 'Ошибка получения порции документов из сервиса 1С:EDI по причине: %1'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			РезультатЗапроса.ТекстОшибки),
		"СервисEDIСлужебный.ПолучитьПорциюДокументов");
	
	Возврат ПорцияДокументовИзМоделиСервиса(РезультатЗапроса.Данные);
	
КонецФункции

#КонецОбласти

#Область ЗапросОписаниеДокумента

// Возвращаемое значение:
//  Структура:
// * Организация      - ОпределяемыйТип.Организация
//                    - Неопределено
// * Идентификатор    - Строка
Функция НовыеПараметрыЗапросаОписаниеДокумента()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация"   , Неопределено);
	Результат.Вставить("Идентификатор" , "");
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Организация   - ОпределяемыйТип.Организация
//  Идентификатор - Строка
// 
// Возвращаемое значение:
//  См. НовыеПараметрыЗапросаОписаниеДокумента 
Функция ПараметрыЗапросаОписаниеДокумента(Знач Организация, Знач Идентификатор)
	
	Результат = НовыеПараметрыЗапросаОписаниеДокумента();
	
	Результат.Организация   = Организация;
	Результат.Идентификатор = Идентификатор;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаОписаниеДокумента 
// 
// Возвращаемое значение:
//  См. НовыйЗапрос
Функция ЗапросСервисаОписаниеДокумента(ПараметрыЗапроса)
	
	Результат = НовыйЗапрос(
		"ОписаниеДокумента", 
		ИнтернетСоединениеБЭД.HTTPМетоды().GET,
		ПараметрыЗапроса.Организация,
		СтрШаблон("hub/messages/%1", ПараметрыЗапроса.Идентификатор),
		200);
	
	Результат.ТипОтвета    = "application/zip";
	Результат.ФорматОтвета = ФорматыОтвета().HTTPОтвет;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Данные           - HTTPОтвет
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаОписаниеДокумента
// 
// Возвращаемое значение:
//  См. НовоеОписаниеДокумента
Функция ОписаниеДокументаИзМоделиСервиса(Знач Данные, Знач ПараметрыЗапроса)
	
	Результат = НовоеОписаниеДокумента();
	
	Результат.Данные        = Данные.ПолучитьТелоКакДвоичныеДанные();
	Результат.Имя           = ЗначениеЗаголовка(Данные, ЗаголовкиHTTP().ИмяФайла);
	Результат.Идентификатор = ПараметрыЗапроса.Идентификатор;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Организация   - ОпределяемыйТип.Организация
//  Идентификатор - Строка
// 
// Возвращаемое значение:
//  См. НовоеОписаниеДокумента
Функция ОписаниеДокумента(Знач Организация, Знач Идентификатор)
	
	ПараметрыЗапроса    = ПараметрыЗапросаОписаниеДокумента(Организация, Идентификатор);
	ЗапросСервиса       = ЗапросСервисаОписаниеДокумента(ПараметрыЗапроса);
	РезультатЗапроса    = ВыполнитьЗапрос(ЗапросСервиса);
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не РезультатЗапроса.Отказ,
		СтрШаблон(
			НСтр(
				"ru = 'Ошибка получения описания документа из сервиса 1С:EDI по причине: %1'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			РезультатЗапроса.ТекстОшибки),
		"СервисEDIСлужебный.ОписаниеДокумента");
	
	Возврат ОписаниеДокументаИзМоделиСервиса(РезультатЗапроса.Данные, ПараметрыЗапроса);
	
КонецФункции

#КонецОбласти

#Область ЗапросОтметитьПолучениеСообщения

// Возвращаемое значение:
//  Структура:
// * Организация      - ОпределяемыйТип.Организация
//                    - Неопределено
// * Идентификатор    - Строка
Функция НовыеПараметрыЗапросаОтметитьПолучениеСообщения()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация"   , Неопределено);
	Результат.Вставить("Идентификатор" , "");
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Организация   - ОпределяемыйТип.Организация
//  Идентификатор - Строка
// 
// Возвращаемое значение:
//  См. НовыеПараметрыЗапросаОтметитьПолучениеСообщения 
Функция ПараметрыЗапросаОтметитьПолучениеСообщения(Знач Организация, Знач Идентификатор)
	
	Результат = НовыеПараметрыЗапросаОтметитьПолучениеСообщения();
	
	Результат.Организация   = Организация;
	Результат.Идентификатор = Идентификатор;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  ПараметрыЗапроса - См. НовыеПараметрыЗапросаОписаниеДокумента 
// 
// Возвращаемое значение:
//  См. НовыйЗапрос
Функция ЗапросСервисаОтметитьПолучениеСообщения(ПараметрыЗапроса)
	
	Результат = НовыйЗапрос(
		"ОписаниеДокумента", 
		ИнтернетСоединениеБЭД.HTTPМетоды().PATCH,
		ПараметрыЗапроса.Организация,
		СтрШаблон("hub/messages/%1", ПараметрыЗапроса.Идентификатор),
		200);
	
	Результат.ФорматОтвета = ФорматыОтвета().Неопределено;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Организация   - ОпределяемыйТип.Организация
//  Идентификатор - Строка
Процедура ОтметитьПолучениеСообщения(Знач Организация, Знач Идентификатор)
	
	ПараметрыЗапроса    = ПараметрыЗапросаОтметитьПолучениеСообщения(Организация, Идентификатор);
	ЗапросСервиса       = ЗапросСервисаОтметитьПолучениеСообщения(ПараметрыЗапроса);
	
	ВыполнитьЗапрос(ЗапросСервиса);
	
КонецПроцедуры

