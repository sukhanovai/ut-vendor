#Область Конструкторы

// Метод-конструктор запроса к сервису 1С:EDI
// 
// Параметры:
//  Имя         - Строка                      - Имя метода сервиса
//  Метод       - Строка                      - Имя HTTP-метода запроса
//  Организация - ОпределяемыйТип.Организация - Организация для получения абсолютного пути и токена
//  Адрес       - Строка                      - Путь к ресурсу на сервере
//  КодОтвета   - Число                       - Ожидаемый код ответа
// 
// Возвращаемое значение:
//  Структура - Запрос:
// * Имя          - Строка                        - Имя метода сервиса 
// * Метод        - Строка                        - Имя HTTP-метода запроса 
// * Организация  - ОпределяемыйТип.Организация   - Организация для получения абсолютного пути и токена
//                - Неопределено                  - Не задана
// * Адрес        - Строка                        - Путь к ресурсу на сервере
// * Тело         - Строка                        - Текст тела запроса
//                - Массив Из Произвольный        - JSON-объект
//                - Структура                     - JSON-объект
//                - ДвоичныеДанные                - Двоичные данные тела запроса
//                - Неопределено                  - Тело запроса не задано  
// * ТипЗапроса   - Строка                        - Заголовок Content-Type
//                - Неопределено                  - Не задан
// * ТипОтвета    - Строка                        - Заголовок Accept
//                - Неопределено                  - Не задан
// * Таймаут      - Число                         - Длительность таймаута запроса
// * КодыОтвета   - Массив Из Число               - Допустимые коды ответа
// * ФорматОтвета - Строка                        - Формат, в котором следует вернуть ответ сервиса
//                                                  См. ФорматыОтвета
// * Заголовки    - Соответствие Из КлючИЗначение - Заголовки запроса:
//  ** Ключ       - Строка                        - Имя заголовка
//  ** Значение   - Строка                        - Значение заголовка
// * Параметры    - Соответствие Из КлючИЗначение - Параметры запроса:
//  ** Ключ       - Строка                        - Имя параметра
//  ** Значение   - Строка                        - Значение параметра
Функция НовыйЗапрос(Знач Имя, Знач Метод, Знач Организация, Знач Адрес, Знач КодОтвета = 200)
	
	Результат = Новый Структура;
	
	Результат.Вставить("Имя"          , Имя);
	Результат.Вставить("Метод"        , Метод);
	Результат.Вставить("Организация"  , Организация);
	Результат.Вставить("Адрес"        , Адрес);
	Результат.Вставить("Тело"         , Неопределено);
	Результат.Вставить("ТипЗапроса"   , Неопределено);
	Результат.Вставить("ТипОтвета"    , Неопределено);
	Результат.Вставить("Таймаут"      , 60);
	Результат.Вставить("КодыОтвета"   , ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(КодОтвета));
	Результат.Вставить("ФорматОтвета" , ФорматыОтвета().HTTPОтвет);
	Результат.Вставить("Заголовки"    , Новый Соответствие);
	Результат.Вставить("Параметры"    , Новый Соответствие);
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор результата выполнения запроса к сервису
// 
// Возвращаемое значение:
//  Структура - Новый результат выполнения запроса:
// * Отказ       - Булево              - Истина, если запрос выполнен с ошибками.
//                                       Ложь, в ином случае.
// * ТекстОшибки - Строка              - Текст ошибки при выполнении запроса
// * Данные      - HTTPОтвет           - Если Запрос.ФорматОтвета=ФорматыОтвета().HTTPОтвет
//               - ДвоичныеДанные      - Если Запрос.ФорматОтвета=ФорматыОтвета().ДвоичныеДанные
//               - Поток               - Если Запрос.ФорматОтвета=ФорматыОтвета().Поток
//               - Строка              - Если Запрос.ФорматОтвета=ФорматыОтвета().Строка
//               - Структура           - Если Запрос.ФорматОтвета=ФорматыОтвета().JSON
//               - Массив Из Структура - Если Запрос.ФорматОтвета=ФорматыОтвета().JSON
//               - Неопределено        - Если Запрос.ФорматОтвета=ФорматыОтвета().Неопределено
Функция НовыйРезультатВыполненияЗапроса()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Отказ"       , Ложь);
	Результат.Вставить("ТекстОшибки" , "");
	Результат.Вставить("Данные"      , Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор нового HTTP-соединения
// 
// Параметры:
//  СтруктураURI - См. ОбщегоНазначенияКлиентСервер.СтруктураURI
//  Таймаут      - Число - Длительность таймаута запроса
// 
// Возвращаемое значение:
//  HTTPСоединение
Функция НовоеHTTPСоединение(Знач СтруктураURI, Знач Таймаут)
	
	Если СтруктураURI.Схема = "https" Тогда
		ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение();
		ПортПоУмолчанию      = 443;
	Иначе
		ЗащищенноеСоединение = Неопределено;
		ПортПоУмолчанию      = 80;
	КонецЕсли;
	
	Порт = 
		?(СтруктураURI.Порт = Неопределено,
			ПортПоУмолчанию,
			СтруктураURI.Порт);
	
	Прокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(СтруктураURI.Схема);
	
	Возврат Новый HTTPСоединение(
		СтруктураURI.Хост, 
		Порт, 
		СтруктураURI.Логин, 
		СтруктураURI.Пароль, 
		Прокси,
		Таймаут, 
		ЗащищенноеСоединение);
	
КонецФункции

// Метод-конструктор нового HTTP-запроса
// 
// Параметры:
//  СтруктураURI - См. ОбщегоНазначенияКлиентСервер.СтруктураURI
//  Запрос       - См. НовыйЗапрос
// 
// Возвращаемое значение:
//  HTTPЗапрос
Функция НовыйHTTPЗапрос(Знач СтруктураURI, Знач Запрос)
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить(ЗаголовкиHTTP().Авторизация, ТокенОрганизацииБС(Запрос.Организация));
	
	Если Запрос.ТипЗапроса <> Неопределено Тогда
		Заголовки.Вставить(ЗаголовкиHTTP().ТипЗапроса, Запрос.ТипЗапроса);
	КонецЕсли;
	
	Если Запрос.ТипОтвета <> Неопределено Тогда
		Заголовки.Вставить(ЗаголовкиHTTP().ТипОтвета, Запрос.ТипОтвета);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьСоответствие(Заголовки, Запрос.Заголовки);
	
	Адрес = АдресЗапроса(СтруктураURI.ПутьНаСервере, Запрос.Параметры);
	
	Результат = Новый HTTPЗапрос(Адрес, Заголовки);
	
	Если Запрос.Тело = Неопределено Тогда
		// Тело не задано
	ИначеЕсли ТипЗнч(Запрос.Тело) = Тип("Строка") Тогда
		Результат.УстановитьТелоИзСтроки(Запрос.Тело);
	ИначеЕсли ТипЗнч(Запрос.Тело) = Тип("ДвоичныеДанные") Тогда
		Результат.УстановитьТелоИзДвоичныхДанных(Запрос.Тело);
	ИначеЕсли ТипЗнч(Запрос.Тело) = Тип("Массив")
		Или ТипЗнч(Запрос.Тело) = Тип("Структура") Тогда
		Результат.УстановитьТелоИзДвоичныхДанных(ТелоЗапросаJSON(Запрос.Тело));
	Иначе
		ВызватьИсключение(
			СтрШаблон(
				НСтр(
					"ru = 'Неподдерживаемый тип тела запроса: %1'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				ТипЗнч(Запрос.Тело)));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Перечисления

// Заголовки HTTP-запросов
// 
// Возвращаемое значение:
//  Структура - Заголовки:
// * Авторизация - Строка - Заголовок Authorization
// * ТипЗапроса  - Строка - Заголовок Content-Type
// * ТипОтвета   - Строка - Заголовок Accept
// * ИмяФайла    - Строка - Заголовок Content-Disposition
Функция ЗаголовкиHTTP()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Авторизация" , "Authorization");
	Результат.Вставить("ТипЗапроса"  , "Content-Type");
	Результат.Вставить("ТипОтвета"   , "Accept");
	Результат.Вставить("ИмяФайла"    , "Content-Disposition");
	
	Возврат Результат;
	
КонецФункции

// Форматы получения ответа HTTP-запроса
// 
// Возвращаемое значение:
//  Структура - Форматы ответа:
// * HTTPОтвет      - Строка - Сам HTTPОтвет
// * ДвоичныеДанные - Строка - HTTPОтвет.ПолучитьТелоКакДвоичныеДанные()
// * Поток          - Строка - HTTPОтвет.ПолучитьТелоКакПоток()
// * Строка         - Строка - HTTPОтвет.ПолучитьТелоКакСтроку()
// * JSON           - Строка - Прочитать тело HTTP-ответа как JSON-строку
// * Неопределено   - Строка - Читать ответ не требуется
Функция ФорматыОтвета()
	
	Результат = Новый Структура;
	
	Результат.Вставить("HTTPОтвет"      , "HTTPОтвет");
	Результат.Вставить("ДвоичныеДанные" , "ДвоичныеДанные");
	Результат.Вставить("Поток"          , "Поток");
	Результат.Вставить("Строка"         , "Строка");
	Результат.Вставить("JSON"           , "JSON");
	Результат.Вставить("Неопределено"   , "Неопределено");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

// Параметры:
//  HTTPОтвет           - HTTPОтвет
//  ИмяЗаголовка        - Строка
//  ЗначениеПоУмолчанию - Строка
//                      - Неопределено
// 
// Возвращаемое значение:
//  Строка
//  Неопределено
Функция ЗначениеЗаголовка(Знач HTTPОтвет, Знач ИмяЗаголовка, Знач ЗначениеПоУмолчанию = Неопределено)
	
	Для Каждого Заголовок Из HTTPОтвет.Заголовки Цикл
		ИмяЗаголовкаОтвета = Заголовок.Ключ; // Строка
		Если СтрСравнить(ИмяЗаголовкаОтвета, ИмяЗаголовка) = 0 Тогда
			Возврат Заголовок.Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

// Формирует полное имя запроса к сервису
// 
// Параметры:
//  Имя - Строка - Имя запроса к сервису для логирования
// 
// Возвращаемое значение:
//  Строка - Полное имя запроса
Функция ИмяЗапроса(Знач Имя = Неопределено)
	Возврат СтрШаблон("ЭлектронноеВзаимодействие.ОбменСКонтрагентами.СервисEDI.%1", Имя);
КонецФункции

// Параметры:
//  Параметры - См. АдресЗапроса.Параметры
// 
// Возвращаемое значение:
//  Строка
Функция СтрокаПараметровЗапроса(Знач Параметры)
	
	Результат = Новый Массив; // Массив Из Строка
	
	Для Каждого Параметр Из Параметры Цикл
		Результат.Добавить(
			СтрШаблон(
				"%1=%2",
				Параметр.Ключ,
				Параметр.Значение));
	КонецЦикла;
	
	Возврат СтрСоединить(Результат, "&");
	
КонецФункции

// Параметры:
//  Путь        - Строка
//  Параметры   - Соответствие Из КлючИЗначение:
//   * Ключ     - Строка
//   * Значение - Строка
// 
// Возвращаемое значение:
//  Строка
Функция АдресЗапроса(Знач Путь, Знач Параметры)
	
	Если Параметры.Количество() = 0 Тогда
		Возврат Путь;
	Иначе
		Возврат СтрШаблон("%1?%2", Путь, СтрокаПараметровЗапроса(Параметры));
	КонецЕсли;
	
КонецФункции

// Адрес сервиса 1С:EDI.
// 
// Возвращаемое значение:
//  Строка
Функция АдресСервиса()
	Возврат "https://edi.1cfresh.com/api";
КонецФункции

// Параметры:
//  Соединение - HTTPСоединение
//  Запрос     - HTTPЗапрос
//  Метод      - Строка
//  Имя        - Строка
// 
// Возвращаемое значение:
//  HTTPОтвет
Функция ВызватьHTTPМетод(Знач Соединение, Знач Запрос, Знач Метод, Знач Имя)
	Возврат Соединение.ВызватьHTTPМетод(Метод, Запрос);
КонецФункции

// Параметры:
//  Результат - См. НовыйРезультатВыполненияЗапроса
//  Запрос    - См. НовыйЗапрос
//  HTTPОтвет - HTTPОтвет
Процедура ПроверитьКодОтвета(Результат, Знач Запрос, Знач HTTPОтвет)
	
	Если Запрос.КодыОтвета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Запрос.КодыОтвета.Найти(HTTPОтвет.КодСостояния) = Неопределено Тогда
		Результат.Отказ       = Истина;
		Результат.ТекстОшибки = 
			СтрШаблон(
				НСтр(
					"ru = 'Полученный код ответа (%1) не входит в список ожидаемых: %2.'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				HTTPОтвет.КодСостояния,
				СтрСоединить(Запрос.КодыОтвета, ", "));
	КонецЕсли;
	
КонецПроцедуры

// Сериализует тело запроса в JSON.
// 
// Параметры:
//  Тело - Массив Из Произвольный - Тело запроса (JSON)
//       - Структура              - Тело запроса (JSON)
// 
// Возвращаемое значение:
//  ДвоичныеДанные - Тело запроса в виде двоичных данных
Функция ТелоЗапросаJSON(Знач Тело)
	
	Поток = Новый ПотокВПамяти;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.ОткрытьПоток(Поток);
	ЗаписатьJSON(ЗаписьJSON, Тело);
	ЗаписьJSON.Закрыть();
	
	Возврат Поток.ЗакрытьИПолучитьДвоичныеДанные();
	
КонецФункции

// Параметры:
//  Результат - См. НовыйРезультатВыполненияЗапроса
//  Запрос    - См. НовыйЗапрос
//  HTTPОтвет - HTTPОтвет
Процедура ПрочитатьТелоОтветаJSON(Результат, Знач Запрос, Знач HTTPОтвет)
	
	ПотокДанных = HTTPОтвет.ПолучитьТелоКакПоток();
	
	Попытка
		Результат.Данные = ДанныеJSON(HTTPОтвет);
	Исключение
		Результат.Отказ       = Истина;
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
	ПотокДанных.Закрыть();
	
КонецПроцедуры

// Параметры:
//  HTTPОтвет - HTTPОтвет
// 
// Возвращаемое значение:
//  Произвольный
Функция ДанныеJSON(Знач HTTPОтвет)
	
	ПотокДанных = HTTPОтвет.ПолучитьТелоКакПоток();
	
	Попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.ОткрытьПоток(ПотокДанных);
		Результат = ПрочитатьJSON(ЧтениеJSON, , , ФорматДатыJSON.ISO);
		ЧтениеJSON.Закрыть();
		ПотокДанных.Закрыть();
	Исключение
		ПотокДанных.Закрыть();
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Результат - См. НовыйРезультатВыполненияЗапроса
//  Запрос    - См. НовыйЗапрос
//  HTTPОтвет - HTTPОтвет
Процедура ПрочитатьТелоОтвета(Результат, Знач Запрос, Знач HTTPОтвет)
	
	Если Запрос.ФорматОтвета = ФорматыОтвета().HTTPОтвет Тогда
		Результат.Данные = HTTPОтвет;
	ИначеЕсли Запрос.ФорматОтвета = ФорматыОтвета().ДвоичныеДанные Тогда
		Результат.Данные = HTTPОтвет.ПолучитьТелоКакДвоичныеДанные();
	ИначеЕсли Запрос.ФорматОтвета = ФорматыОтвета().Поток Тогда
		Результат.Данные = HTTPОтвет.ПолучитьТелоКакПоток();
	ИначеЕсли Запрос.ФорматОтвета = ФорматыОтвета().Строка Тогда
		Результат.Данные = HTTPОтвет.ПолучитьТелоКакСтроку();
	ИначеЕсли Запрос.ФорматОтвета = ФорматыОтвета().JSON Тогда
		ПрочитатьТелоОтветаJSON(Результат, Запрос, HTTPОтвет);
	ИначеЕсли Запрос.ФорматОтвета = ФорматыОтвета().Неопределено Тогда
		Результат.Данные = Неопределено;
	Иначе
		ВызватьИсключение(
			СтрШаблон(
				НСтр(
					"ru = 'Непредвиденный формат ответа: %1'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				Запрос.ФорматОтвета));
	КонецЕсли;
	
КонецПроцедуры

// Выполняет запрос к сервису 1С:EDI
// 
// Параметры:
//  Запрос - См. НовыйЗапрос
// 
// Возвращаемое значение:
//  См. НовыйРезультатВыполненияЗапроса
Функция ВыполнитьЗапрос(Знач Запрос)
	
	Результат = НовыйРезультатВыполненияЗапроса();
	
	ПолныйАдрес = 
		СтрШаблон(
			"%1/%2/%3",
				АдресСервиса(),
				ИдентификаторОрганизацииБС(Запрос.Организация),
				Запрос.Адрес);
	
	СтруктураURI   = ОбщегоНазначенияКлиентСервер.СтруктураURI(ПолныйАдрес);
	HTTPСоединение = НовоеHTTPСоединение(СтруктураURI, Запрос.Таймаут);
	HTTPЗапрос     = НовыйHTTPЗапрос(СтруктураURI, Запрос);
	
	Попытка
		HTTPОтвет = ВызватьHTTPМетод(HTTPСоединение, HTTPЗапрос, Запрос.Метод, ИмяЗапроса(Запрос.Имя));
	Исключение
		Результат.Отказ       = Истина;
		Результат.ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Возврат Результат;
	КонецПопытки;
	
	ПроверитьКодОтвета(Результат, Запрос, HTTPОтвет);
	
	Если Результат.Отказ Тогда
		Возврат Результат;
	КонецЕсли;
	
	ПрочитатьТелоОтвета(Результат, Запрос, HTTPОтвет);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

