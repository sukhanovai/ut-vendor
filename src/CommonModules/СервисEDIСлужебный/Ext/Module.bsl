// Возвращаемое значение:
//  См. НовыеУчетныеЗаписи
Функция УчетныеЗаписи()
	
	Результат = НовыеУчетныеЗаписи();
	
	ПроверитьНаличиеПодсистемыБизнесСеть("СервисEDIСлужебный.УчетныеЗаписи");
	ОбщийМодульБизнесСеть = ОбщегоНазначения.ОбщийМодуль("БизнесСеть");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпособОбменаЭД", СпособОбмена());
	Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Настройки.Отправитель КАК Организация,
		|	Настройки.ИдентификаторОтправителя КАК Идентификатор
		|ИЗ
		|	РегистрСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам КАК Настройки
		|ГДЕ
		|	Настройки.СпособОбменаЭД = &СпособОбменаЭД";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Пока Выборка.Следующий() Цикл
		
		Организация   = Выборка.Организация; // ОпределяемыйТип.Организация
		Идентификатор = Выборка.Идентификатор; // Строка
		
		Если ОбщийМодульБизнесСеть.ОрганизацияНеПодключенаТребуетсяПовторноеПодключение(Организация) Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.Организация   = Организация;
		НоваяСтрока.Идентификатор = Идентификатор;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  УчетнаяЗапись - СтрокаТаблицыЗначений: См. НовыеУчетныеЗаписи
// 
// Возвращаемое значение:
//  Структура:
// * УчетнаяЗапись - СтрокаТаблицыЗначений: См. НовыеУчетныеЗаписи
// * Документы     - См. НовыеДокументы
// * Пагинация     - См. НоваяПагинация
Функция ВыборкаДокументовОрганизации(Знач УчетнаяЗапись)
	
	Результат = Новый Структура;
	
	Результат.Вставить("УчетнаяЗапись"      , УчетнаяЗапись);
	Результат.Вставить("Документы"          , НовыеДокументы());
	Результат.Вставить("Пагинация"          , НоваяПагинация());
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
Процедура ПрочитатьПорциюДокументов(Выборка)
	
	Контекст = "СервисEDIСлужебный.ПрочитатьПорциюДокументов";
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Выборка.Документы.СтатусЗагрузки <> СтатусыЗагрузкиДанных().Завершено,
		НСтр(
			"ru = 'Ошибка получения порции выборки: все данные получены'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Контекст);
		
	Порция = ПолучитьПорциюДокументов(Выборка.УчетнаяЗапись.Организация, Выборка.Пагинация);
	
	Выборка.Документы.Список               = Порция.Список;
	Выборка.Пагинация.ПоложениеКурсора     = Порция.ПоложениеКурсора;
	Выборка.Документы.ТекущаяСтрока        = Неопределено;
	Выборка.Документы.НомерСтроки          = 0;
	
	Если Выборка.Документы.Список.Количество() = 0 Тогда
		Выборка.Документы.СтатусЧтения         = СтатусыЧтенияПорции().Завершено;
	Иначе
		Выборка.Документы.СтатусЧтения         = СтатусыЧтенияПорции().НеНачато;
	КонецЕсли;
	
	Если Выборка.Документы.Список.Количество() = Выборка.Пагинация.РазмерСтраницы Тогда
		Выборка.Документы.СтатусЗагрузки = СтатусыЗагрузкиДанных().Выполняется;
	Иначе
		Выборка.Документы.СтатусЗагрузки = СтатусыЗагрузкиДанных().Завершено;
	КонецЕсли;
	
КонецПроцедуры

// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
Процедура ПерейтиКСледующемуДокументу(Выборка)
	
	Контекст = "СервисEDIСлужебный.ПерейтиКСледующемуДокументу";
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Выборка.Документы.СтатусЧтения <> СтатусыЧтенияПорции().Завершено,
		НСтр(
			"ru = 'Ошибка позиционирования выборки: обход не начат'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Контекст);
	ОбщегоНазначенияКлиентСервер.Проверить(
		Выборка.Документы.Список.Количество() > Выборка.Документы.НомерСтроки,
		НСтр(
			"ru = 'Ошибка позиционирования выборки: обход завершен'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Контекст);
	
	Выборка.Документы.НомерСтроки   = Выборка.Документы.НомерСтроки + 1;
	Выборка.Документы.ТекущаяСтрока = Выборка.Документы.Список[Выборка.Документы.НомерСтроки - 1];
	
	Если Выборка.Документы.Список.Количество() = Выборка.Документы.НомерСтроки Тогда
		Выборка.Документы.СтатусЧтения = СтатусыЧтенияПорции().Завершено;
	Иначе
		Выборка.Документы.СтатусЧтения = СтатусыЧтенияПорции().Выполняется;
	КонецЕсли; 
	
КонецПроцедуры

// Требуется загрузить порцию документов.
// 
// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
// 
// Возвращаемое значение:
//  Булево
Функция ТребуетсяЗагрузитьПорциюДокументов(Выборка)
	
	Если Выборка.Документы.СтатусЗагрузки = СтатусыЗагрузкиДанных().НеНачато Тогда
		Возврат Истина;
	ИначеЕсли Выборка.Документы.СтатусЗагрузки = СтатусыЗагрузкиДанных().Выполняется
		И Выборка.Документы.СтатусЧтения = СтатусыЗагрузкиДанных().Завершено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Требуется загрузить порцию документов.
// 
// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
// 
// Возвращаемое значение:
//  Булево
Функция ЗавершенаОбработка(Выборка)
	
	Возврат Выборка.Документы.СтатусЗагрузки = СтатусыЗагрузкиДанных().Завершено
		И Выборка.Документы.СтатусЧтения = СтатусыЧтенияПорции().Завершено;
	
КонецФункции

// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
// 
// Возвращаемое значение:
//  Булево
Функция СледующийДокумент(Выборка)
	
	Если ТребуетсяЗагрузитьПорциюДокументов(Выборка) Тогда
		ПрочитатьПорциюДокументов(Выборка);
	КонецЕсли;
	
	Если ЗавершенаОбработка(Выборка) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ПерейтиКСледующемуДокументу(Выборка);
	
	Возврат Истина;
	
КонецФункции

// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
// 
// Возвращаемое значение:
//  См. НовоеОписаниеДокумента
Функция ПолучитьДокумент(Выборка)
	Возврат ОписаниеДокумента(Выборка.УчетнаяЗапись.Организация, Выборка.Документы.ТекущаяСтрока.Идентификатор);
КонецФункции

// Параметры:
//  Выборка - См. ВыборкаДокументовОрганизации
Процедура ОтметитьПолучениеДокумента(Выборка)
	ОтметитьПолучениеСообщения(Выборка.УчетнаяЗапись.Организация, Выборка.Документы.ТекущаяСтрока.Идентификатор);
КонецПроцедуры

// Параметры:
//  Результат     - См. СинхронизацияЭДОСлужебный.НовыйРезультатПолученияДокументов
//  УчетнаяЗапись - СтрокаТаблицыЗначений: См. НовыеУчетныеЗаписи
Процедура ПолучитьДокументыПоОрганизации(Результат, Знач УчетнаяЗапись)
	
	Выборка      = ВыборкаДокументовОрганизации(УчетнаяЗапись);
	СпособОбмена = СпособОбмена();
	
	КонтекстДиагностики = ОбработкаНеисправностейБЭД.НовыйКонтекстДиагностики();
	
	Пока СледующийДокумент(Выборка) Цикл
		ОписаниеДокумента = ПолучитьДокумент(Выборка);
		
		КлючСинхронизации = СинхронизацияЭДОКлиентСервер.НовыйКлючСинхронизации();
		КлючСинхронизации.СпособОбмена               = СпособОбмена;
		КлючСинхронизации.ИдентификаторУчетнойЗаписи = УчетнаяЗапись.Идентификатор;
		
		ОписаниеКонтейнера = СервисЭДО.НоваяТаблицаКонтейнеров().Добавить();
		ОписаниеКонтейнера.ИДДокумента             = ОписаниеДокумента.Идентификатор;
		ОписаниеКонтейнера.ДвоичныеДанные          = ОписаниеДокумента.Данные;
		
		РезультатСохраненияКонтейнера = ТранспортныеКонтейнерыЭДО.СохранитьКонтейнер(
			ОписаниеКонтейнера, КлючСинхронизации, КонтекстДиагностики);
		ТранспортныйКонтейнер = РезультатСохраненияКонтейнера.ТранспортныйКонтейнер;
		
		Если ЗначениеЗаполнено(ТранспортныйКонтейнер) Тогда
			Результат.Контейнеры.Добавить(ТранспортныйКонтейнер);
		КонецЕсли;
		
		ОтметитьПолучениеДокумента(Выборка);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область JSON

// Параметры:
//  Данные              - Структура
//                      - Неопределено
//  Путь                - Строка
//  ЗначениеПоУмолчанию - Произвольный
// 
// Возвращаемое значение:
//  Произвольный
Функция ЗначениеПоПути(Знач Данные, Знач Путь, Знач ЗначениеПоУмолчанию = Неопределено)
	
	Контекст  = Данные;
	Значение  = Неопределено;
	ЧастиПути = СтрРазделить(Путь, ".");
	
	Для Каждого ЧастьПути Из ЧастиПути Цикл
		
		Если Контекст = Неопределено Тогда
			Возврат ЗначениеПоУмолчанию;
		ИначеЕсли Не Контекст.Свойство(ЧастьПути, Значение) Тогда
			Возврат ЗначениеПоУмолчанию;
		КонецЕсли;
		
		Контекст = Значение;
		
	КонецЦикла;
	
	Возврат Контекст;
	
КонецФункции

#КонецОбласти

#Область СведенияОФайлахСообщенийЭДО

// Расположение ссылок на файл-источник в разных сообщениях
// 
// Возвращаемое значение:
//  Соответствие  Из КлючИЗначение - Расположения:
//   * Ключ     - Строка - Код регламента
//   * Значение - Строка - Путь к имени файла внутри файла
Функция РасположенияСсылокНаФайлИсточник()
	
	Результат = Новый Соответствие;
	
	Результат.Вставить("CarrierInformationDeliveryCargo", "Документ.ИдИнфГП.ИдФайлИнфГП");
	Результат.Вставить("ConsigneeInformation", "Документ.ИдИнфПрвПрием.ИдФайлИнфПрвПрием");
	Результат.Вставить("CarrierInformationAcceptanceCargo", "Документ.ИдИнфГО.ИдФайлИнфГО");
	
	Возврат Результат;
	
КонецФункции

// Параметры:
//  Документ      - ОбъектXDTO
//  КодТранзакции - Строка
// 
// Возвращаемое значение:
//  Строка
//  Неопределено
Функция ИмяФайлаИсточника(Знач Документ, Знач КодТранзакции)
	
	Путь = РасположенияСсылокНаФайлИсточник()[КодТранзакции];
	
	Если Путь = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат РаботаСФайламиБЭД.ЗначениеСвойстваXDTO(Документ, Путь);
	
КонецФункции

// Параметры:
//  ДокументКонтейнера - См. ТранспортныеКонтейнерыЭДО.НовоеОписаниеДокументаКонтейнера
Процедура ВыполнитьПоискИдентификаторовДокументооборотаДокументаПоИмениФайла(ДокументКонтейнера)
	
	Если Не ПустаяСтрока(ДокументКонтейнера.ИдентификаторДокументооборота) Тогда
		Возврат; // Идентификатор получен ранее
	КонецЕсли;
	
	Поток = ДокументКонтейнера.ОписаниеДанных.ДвоичныеДанные.ОткрытьПотокДляЧтения();
	
	Документ = РаботаСФайламиБЭД.ПрочитатьXDTO(Поток);
	ИмяФайла = ИмяФайлаИсточника(Документ, ДокументКонтейнера.КодТранзакции);
	
	Если ИмяФайла = Неопределено Тогда
		Возврат; // В формате не предполагается передача сведений о файле-источнике
	КонецЕсли;
	
	Сведения = РегистрыСведений.СведенияОФайлахСообщенийЭДО.СведенияОСообщении(ИмяФайла);
	
	Если Сведения = Неопределено Тогда
		Возврат; // Не известен файл-источник
	КонецЕсли;
	
	ДокументКонтейнера.ИдентификаторДокументооборота = Сведения.ИдентификаторДокументооборота;
	
КонецПроцедуры

#КонецОбласти

#Область ТранспортныеКонтейнеры

// Параметры:
//  Контейнеры - Массив из ДокументСсылка.ТранспортныйКонтейнерЭДО
Процедура РаспаковатьКонтейнеры(Знач Контейнеры)
	
	ПараметрыВыполнения = ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
	
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(
		ПараметрыВыполнения.НаборДействий, 
		Перечисления.ДействияПоЭДО.Загрузить);
	
	ПараметрыВыполнения.ОбъектыДействий.ТранспортныеКонтейнеры = Контейнеры;
	
	ЭлектронныеДокументыЭДОСлужебный.ВыполнитьДействияЭДО(ПараметрыВыполнения);
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиОтправки

// Параметры:
//  НастройкиОтправки - См. НастройкиЭДОКлиентСервер.НовыйКлючНастроекОтправки
// 
// Возвращаемое значение:
//  Булево
Функция ЭтоНастройкиОтправкиЧерезСервис1СEDI(Знач НастройкиОтправки)
	
	Если НастройкиОтправки = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат ЭтоОбменЧерезСервис1СEDI(НастройкиОтправки.СпособОбмена);
	КонецЕсли;
	
КонецФункции

// Параметры:
//  НастройкиОтправки - См. НастройкиЭДОКлиентСервер.НовыйКлючНастроекОтправки
// 
// Возвращаемое значение:
//  Булево
Функция НастройкиОтправкиЗаполнены(Знач НастройкиОтправки)
	
	Если НастройкиОтправки = Неопределено Тогда
		Возврат Ложь;
	Иначе
		Возврат Не ПустаяСтрока(НастройкиОтправки.ИдентификаторОтправителя)
			И Не ПустаяСтрока(НастройкиОтправки.ИдентификаторПолучателя);
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#Область ИННКПП

// Проверяет, являются ли переданные ИНН и КПП сведениями валидными
// 
// Параметры:
//  ИНН - Строка
//  КПП - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если данные валидны 
//           Ложь, в ином случае.
Функция ЭтоИННКПП(Знач ИНН, Знач КПП)
	Возврат ЭтоИННКППЮЛ(ИНН, КПП)
		Или ЭтоИННКППФЛ(ИНН, КПП);
КонецФункции

// Проверяет, являются ли переданные ИНН и КПП сведениями об юр. лице
// 
// Параметры:
//  ИНН - Строка
//  КПП - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если данные валидны для юр. лица
//           Ложь, в ином случае.
Функция ЭтоИННКППЮЛ(Знач ИНН, Знач КПП)
	Возврат ЭтоИННЮЛ(ИНН)
		И ЭтоКПП(КПП);
КонецФункции

// Проверяет, являются ли переданные ИНН и КПП сведениями об физ. лице
// 
// Параметры:
//  ИНН - Строка
//  КПП - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если данные валидны для физ. лица
//           Ложь, в ином случае.
Функция ЭтоИННКППФЛ(Знач ИНН, Знач КПП)
	Возврат ЭтоИННФЛ(ИНН)
		И ПустаяСтрока(КПП);
КонецФункции

// Проверяет, являются ли переданные ИНН валидными для юр. лица
// 
// Параметры:
//  ИНН - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если данные валидны
//           Ложь, в ином случае.
Функция ЭтоИННЮЛ(Знач ИНН)
	Возврат РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ИНН, Истина, "");
КонецФункции

// Проверяет, являются ли переданные ИНН валидными для физ. лица
// 
// Параметры:
//  ИНН - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если данные валидны
//           Ложь, в ином случае.
Функция ЭтоИННФЛ(Знач ИНН)
	Возврат РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ИНН, Ложь, "");
КонецФункции

// Проверяет, являются ли переданные КПП валидными
// 
// Параметры:
//  КПП - Строка
// 
// Возвращаемое значение:
//  Булево - Истина, если данные валидны
//           Ложь, в ином случае.
Функция ЭтоКПП(Знач КПП)
	Возврат РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(КПП, "");
КонецФункции

#КонецОбласти

