// Получает идентификаторы ЭПД по набору участников ЭТрН
// 
// Параметры:
//  Организация   - ОпределяемыйТип.Организация - Организация для авторизации в сервисе 1С:Бизнес-сеть
//  УчастникиЭТрН - См. НовыеУчастникиЭТрН
// 
// Возвращаемое значение:
//  См. НовыеИдентификаторыУчастников
Функция ИдентификаторыУчастниковЭТрН(Знач Организация, Знач УчастникиЭТрН) Экспорт
	
	ТаблицаУчастников = НоваяТаблицаУчастников();
	
	Если УчастникиЭТрН.Организация <> Неопределено Тогда
		ДобавитьОрганизацию(ТаблицаУчастников, УчастникиЭТрН.Организация);
	КонецЕсли;
	
	Если УчастникиЭТрН.Контрагент <> Неопределено Тогда
		ДобавитьКонтрагента(ТаблицаУчастников, УчастникиЭТрН.Контрагент);
	КонецЕсли;
	
	Если УчастникиЭТрН.Перевозчик <> Неопределено Тогда
		ДобавитьКонтрагента(ТаблицаУчастников, УчастникиЭТрН.Перевозчик);
	КонецЕсли;
	
	Возврат ИдентификаторыУчастниковЭПД(Организация, ТаблицаУчастников);
	
КонецФункции

