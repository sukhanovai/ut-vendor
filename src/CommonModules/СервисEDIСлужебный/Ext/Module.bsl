// Новые документы.
// 
// Возвращаемое значение:
//  Структура - Новые документы:
// * Список               - См. НовыеДокументыОрганизации
// * ТекущаяСтрока        - СтрокаТаблицыЗначений: См. НовыеДокументыОрганизации
//                        - Неопределено
// * НомерСтроки          - Число
// * СтатусЗагрузки       - Строка - См. СтатусыЗагрузкиДанных
// * СтатусЧтения         - Строка - См. СтатусыЧтенияПорции
Функция НовыеДокументы()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Список"               , НовыеДокументыОрганизации());
	Результат.Вставить("ТекущаяСтрока"        , Неопределено);
	Результат.Вставить("НомерСтроки"          , 0);
	Результат.Вставить("СтатусЗагрузки"       , СтатусыЗагрузкиДанных().НеНачато);
	Результат.Вставить("СтатусЧтения"         , СтатусыЧтенияПорции().НеНачато);
	
	Возврат Результат;
	
КонецФункции

