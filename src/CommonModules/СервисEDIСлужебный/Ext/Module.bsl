КонецПроцедуры

#КонецОбласти

#Область ДанныеУчастников

#Область Конструкторы

// Метод-конструктор таблицы участников
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица участников:
// * Участник     - ЛюбаяСсылка - Ссылка на участника
// * ТипУчастника - Строка      - Тип участника, значения: См. ТипыУчастников.
Функция НоваяТаблицаУчастников() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("Участник"     , ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	Результат.Колонки.Добавить("ТипУчастника" , Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
	
КонецФункции

// Метод-конструктор данных участников
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Данные участников:
// * Участник      - ЛюбаяСсылка - Ссылка на участника
// * ИНН           - Строка      - ИНН участника
// * КПП           - Строка      - КПП участника
// * Представление - Строка      - Представление участника
Функция НовыеДанныеУчастников() Экспорт
	
	Результат = Новый ТаблицаЗначений;
	
	Результат.Колонки.Добавить("Участник"      , ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	Результат.Колонки.Добавить("ИНН"           , ОбщегоНазначения.ОписаниеТипаСтрока(12));
	Результат.Колонки.Добавить("КПП"           , ОбщегоНазначения.ОписаниеТипаСтрока(9));
	Результат.Колонки.Добавить("Представление" , Новый ОписаниеТипов("Строка"));
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область Добавление

// Добавляет организацию в таблицу участников
// 
// Параметры:
//  ТаблицаУчастников - См. НоваяТаблицаУчастников
//  Организация       - ОпределяемыйТип.Организация
Процедура ДобавитьОрганизацию(ТаблицаУчастников, Знач Организация) Экспорт
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"СервисEDIСлужебный.ДобавитьОрганизацию",
		"Организация",
		Организация,
		Метаданные.ОпределяемыеТипы.Организация.Тип);
	
	ДобавитьУчастника(ТаблицаУчастников, Организация, ТипыУчастников().Организация);
	
КонецПроцедуры

// Добавляет контрагента в таблицу участников
// 
// Параметры:
//  ТаблицаУчастников - См. НоваяТаблицаУчастников
//  Контрагент        - ОпределяемыйТип.УчастникЭДО
Процедура ДобавитьКонтрагента(ТаблицаУчастников, Знач Контрагент) Экспорт
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		"СервисEDIСлужебный.ДобавитьКонтрагента",
		"Контрагент",
		Контрагент,
		Метаданные.ОпределяемыеТипы.УчастникЭДО_ЭПД.Тип);
	
	ДобавитьУчастника(ТаблицаУчастников, Контрагент, ТипыУчастников().Контрагент);
	
КонецПроцедуры

#КонецОбласти

#Область Чтение

// Получает данные участников по таблице участников
// 
// Параметры:
//  ТаблицаУчастников - См. НоваяТаблицаУчастников
// 
// Возвращаемое значение:
//  См. НовыеДанныеУчастников
Функция ДанныеУчастников(Знач ТаблицаУчастников) Экспорт
	
	Результат = НовыеДанныеУчастников();
	
	Организации = Новый Массив; // Массив Из ЛюбаяСсылка
	Контрагенты = Новый Массив; // Массив Из ЛюбаяСсылка
	
	Для Каждого СтрокаУчастника Из ТаблицаУчастников Цикл
		
		Участник     = СтрокаУчастника.Участник;
		ТипУчастника = СтрокаУчастника.ТипУчастника;
		
		Если ЭтоТипУчастникаОрганизация(ТипУчастника) Тогда
			Организации.Добавить(Участник);
		ИначеЕсли ЭтоТипУчастникаКонтрагент(ТипУчастника) Тогда
			Контрагенты.Добавить(Участник);
		Иначе
			ВызватьИсключение(
				СтрШаблон(
					НСтр(
						"ru = 'Неизвестный тип участника %1'",
						ОбщегоНазначения.КодОсновногоЯзыка()),
					ТипУчастника));
		КонецЕсли;
		
	КонецЦикла;
	
	Организации = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Организации);
	Контрагенты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(Контрагенты);
	
	Запрос = Новый Запрос;
	
	ТекстыЗапросов = Новый Массив; // Массив Из Строка
	
	Если Организации.Количество() > 0  Тогда
		Запрос.УстановитьПараметр("Организации", Организации);
		ТекстыЗапросов.Добавить(
			ТекстЗапросаДанныеУчастникаИБ(
				"Организации",
				"ИННОрганизации",
				"КППОрганизации",
				"НаименованиеОрганизации",
				"Организации"));
	КонецЕсли;
	
	Если Контрагенты.Количество() > 0  Тогда
		Запрос.УстановитьПараметр("Контрагенты", Контрагенты);
		ТекстыЗапросов.Добавить(
			ТекстЗапросаДанныеУчастникаИБ(
				"Контрагенты",
				"ИННКонтрагента",
				"КППКонтрагента",
				"НаименованиеКонтрагента",
				"Контрагенты"));
	КонецЕсли;
	
	Если ТекстыЗапросов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ТекстРазделителяОбъединитьВсе());
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	
	Для Каждого СтрокаУчастника Из ТаблицаУчастников Цикл
		
		Участник = СтрокаУчастника.Участник;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Участник", Участник);
		
		ВыборкаЗапроса.Сбросить();
		
		Если Не ВыборкаЗапроса.НайтиСледующий(Отбор) Тогда
			ВызватьИсключение(
				СтрШаблон(
					НСтр(
						"ru = 'Не удалось найти сведения об участнике %1'",
						ОбщегоНазначения.КодОсновногоЯзыка()),
					Участник));
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		
		НоваяСтрока.Участник      = Участник;
		//@skip-check property-return-type - Особенности работы с выборкой запроса в строгой типизации
		//@skip-check statement-type-change - Особенности работы с выборкой запроса в строгой типизации
		НоваяСтрока.ИНН           = ВыборкаЗапроса.ИНН; // Строка
		//@skip-check property-return-type - Особенности работы с выборкой запроса в строгой типизации
		//@skip-check statement-type-change - Особенности работы с выборкой запроса в строгой типизации
		НоваяСтрока.КПП           = ВыборкаЗапроса.КПП; // Строка
		//@skip-check property-return-type - Особенности работы с выборкой запроса в строгой типизации
		//@skip-check statement-type-change - Особенности работы с выборкой запроса в строгой типизации
		НоваяСтрока.Представление = ВыборкаЗапроса.Представление; // Строка
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Получает данные участника по таблице данных участников
// 
// Параметры:
//  ДанныеУчастников - См. НовыеДанныеУчастников
//  Участник         - ЛюбаяСсылка
// 
// Возвращаемое значение:
//  См. НовыеДанныеУчастника
Функция ДанныеУчастника(Знач ДанныеУчастников, Знач Участник) Экспорт
	
	СтрокаУчастника = ДанныеУчастников.Найти(Участник, "Участник");
	
	Если СтрокаУчастника = Неопределено Тогда
		ВызватьИсключение(
			СтрШаблон(
				НСтр(
					"ru = 'Ошибка получения данных участника %1: участник не найден'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				Участник));
	КонецЕсли;
	
	Результат = НовыеДанныеУчастника();
	
	Результат.ИНН           = СтрокаУчастника.ИНН;
	Результат.КПП           = СтрокаУчастника.КПП;
	Результат.Представление = СтрокаУчастника.Представление;
	
	Возврат Результат;
	
КонецФункции

