КонецФункции

// Получает токен доступа 1С:Бизнес-сеть
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - Организация
// 
// Возвращаемое значение:
//  Строка - Токен доступа 1С:Бизнес-сеть
Функция ТокенОрганизацииБС(Знач Организация)
	Контекст = "СервисEDIСлужебный.ТокенОрганизацииБС";
	
	ПроверитьНаличиеПодсистемыБизнесСеть(Контекст);
	
	ОбщийМодульБизнесСеть = ОбщегоНазначения.ОбщийМодуль("БизнесСеть");
	
	ИдентификаторОрганизации = ИдентификаторОрганизацииБС(Организация);
	
	Отказ = Ложь;
	
	Токен = ОбщийМодульБизнесСеть.СтрокаАутентификации(ИдентификаторОрганизации, Ложь, Отказ, Ложь); // Строка
	
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не Отказ,
		НСтр(
			"ru = 'Ошибка получения токена доступа 1С:Бизнес-сеть'",
			ОбщегоНазначения.КодОсновногоЯзыка()),
		Контекст);
	
	Возврат Токен;
	
КонецФункции

