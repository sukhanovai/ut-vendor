// Метод-конструктор участников ЭТрН
// 
// Возвращаемое значение:
//  Структура - Участники ЭТрН:
// * Организация - ОпределяемыйТип.Организация     - Организация по ЭТрН 
//               - Неопределено                    - Не указана
// * Контрагент  - ОпределяемыйТип.УчастникЭДО_ЭПД - Контрагент по ЭТрН
//               - Неопределено                    - Не указан
// * Перевозчик  - ОпределяемыйТип.УчастникЭДО_ЭПД - Перевозчик по ЭТрН 
//               - Неопределено                    - Не указан
Функция НовыеУчастникиЭТрН() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация" , Неопределено);
	Результат.Вставить("Контрагент"  , Неопределено);
	Результат.Вставить("Перевозчик"  , Неопределено);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

