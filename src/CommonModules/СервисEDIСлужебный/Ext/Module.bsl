#Область НастройкиОтправкиЭлектронныхДокументовПоВидам

// Параметры:
//  ТипДокумента - ПеречислениеСсылка.ТипыДокументовЭДО
//  Организация  - ОпределяемыйТип.Организация
//  Контрагент   - ОпределяемыйТип.УчастникЭДО
Процедура ЗафиксироватьНастройки(
	Знач ТипДокумента, 
	Знач Организация, 
	Знач Контрагент)
	
	ПроверитьНаличиеПодсистемыБизнесСеть("СервисEDIСлужебный.ЗафиксироватьНастройки");
	
	ВидДокумента  = ВидДокумента(ТипДокумента);
	Договор       = ПустойДоговор();
	СпособОбмена  = СпособОбмена();
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокумента, Организация, Контрагент);
		
		НаборЗаписей = РегистрыСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Отправитель.Установить(Организация);
		НаборЗаписей.Отбор.Получатель.Установить(Контрагент);
		НаборЗаписей.Отбор.Договор.Установить(Договор);
		НаборЗаписей.Отбор.ВидДокумента.Установить(ВидДокумента);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 1 Тогда
			
			ВызватьИсключение(
				СтрШаблон(
					НСтр(
						"ru = 'Выявлено дублирование настроек отправки по видам для:
						|Отправитель: %1
						|Получатель: %2
						|Вид документа: %3'",
						ОбщегоНазначения.КодОсновногоЯзыка()),
					Организация,
					Контрагент,
					ВидДокумента));
			
		ИначеЕсли НаборЗаписей.Количество() = 1 Тогда
			
			Если НаборЗаписей[0].СпособОбменаЭД <> СпособОбмена Тогда
				ВызватьИсключение(
					СтрШаблон(
						НСтр(
							"ru = 'Настройка отправки документа ""%1"" для организации ""%2"" и контрагента ""%3"" уже существует.'",
							ОбщегоНазначения.КодОсновногоЯзыка()),
						ВидДокумента,
						Организация,
						Контрагент));
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			Возврат; // Настройки установлены ранее
			
		КонецЕсли;
		
		Запись = НаборЗаписей.Добавить();
		
		Запись.Отправитель       = Организация;
		Запись.Получатель        = Контрагент;
		Запись.Договор           = Договор;
		Запись.ВидДокумента      = ВидДокумента;
		Запись.СпособОбменаЭД    = СпособОбмена;
		Запись.Формировать       = Истина;
		Запись.МаршрутПодписания = Справочники.МаршрутыПодписания.ОднойДоступнойПодписью;
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Параметры:
//  ВидДокумента - ДокументСсылка.СообщениеЭДО
//  Организация  - ОпределяемыйТип.Организация
//  Контрагент  - ОпределяемыйТип.УчастникЭДО
Процедура УстановитьБлокировкуНастроекОтправкиПоВидам(
	Знач ВидДокумента, 
	Знач Организация, 
	Знач Контрагент)
	
	ПроверитьАктивностьТранзакции("СервисEDIСлужебный.УстановитьБлокировкуНастроекОтправкиПоВидам");
	
	ИмяРегистра = Метаданные.РегистрыСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам.ПолноеИмя();
	Блокировка  = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить(ИмяРегистра);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки.УстановитьЗначение("Отправитель"  , Организация);
	ЭлементБлокировки.УстановитьЗначение("Получатель"   , Контрагент);
	ЭлементБлокировки.УстановитьЗначение("Договор"      , ПустойДоговор());	
	ЭлементБлокировки.УстановитьЗначение("ВидДокумента" , ВидДокумента);
	
	//@skip-check lock-out-of-try - Транзакция открывается выше по стеку
	Блокировка.Заблокировать();
	
КонецПроцедуры

#КонецОбласти

#Область НастройкиЭДО

// Требуется настройка обмена с участником.
// 
// Параметры:
//  Организация - ОпределяемыйТип.Организация - Организация.
//  Получатель - ОпределяемыйТип.УчастникЭДО - Получатель.
//  Договор - Неопределено, ОпределяемыйТип.ДоговорСКонтрагентомЭДО - Договор с Получателем
//  ВидДокумента - СправочникСсылка.ВидыДокументовЭДО - Вид документа ЭДО
// 
// Возвращаемое значение:
//  Булево - Требуется настройка обмена с участником
Функция ТребуетсяНастройкаОбменаСУчастником(Знач Организация, Знач Получатель, Знач Договор, Знач ВидДокумента)

	КлючНастроек = НастройкиЭДОКлиентСервер.НовыйКлючНастроекОтправки();
	
	КлючНастроек.Отправитель = Организация;
	КлючНастроек.Получатель = Получатель;
	КлючНастроек.Договор = Договор;
	КлючНастроек.ВидДокумента = ВидДокумента;

	НастройкиОтправки = НастройкиЭДО.НастройкиОтправки(КлючНастроек);

	Возврат ЭтоНастройкиОтправкиЧерезСервис1СEDI(НастройкиОтправки)
		И Не НастройкиОтправкиЗаполнены(НастройкиОтправки)
	
КонецФункции

#КонецОбласти

#Область ПриглашенияЭДО

// Параметры:
//  Ключ                     - Строка
//  ИдентификаторОрганизации - Строка
Процедура УстановитьБлокировкуПриглашенияЭДО(Знач Ключ, Знач ИдентификаторОрганизации)
	
	ПроверитьАктивностьТранзакции("СервисEDIСлужебный.УстановитьБлокировкуПриглашенияЭДО");
	
	ПространствоИмен = Метаданные.РегистрыСведений.ПриглашенияКОбменуЭлектроннымиДокументами.ПолноеИмя();
	
	БлокировкаДанных = Новый БлокировкаДанных();
	ЭлементБлокировки = БлокировкаДанных.Добавить(ПространствоИмен);
	ЭлементБлокировки.УстановитьЗначение("Ключ"                     , Ключ);
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторОрганизации" , ИдентификаторОрганизации);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	//@skip-check lock-out-of-try - Транзакция открывается выше по стеку
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

// Параметры:
//  Отправитель              - ОпределяемыйТип.Организация
//  Получатель               - ОпределяемыйТип.УчастникЭДО
//  ИдентификаторОтправителя - Строка
//  ИдентификаторПолучателя  - Строка
Процедура ОтключитьПриглашенияЭДО(
	Знач Отправитель,
	Знач Получатель,
	Знач ИдентификаторОтправителя, 
	Знач ИдентификаторПолучателя)
	
	ДанныеКонтрагента = ДанныеКонтрагента(Получатель);
	Ключ              = Строка(Новый УникальныйИдентификатор);
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуПриглашенияЭДО(Ключ, ИдентификаторОтправителя);
		
		НаборЗаписей = РегистрыСведений.ПриглашенияКОбменуЭлектроннымиДокументами.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Ключ.Установить(Ключ);
		НаборЗаписей.Отбор.ИдентификаторОрганизации.Установить(ИдентификаторОтправителя);
		
		Запись = НаборЗаписей.Добавить();
		
		Запись.Ключ = Ключ;
		Запись.ИдентификаторОрганизации = ИдентификаторОтправителя;
		
		Запись.ИдентификаторКонтрагента = ИдентификаторПолучателя;
		Запись.ИНН = ДанныеКонтрагента.ИНН;
		Запись.КПП = ДанныеКонтрагента.КПП;
		
		Запись.Статус = Перечисления.СтатусыПриглашений.НеТребуется;
		
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаписьНастроек

// Параметры:
//  ИдентификаторЭДО - Строка
Процедура УстановитьБлокировкуУчетнойЗаписи(Знач ИдентификаторЭДО)
	
	ПроверитьАктивностьТранзакции("СервисEDIСлужебный.ЗаблокироватьУчетнуюЗапись");
	
	БлокировкаДанных = Новый БлокировкаДанных();
	ЭлементБлокировки = БлокировкаДанных.Добавить(Метаданные.РегистрыСведений.УчетныеЗаписиЭДО.ПолноеИмя());
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторЭДО", ИдентификаторЭДО);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	//@skip-check lock-out-of-try - Транзакция открывается выше по стеку
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

// Создает учетную запись ЭДО
// 
// Параметры:
//  Организация      - ОпределяемыйТип.Организация - Организация
//  ИдентификаторЭДО - Строка                      - Идентификатор ЭДО
Процедура ЗаписатьУчетнуюЗапись(Знач Организация, Знач ИдентификаторЭДО)
	
	СпособОбменаЭД = СпособОбмена();
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуУчетнойЗаписи(ИдентификаторЭДО);
		
		НаборЗаписей = РегистрыСведений.УчетныеЗаписиЭДО.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ИдентификаторЭДО.Установить(ИдентификаторЭДО);
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Запись = НаборЗаписей.Добавить();
			Запись.ИдентификаторЭДО          = ИдентификаторЭДО;
			Запись.Организация               = Организация;
			Запись.СпособОбменаЭД            = СпособОбмена();
			Запись.ОператорЭДО               = "2JM"; // ООО "СИСЛИНК"
			Запись.НаименованиеУчетнойЗаписи = 
				СтрШаблон(
					НСтр(
						"ru = '%1 (1С:EDI)'",
						ОбщегоНазначения.КодОсновногоЯзыка()),
					ПредставлениеОбъекта(Организация));
			Запись.НазначениеУчетнойЗаписи   = 
				НСтр("ru = 'Для обмена через сервис 1С:EDI'", ОбщегоНазначения.КодОсновногоЯзыка());
		Иначе
			Запись = НаборЗаписей[0];
			
			Если Запись.Организация <> Организация Тогда
				ВызватьИсключение(
					СтрШаблон(
						НСтр(
							"ru = 'Идентификатор %1 уже занят организацией %2 (организация для записи: %3)'",
							ОбщегоНазначения.КодОсновногоЯзыка()),
						ИдентификаторЭДО,
						Запись.Организация,
						Организация));
			КонецЕсли;
			
			Если Запись.СпособОбменаЭД <> СпособОбменаЭД Тогда
				ВызватьИсключение(
					СтрШаблон(
						НСтр(
							"ru = 'Для учетной записи %1 используется способ обмена %2 (способ обмена для записи: %3)'",
							ОбщегоНазначения.КодОсновногоЯзыка()),
						ИдентификаторЭДО,
						Запись.СпособОбменаЭД,
						СпособОбменаЭД));
			КонецЕсли;
			
		КонецЕсли;
		
		Запись.ПринятыУсловияИспользования = Истина;
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Добавляет сертификат к учетной записи ЭДО
// 
// Параметры:
//  ИдентификаторЭДО - Строка                                                          - Идентификатор ЭДО
//  Сертификат       - СправочникСсылка.СертификатыКлючейЭлектроннойПодписиИШифрования - Сертификат
//  Доверенность     - ОпределяемыйТип.МашиночитаемаяДоверенность                      - Доверенность
Процедура ЗаписатьСертификатУчетнойЗаписи(Знач ИдентификаторЭДО, Знач Сертификат, Знач Доверенность = Неопределено)
	
	Сертификаты = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сертификат);
	
	Доверенности = Новый Соответствие;
	
	Если Доверенность <> Неопределено Тогда
		Доверенности.Вставить(Сертификат, Доверенность);
	КонецЕсли;
	
	УчетныеЗаписиЭДО.ЗаписатьСертификатыУчетнойЗаписи(ИдентификаторЭДО, Сертификаты, , Доверенности);
	
КонецПроцедуры

// Фиксирует идентификаторы обмена.
// 
// Параметры:
//  ВидДокумента             - СправочникСсылка.ВидыДокументовЭДО - Вид документа
//  Отправитель              - ОпределяемыйТип.Организация - Организация-отправитель
//  Получатель               - ОпределяемыйТип.УчастникЭДО - Получатель
//  ИдентификаторОтправителя - Строка - Идентификатор отправителя
//  ИдентификаторПолучателя  - Строка - Идентификатор получателя
Процедура ЗаписатьИдентификаторы(
	Знач ВидДокумента, 
	Знач Отправитель, 
	Знач Получатель, 
	Знач ИдентификаторОтправителя, 
	Знач ИдентификаторПолучателя)
	
	Договор       = ПустойДоговор();
	СпособОбмена  = СпособОбмена();
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировкуНастроекОтправкиПоВидам(ВидДокумента, Отправитель, Получатель);
		
		НаборЗаписей = РегистрыСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Отправитель.Установить(Отправитель);
		НаборЗаписей.Отбор.Получатель.Установить(Получатель);
		НаборЗаписей.Отбор.Договор.Установить(Договор);
		НаборЗаписей.Отбор.ВидДокумента.Установить(ВидДокумента);
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() > 1 Тогда
			
			ВызватьИсключение(
				СтрШаблон(
					НСтр(
						"ru = 'Выявлено дублирование настроек отправки по видам для:
						|Отправитель: %1
						|Получатель: %2
						|Вид документа: %3'",
						ОбщегоНазначения.КодОсновногоЯзыка()),
					Отправитель,
					Получатель,
					ВидДокумента));
			
		ИначеЕсли НаборЗаписей.Количество() = 1 Тогда
			
			Если НаборЗаписей[0].СпособОбменаЭД <> СпособОбмена Тогда
				ВызватьИсключение(
					СтрШаблон(
						НСтр(
							"ru = 'Настройка отправки документа ""%1"" для организации ""%2"" и контрагента ""%3"" уже существует.'",
							ОбщегоНазначения.КодОсновногоЯзыка()),
						ВидДокумента,
						Отправитель,
						Получатель));
			КонецЕсли;
			
			Запись = НаборЗаписей[0];
			
		Иначе
			
			Запись = НаборЗаписей.Добавить();
			
			Запись.Отправитель       = Отправитель;
			Запись.Получатель        = Получатель;
			Запись.Договор           = Договор;
			Запись.ВидДокумента      = ВидДокумента;
			Запись.СпособОбменаЭД    = СпособОбмена;
			
		КонецЕсли;
		
		Запись.ИдентификаторОтправителя = ИдентификаторОтправителя;
		Запись.ИдентификаторПолучателя  = ИдентификаторПолучателя;
		
		Запись.Формировать       = Истина;
		Запись.МаршрутПодписания = Справочники.МаршрутыПодписания.ОднойДоступнойПодписью;
		
		ОтключитьПриглашенияЭДО(
			Отправитель, 
			Получатель, 
			ИдентификаторОтправителя, 
			ИдентификаторПолучателя);
		
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область ДанныеУчастников

// Метод-конструктор данных участника
// 
// Возвращаемое значение:
//  Структура - Новые данные участника:
// * ИНН           - Строка      - ИНН участника
// * КПП           - Строка      - КПП участника
// * Представление - Строка      - Представление участника
Функция НовыеДанныеУчастника()
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИНН", "");
	Результат.Вставить("КПП", "");
	Результат.Вставить("Представление", "");
	
	Возврат Результат;
	
КонецФункции

// Перечисление типов участников
// 
// Возвращаемое значение:
//  Структура - Типы участников:
// * Организация - Строка - Организация
// * Контрагент  - Строка - Контрагент
Функция ТипыУчастников()
	
	Результат = Новый Структура;
	
	Результат.Вставить("Организация" , "Организация");
	Результат.Вставить("Контрагент"  , "Контрагент");
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли тип участника организацией
// 
// Параметры:
//  ТипУчастника - Строка - Тип участника
// 
// Возвращаемое значение:
//  Булево - Истина, если это тип участника организация.
//           Ложь в ином случае.
Функция ЭтоТипУчастникаОрганизация(Знач ТипУчастника)
	Возврат ТипУчастника = ТипыУчастников().Организация;
КонецФункции

// Проверяет, является ли тип участника контрагентом
// 
// Параметры:
//  ТипУчастника - Строка - Тип участника
// 
// Возвращаемое значение:
//  Булево - Истина, если это тип участника контрагент.
//           Ложь в ином случае.
Функция ЭтоТипУчастникаКонтрагент(Знач ТипУчастника)
	Возврат ТипУчастника = ТипыУчастников().Контрагент;
КонецФункции

// Добавляет участника в таблицу участников
// 
// Параметры:
//  ТаблицаУчастников - См. НоваяТаблицаУчастников
//  Участник          - ЛюбаяСсылка - Добавляемый участник
//  ТипУчастника      - Строка      - Тип добавляемого участника
Процедура ДобавитьУчастника(ТаблицаУчастников, Знач Участник, Знач ТипУчастника)
	
	НайденнаяСтрока = ТаблицаУчастников.Найти(Участник, "Участник");
	
	Если НайденнаяСтрока = Неопределено Тогда
		
		НоваяСтрока = ТаблицаУчастников.Добавить();
		
		НоваяСтрока.Участник     = Участник;
		НоваяСтрока.ТипУчастника = ТипУчастника;
		
	ИначеЕсли НайденнаяСтрока.ТипУчастника = ТипУчастника Тогда 
		Возврат; // Ничего не делаем, участник уже добавлен ранее
	Иначе
		ВызватьИсключение(
			СтрШаблон(
				НСтр(
					"ru = 'Ошибка дублирования при добавлении участника %1:
					|- Тип добавляемого участника: %2
					|- Тип ранее добавленного участника: %3'",
					ОбщегоНазначения.КодОсновногоЯзыка()),
				Участник,
				ТипУчастника,
				НайденнаяСтрока.ТипУчастника));
	КонецЕсли;
	
КонецПроцедуры

// Получает шаблон текста запросов для данных участников
// 
// Возвращаемое значение:
//  Строка - Шаблон текста запроса
Функция ТекстЗапросаДанныеУчастника()
	
	Возврат
		"ВЫБРАТЬ
		|	Таблица.Ссылка КАК Участник,
		|	&ПутьИНН КАК ИНН,
		|	&ПутьКПП КАК КПП,
		|	&ПутьПредставление КАК Представление
		|ИЗ
		|	&Таблица КАК Таблица
		|ГДЕ
		|	Таблица.Ссылка В(&НаборСсылок)";
	
КонецФункции

// См. ОбщегоНазначенияБЭДПовтИсп.ИмяПрикладногоСправочника
Функция ИмяПрикладногоСправочника(Знач ИмяСправочника)
	Возврат ОбщегоНазначенияБЭДПовтИсп.ИмяПрикладногоСправочника(ИмяСправочника);
КонецФункции

// См. ОбщегоНазначенияБЭДПовтИсп.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении
Функция ИмяРеквизитаПрикладногоСправочника(Знач ИмяРеквизита)
	Возврат ОбщегоНазначенияБЭДПовтИсп.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении(ИмяРеквизита);
КонецФункции

// Получает текст запроса по данным типа участника.
// 
// Параметры:
//  ИмяПараметраСправочник            - Строка - Имя параметра для прикладного справочника
//  ИмяПараметраРеквизитИНН           - Строка - Имя параметра для реквизита ИНН
//  ИмяПараметраРеквизитКПП           - Строка - Имя параметра для реквизита КПП
//  ИмяПараметраРеквизитПредставление - Строка - Имя параметра для реквизита представления
//  ИмяПараметраНаборСсылок           - Строка - Имя параметра для набора ссылок
// 
// Возвращаемое значение:
//  Строка - Текст запроса по типа участника
Функция ТекстЗапросаДанныеУчастникаИБ(
	Знач ИмяПараметраСправочник,
	Знач ИмяПараметраРеквизитИНН,
	Знач ИмяПараметраРеквизитКПП,
	Знач ИмяПараметраРеквизитПредставление,
	Знач ИмяПараметраНаборСсылок)
	
	Результат = ТекстЗапросаДанныеУчастника();
	
	ИмяСправочника            = ИмяПрикладногоСправочника(ИмяПараметраСправочник);
	ИмяРеквизитаИНН           = ИмяРеквизитаПрикладногоСправочника(ИмяПараметраРеквизитИНН);
	ИмяРеквизитаКПП           = ИмяРеквизитаПрикладногоСправочника(ИмяПараметраРеквизитКПП);
	ИмяРеквизитаПредставление = ИмяРеквизитаПрикладногоСправочника(ИмяПараметраРеквизитПредставление);
	
	ПолноеИмяСправочника            = СтрШаблон("Справочник.%1" , ИмяСправочника);
	ПолноеИмяРеквизитаИНН           = СтрШаблон("Таблица.%1"    , ИмяРеквизитаИНН);
	ПолноеИмяРеквизитаКПП           = СтрШаблон("Таблица.%1"    , ИмяРеквизитаКПП);
	ПолноеИмяРеквизитаПредставление = СтрШаблон("Таблица.%1"    , ИмяРеквизитаПредставление);
	ПолноеИмяПараметра              = СтрШаблон("&%1"           , ИмяПараметраНаборСсылок);
	
	Результат = СтрЗаменить(Результат, "&Таблица"           , ПолноеИмяСправочника);
	Результат = СтрЗаменить(Результат, "&ПутьИНН"           , ПолноеИмяРеквизитаИНН);
	Результат = СтрЗаменить(Результат, "&ПутьКПП"           , ПолноеИмяРеквизитаКПП);
	Результат = СтрЗаменить(Результат, "&ПутьПредставление" , ПолноеИмяРеквизитаПредставление);
	Результат = СтрЗаменить(Результат, "&НаборСсылок"       , ПолноеИмяПараметра);
	
	Возврат Результат;
	
КонецФункции

// Текст разделителя запросов ОБЪЕДИНИТЬ ВСЕ.
// 
// Возвращаемое значение:
//  Строка - Текст разделителя запросов
Функция ТекстРазделителяОбъединитьВсе()
	Возврат Символы.ПС + Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС + Символы.ПС;
КонецФункции

// Получает данные контрагента по ссылке на контрагента
// 
// Параметры:
//  Контрагент - ОпределяемыйТип.УчастникЭДО
// 
// Возвращаемое значение:
//  См. НовыеДанныеУчастника
Функция ДанныеКонтрагента(Знач Контрагент)
	
	Участники = НоваяТаблицаУчастников();
	ДобавитьКонтрагента(Участники, Контрагент);
	ДанныеУчастников = ДанныеУчастников(Участники);
