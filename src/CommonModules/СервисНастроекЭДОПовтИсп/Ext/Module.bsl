#Область СлужебныйПрограммныйИнтерфейс

// Оператор поддерживает формат пакета регистрации с версией не ниже указанной.
// 
// Параметры:
//  ИдентификаторОператора - Строка - идентификатор оператора
//  Версия - Строка - целевая версия для сравнения
// 
// Возвращаемое значение:
//  Булево - Истина, если поддерживает
Функция ОператорПоддерживаетВерсиюФорматаРегистрации(ИдентификаторОператора, Версия) Экспорт
	
	Если Не ЗначениеЗаполнено(ИдентификаторОператора) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВерсияОператора = РегистрыСведений.ОператорыЭДО.ВерсияПоддерживаемогоРегистрационногоПакета(ИдентификаторОператора);
	
	Если Не ЗначениеЗаполнено(ВерсияОператора) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СервисЭДОКлиентСервер.СравнитьВерсииФорматовРегистрации(ВерсияОператора, Версия) >= 0;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает объект HTTPСоединение для работы с сервисом электронного документооборота.
// 
// Параметры:
// 	Таймаут - Число
// 	НоваяВерсияАПИСервиса1СЭДО - Булево - использовать API v2 сервиса.
// Возвращаемое значение:
// 	см. ИнтернетСоединениеБЭД.ОписаниеHTTPСоединения
Функция СоединениеССервисом(Таймаут = 30) Экспорт
	
	Возврат ИнтернетСоединениеБЭД.ОписаниеHTTPСоединения(СервисНастроекЭДО.АдресСервисаНастроек(), Таймаут);
	
КонецФункции

// Возвращает неподдерживемые операторами форматы.
// 
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - Строка - идентификатор оператора
//   * Значение - Массив из Строка - идентификаторы форматов
//
Функция НеподдерживаемыеОператорамиФорматы() Экспорт
	
	Результат = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОператорыЭДО.ИдентификаторОператора КАК ИдентификаторОператора,
	|	ОператорыЭДО.НеподдерживаемыеФорматы КАК НеподдерживаемыеФорматы
	|ИЗ
	|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Если ПустаяСтрока(Выборка.НеподдерживаемыеФорматы) Тогда
			Продолжить;
		КонецЕсли;
		Результат.Вставить(Выборка.ИдентификаторОператора,
			ОбщегоНазначения.JSONВЗначение(Выборка.НеподдерживаемыеФорматы, Неопределено, Истина));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// см. РегистрыСведений.ОператорыЭДО.ВерсияПоддерживаемогоРегистрационногоПакета
Функция ВерсияПоддерживаемогоРегистрационногоПакетаОператора(ИдентификаторОператора) Экспорт
	
	Возврат РегистрыСведений.ОператорыЭДО.ВерсияПоддерживаемогоРегистрационногоПакета(ИдентификаторОператора);
	
КонецФункции

// см. РегистрыСведений.ОператорыЭДО.ОператорПоддерживаетОбменБезПриглашений
Функция ОператорПоддерживаетОбменБезПриглашений(ИдентификаторОператора) Экспорт
	
	Возврат РегистрыСведений.ОператорыЭДО.ОператорПоддерживаетОбменБезПриглашений(ИдентификаторОператора);
	
КонецФункции

#КонецОбласти