Функция ШтрихкодыНоменклатурыИзXML(ЧтениеXML)
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	НаборЗаписей = РегистрыСведений.ШтрихкодыНоменклатуры.СоздатьНаборЗаписей();

	НаборЗаписей.Отбор.Штрихкод.Установить(ОбъектXDTO.ОтборШтрихкод);
	НаборЗаписей.Отбор.Номенклатура.Установить(Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ОтборНоменклатура)));
	НаборЗаписей.Отбор.Характеристика.Установить(Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ОтборХарактеристика)));
	НаборЗаписей.Отбор.Серия.Установить(Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ОтборСерия)));
	НаборЗаписей.Отбор.Упаковка.Установить(Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ОтборУпаковка)));
	
	Если ОбъектXDTO.Свойства().Получить("ШтрихкодыСписок") <> Неопределено Тогда   
		
		Если ТипЗнч(ОбъектXDTO.ШтрихкодыСписок.ЭлементШтрихкоды) <> Тип("СписокXDTO") Тогда
			СписокXDTOСтрокаШтрихкоды = Новый Массив;
			СписокXDTOСтрокаШтрихкоды.Добавить(ОбъектXDTO.ШтрихкодыСписок.ЭлементШтрихкоды);
		Иначе
			СписокXDTOСтрокаШтрихкоды = ОбъектXDTO.ШтрихкодыСписок.ЭлементШтрихкоды;
		КонецЕсли;
			
		Для Каждого СтрокаШтрихкоды Из СписокXDTOСтрокаШтрихкоды Цикл
			НоваяЗапись = НаборЗаписей.Добавить();
	
			НоваяЗапись.Штрихкод = СтрокаШтрихкоды.Штрихкод;
			НоваяЗапись.Номенклатура = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаШтрихкоды.Номенклатура));
			НоваяЗапись.Характеристика = Справочники.ХарактеристикиНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаШтрихкоды.Характеристика));
			НоваяЗапись.Серия = Справочники.СерииНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаШтрихкоды.Серия));
			НоваяЗапись.Упаковка = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(СтрокаШтрихкоды.Упаковка));
		КонецЦикла;
	КонецЕсли;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции

Функция СнимкиОтчетовИзXML(ЧтениеXML)
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	МенеджерЗаписи = РегистрыСведений.СнимкиОтчетов.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.Пользователь = Справочники.Пользователи.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.Пользователь));
	
	Если ОбъектXDTO.Свойства().Получить("Отчет") <> Неопределено Тогда
		ТипОтчет = ОбъектXDTO.ТипОтчет;
		Тип = МобильноеРабочееМестоКладовщика.МенеджерОбъектаПоПолномуИмени(ТипОтчет);
		МенеджерЗаписи.Отчет = Тип.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.Отчет));
	КонецЕсли;
	
	Если ОбъектXDTO.Свойства().Получить("ВариантОтчета") <> Неопределено Тогда
		ТипВариант = ОбъектXDTO.ТипВариант;
		Тип = МобильноеРабочееМестоКладовщика.МенеджерОбъектаПоПолномуИмени(ТипВариант);
		МенеджерЗаписи.Вариант = Тип.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ВариантОтчета));
	КонецЕсли;
	
	МенеджерЗаписи.ХешПользовательскойНастройки = ОбъектXDTO.ХешПользовательскойНастройки;
	
	Если ОбъектXDTO.Свойства().Получить("РезультатОтчета") <> Неопределено Тогда
		МенеджерЗаписи.РезультатОтчета = ОбъектXDTO.РезультатОтчета.ValueStorage;
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("ДатаАктуальности") <> Неопределено Тогда
		МенеджерЗаписи.ДатаАктуальности = Дата(ОбъектXDTO.ДатаАктуальности);
	КонецЕсли;
	Если ОбъектXDTO.Свойства().Получить("ДатаПоследнегоПросмотра") <> Неопределено Тогда
		МенеджерЗаписи.ДатаПоследнегоПросмотра = Дата(ОбъектXDTO.ДатаПоследнегоПросмотра);
	КонецЕсли;
	
	МенеджерЗаписи.ОшибкаОбновленияОтчета = Булево(ОбъектXDTO.ОшибкаОбновленияОтчета);
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
	КонецПопытки;
	
	Возврат Неопределено;
	
