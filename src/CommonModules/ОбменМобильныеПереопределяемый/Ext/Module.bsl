Функция НоменклатураИзXML(ЧтениеXML)
	
	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЭтоГруппа = Булево(ОбъектXDTO.ЭтоГруппа);
	
	ДанныеСсылка = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.Ссылка));
	Данные = ДанныеСсылка.ПолучитьОбъект();
	
	Если Данные = Неопределено И ЭтоГруппа Тогда
		Данные = Справочники.Номенклатура.СоздатьГруппу();
		Данные.УстановитьСсылкуНового(ДанныеСсылка);
	ИначеЕсли Данные = Неопределено И НЕ ЭтоГруппа Тогда
		Данные = Справочники.Номенклатура.СоздатьЭлемент();
		Данные.УстановитьСсылкуНового(ДанныеСсылка);
	Иначе
		Данные = ДанныеСсылка.ПолучитьОбъект();
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Данные, ОбъектXDTO);
	
	Если ОбъектXDTO.Свойства().Получить("Родитель") <> Неопределено Тогда
		Данные.Родитель = Справочники.Номенклатура.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.Родитель));
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Возврат Данные;
	КонецЕсли;
	
	Данные.ЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ЕдиницаИзмерения));
	Данные.ВидНоменклатуры = Справочники.ВидыНоменклатуры.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ВидНоменклатуры));
	Данные.НаборУпаковок = Справочники.НаборыУпаковок.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.НаборУпаковок));
	Если ОбъектXDTO.Свойства().Получить("ОсобенностьУчета") <> Неопределено Тогда
		Если ТипЗнч(ОбъектXDTO.ОсобенностьУчета) = Тип("Строка") Тогда
			Данные.ОсобенностьУчета = Перечисления.ОсобенностиУчетаНоменклатуры[ОбъектXDTO.ОсобенностьУчета];
		КонецЕсли;
	КонецЕсли;
	Если ТипЗнч(ОбъектXDTO.ТипНоменклатуры) = Тип("Строка") Тогда
		Данные.ТипНоменклатуры = Перечисления.ТипыНоменклатуры[ОбъектXDTO.ТипНоменклатуры];
	КонецЕсли;
	Если ТипЗнч(ОбъектXDTO.ИспользованиеХарактеристик) = Тип("Строка") Тогда
		Данные.ИспользованиеХарактеристик = Перечисления.ВариантыИспользованияХарактеристикНоменклатуры[ОбъектXDTO.ИспользованиеХарактеристик];
	КонецЕсли;
	
	Данные.ВесИспользовать = Булево(ОбъектXDTO.ВесИспользовать);
	Данные.ВесМожноУказыватьВДокументах = Булево(ОбъектXDTO.ВесМожноУказыватьВДокументах);
	Если ОбъектXDTO.Свойства().Получить("ВесЕдиницаИзмерения") <> Неопределено Тогда
		Данные.ВесЕдиницаИзмерения = Справочники.УпаковкиЕдиницыИзмерения.ПолучитьСсылку(Новый УникальныйИдентификатор(ОбъектXDTO.ВесЕдиницаИзмерения));
	КонецЕсли;
	Данные.ВесЧислитель = Число(ОбъектXDTO.ВесЧислитель);
