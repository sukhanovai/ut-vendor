// Проверяет наличие внутреннего ТСПИоТа
Функция СуществуетВнутреннийТСПИоТ()Экспорт
	
	НаличиеПИоТ = Истина;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТСПИоТ.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ТСПИоТ КАК ТСПИоТ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
		|		ПО ТСПИоТ.ФискальноеУстройство = ПодключаемоеОборудование.Ссылка
		|ГДЕ
		|	ТСПИоТ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыТСПИоТ.Внутренний1С)
		|	И НЕ ПодключаемоеОборудование.ПометкаУдаления
		|	И НЕ ТСПИоТ.ПометкаУдаления";
	
	ВыборкаТСПИоТ = Запрос.Выполнить();
	Если ВыборкаТСПИОТ.Пустой() Тогда
		НаличиеПИоТ = Ложь;
	КонецЕсли;
	
	Возврат НаличиеПИоТ;
	
КонецФункции

// Функция параметры ПИоТ по подключаемому оборудованию
//
// Параметры:
//  ПодключаемоеОборудование - СправочникСсылка.ПодключаемоеОборудование.
//
// Возвращаемое значение:
//  - Структура 
//
Функция ПолучитьПараметрыТСПИоТ(ПодключаемоеОборудование) Экспорт
	
	ТСПИоТ = ПолучитьТСПИоТ(ПодключаемоеОборудование);    
	Если ЗначениеЗаполнено(ТСПИоТ) Тогда 
		ПараметрыТСПИоТ = Новый Структура();
		ПараметрыТСПИоТ.Вставить("Тип"           , ТСПИоТ.Тип);       
		ПараметрыТСПИоТ.Вставить("Наименование"  , ТСПИоТ.Наименование);     
		ПараметрыТСПИоТ.Вставить("ПутьКДрайверу"          , ТСПИоТ.ПутьКДрайверу); 
		ПараметрыТСПИоТ.Вставить("ПутьДанныхЭкземпляра"   , ТСПИоТ.ПутьДанныхЭкземпляра);
		ПараметрыТСПИоТ.Вставить("ИдентификаторЭкземпляра", ТСПИоТ.ИдентификаторЭкземпляра);  
		ПараметрыТСПИоТ.Вставить("УровеньЛога"   , ТСПИоТ.УровеньЛога);
	Иначе
		ПараметрыТСПИоТ = Неопределено;   
	КонецЕсли;
		
	Возврат ПараметрыТСПИоТ;
	
КонецФункции

Функция ПрохожденияСертификацииТСПИоТ() Экспорт  
	
	Результат = Истина;
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Получить регистрационню информацию ТС ПИоТ
//
// Возвращаемое значение:
//  Структура -
//  * БиблиотекаИдентификатор - Строка -
//  * БиблиотекаНазвание - Строка -
//  * БиблиотекаВерсия - Строка -
//  * КонфигурацииИдентификатор - Строка -
//  * КонфигурацииНазвание - Строка -
//
Функция РегистрационнаяИнформацияТСПИоТ();
	
	РегистрационнаяИнформация = Новый Структура();   
	РегистрационнаяИнформация.Вставить("БиблиотекаИдентификатор");
	РегистрационнаяИнформация.Вставить("БиблиотекаНазвание");
	РегистрационнаяИнформация.Вставить("БиблиотекаВерсия");
	РегистрационнаяИнформация.Вставить("КонфигурацииИдентификатор");
	РегистрационнаяИнформация.Вставить("КонфигурацииНазвание", Метаданные.КраткаяИнформация);
	РегистрационнаяИнформация.Вставить("КонфигурацииВерсия"  , Метаданные.Версия);
	
	МенеджерОборудованияТСПИоТПереопределяемый.РегистрационнаяИнформацияТСПИоТ(РегистрационнаяИнформация);
	
	Возврат РегистрационнаяИнформация;
	
КонецФункции       

#КонецОбласти

#КонецЕсли