Функция СкрытыйПароль()
	
	Возврат "****************";
	
КонецФункции

&НаКлиенте
Процедура НовыйСвойстваПароля()
	
	СвойстваПароля = Новый Структура("Пароль, ПарольВерен, ПарольПроверен", "", Ложь, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура НайтиОрганизацию()
	
	Если Не ЗначениеЗаполнено(ИНН) Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидОрганизацииДляПодключения = ЮридическоеЛицо() Тогда
		ВидОрганизацииДляПоиска = "ЮЛ";
	ИначеЕсли ВидОрганизацииДляПодключения = ИндивидуальныйПредприниматель() Тогда
		ВидОрганизацииДляПоиска = "ИП";
	ИначеЕсли ВидОрганизацииДляПодключения = ФизическоеЛицо() Тогда
		ВидОрганизацииДляПоиска = "ФЛ";
	КонецЕсли;
	
	КлючевыеРеквизиты = ИнтеграцияЭДО.НовыеКлючевыеРеквизитыУчастникаЭДО();
	КлючевыеРеквизиты.ИНН = ИНН;
	КлючевыеРеквизиты.КПП = КПП;
	Организация = ИнтеграцияЭДО.ОрганизацияПоВидуИКлючевымРеквизитам(ВидОрганизацииДляПоиска, КлючевыеРеквизиты);
	
	ЗаполнитьДанныеДляРегистрационногоПакета();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДляРегистрационногоПакета()
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ИмяРеквизитаКППОрганизации = ИнтеграцияЭДО.ИмяНаличиеОбъектаРеквизитаВПрикладномРешении("КППОрганизации");
		ПараметрыЗаполнения = Новый Структура(ИмяРеквизитаКППОрганизации);
		ЗаполнитьЗначенияСвойств(ПараметрыЗаполнения, Организация);
		
		Если ЗначениеЗаполнено(ПараметрыЗаполнения[ИмяРеквизитаКППОрганизации])
				И ПараметрыЗаполнения[ИмяРеквизитаКППОрганизации] <> КПП Тогда
			КПП = ПараметрыЗаполнения[ИмяРеквизитаКППОрганизации];
		КонецЕсли;
		
		РеквизитыОрганизации = УчетныеЗаписиЭДОСлужебный.РеквизитыОрганизацииДляРегистрационногоПакета(Организация);
		Если Не ЗначениеЗаполнено(АдресОрганизации) Тогда
			АдресОрганизации = РеквизитыОрганизации.АдресОрганизации;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗначениеПолейАдреса) Тогда
			ЗначениеПолейАдреса = РеквизитыОрганизации.ЗначениеПолейАдреса;
		КонецЕсли;
		Если ЗначениеЗаполнено(РеквизитыОрганизации.КодНалоговогоОргана) Тогда
			КодНалоговогоОргана = РеквизитыОрганизации.КодНалоговогоОргана;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьОрганизацию(ПрограммаКриптографии, Отказ = Ложь)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		
		ЕстьПравоДобавлятьОрганизацию = Ложь;
		ИмяСправочникаОрганизации = ОбщегоНазначенияБЭД.ИмяПрикладногоСправочника("Организации");
		Если ИмяСправочникаОрганизации <> Неопределено Тогда
			ЕстьПравоДобавлятьОрганизацию = ПравоДоступа("Добавление", Метаданные.Справочники[ИмяСправочникаОрганизации]);
		КонецЕсли;
		
		Если Не ЕстьПравоДобавлятьОрганизацию Тогда
			ТекстСообщения = НСтр(
			"ru='При подключении данной учетной записи потребуется создание организации.
			|Недостаточно прав для выполнения этой операции.
			|Обратитесь к администратору системы для получения необходимых прав доступа.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		ДанныеОрганизации = ОбменСКонтрагентамиКлиентСервер.НовыйДанныеОрганизации();
		ДанныеОрганизации.ИНН = ИНН;
		ДанныеОрганизации.КПП = КПП;
		ДанныеОрганизации.ОГРН = ОГРН;
		ДанныеОрганизации.Наименование = НаименованиеОрганизации;
		ДанныеОрганизации.НаименованиеСокращенное = НаименованиеОрганизации;
		ДанныеОрганизации.НаименованиеПолное = НаименованиеОрганизации;
		ДанныеОрганизации.ЮридическийАдрес = ЗначениеПолейАдреса;
		ДанныеОрганизации.ВидОрганизации = Перечисления.ВидУчетнойЗаписиЭДО.ВидОрганизацииПоВидуУчетнойЗаписи(ВидОрганизацииДляПодключения);
		
		ОбменСКонтрагентамиПереопределяемый.СоздатьОрганизациюПоРеквизитам(ДанныеОрганизации, Организация);
		
		ОрганизацияВСертификате = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сертификат, "Организация");
		Если ЗначениеЗаполнено(Сертификат)
				И Не ЗначениеЗаполнено(ОрганизацияВСертификате) Тогда
			
			ДанныеСертификата = КриптографияБЭД.ДвоичныеДанныеСертификата(Сертификат);
			Сертификат = ИнтеграцияБСПБЭДВызовСервера.НайтиСоздатьСертификатЭП(
				ДанныеСертификата, Организация, ПрограммаКриптографии);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереключитьТекущуюСтраницуНаЭтапВыбораВидаОрганизации(Форма)
	
	Форма.Элементы.СтраницаВводДанных.Видимость = Ложь;
	Форма.Элементы.СтраницаДиагностика.Видимость = Ложь;
	Форма.Элементы.СтраницаВыборВидаОрганизации.Видимость = Истина;
	Форма.Элементы.СтраницаРезультатПодключения.Видимость = Ложь;
	
	Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВыборВидаОрганизации;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереключитьТекущуюСтраницуНаЭтапРегистрации(Форма)
	
	Форма.Элементы.СтраницаВводДанных.Видимость = Ложь;
	Форма.Элементы.СтраницаДиагностика.Видимость = Ложь;
	Форма.Элементы.СтраницаРезультатПодключения.Видимость = Истина;
	
	Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаРезультатПодключения;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереключитьТекущуюСтраницуНаЭтапВводаДанных(Форма)
	
	Форма.Элементы.СтраницаВводДанных.Видимость = Истина;
	Форма.Элементы.СтраницаДиагностика.Видимость = Ложь;
	Форма.Элементы.СтраницаРезультатПодключения.Видимость = Ложь;
	
	Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВводДанных;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереключитьТекущуюСтраницуНаЭтапДиагностики(Форма)
	
	Форма.ВыполняетсяПроверкаНаличияРасширенияКриптографии = Ложь;
	
	Форма.Элементы.СтраницаВводДанных.Видимость = Ложь;
	Форма.Элементы.СтраницаДиагностика.Видимость= Истина;
	Форма.Элементы.СтраницаРезультатПодключения.Видимость = Ложь;
	
	Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаДиагностика;
	
	УстановитьВидимостьЭлементовДиагностики(Форма);
	УстановитьВидимостьЭлементовФормы(Форма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОпределитьВидПодключенияПоОрганизации(Организация, ИНН, ВидПодключения)
	
	ТипУчастникаЭДО = ИнтеграцияЭДОПовтИсп.ТипУчастникаЭДО(Организация);
	Если ТипУчастникаЭДО.ЭтоФизЛицо Тогда
		ВидПодключения = ФизическоеЛицо();
	ИначеЕсли ТипУчастникаЭДО.ЭтоЮрЛицо Тогда
		ВидПодключения = ЮридическоеЛицо();
	ИначеЕсли ТипУчастникаЭДО.ЭтоИП Тогда
		ВидПодключения = ИндивидуальныйПредприниматель();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПоУмолчанию(Параметры)
	
	Параметры.Свойство("ИспользоватьЦентрЭДО", ИспользоватьЦентрЭДО);
	Параметры.Свойство("Организация", Организация);
	
	Элементы.ПовторитьДиагностику.Видимость = Ложь;
	
	ПоддержанаРаботаСФизическимиЛицами = ИнтеграцияЭДОВызовСервера.ПоддержанаРаботаСФизическимиЛицами();
	ВидОрганизацииДляПодключения = ЮридическоеЛицо();
	
	УстанавливатьРасширение = ОбщегоНазначения.ЭтоВебКлиент() Или ОбщегоНазначения.ЭтоМобильныйКлиент();
	СоздаватьЭлектронныеПодписиНаСервере = ЭлектроннаяПодпись.СоздаватьЭлектронныеПодписиНаСервере();
	
	СозданиеУчетнойЗаписиИзСуществующейОрганизации = ЗначениеЗаполнено(Организация);
	ВидОрганизацииВыбран = СозданиеУчетнойЗаписиИзСуществующейОрганизации;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		СтруктураДанныхОрганизации = ИнтеграцияЭДО.НоваяСтруктураДанныхОрганизации();
		ОбменСКонтрагентамиПереопределяемый.ЗаполнитьРегистрационныеДанныеОрганизации(Организация, СтруктураДанныхОрганизации);
		НаименованиеОрганизации = СтруктураДанныхОрганизации.Наименование;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, СтруктураДанныхОрганизации);
		
		ИзвлечьКодНалоговогоОрганаИзИНН(КодНалоговогоОргана, ИНН);
		
		Если СозданиеУчетнойЗаписиИзСуществующейОрганизации Тогда
			ОпределитьВидПодключенияПоОрганизации(Организация, ИНН, ВидОрганизацииДляПодключения);
		КонецЕсли;
		
		СформироватьТекстПодвала(ЭтотОбъект);
		
	КонецЕсли;
	ЗаполнитьДанныеДляРегистрационногоПакета();
	
	ВыполняетсяПроверкаКриптографии = Истина;
	ВидПодключения = ВидыПодключения().Новый;
	ИспользоватьАвтоматическоеПолучениеЭДО = АвтоматическоеПолучениеЭДО.Использовать();
	
	ЗаполнитьПодключенныхОператоровЭДО();
	
	Если ИспользоватьЦентрЭДО Тогда
		ОбщийМодульИнтеграцияЦентраЭДО = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияЦентраЭДО");
		УчетнаяЗаписьЦентраЭДО = ОбщийМодульИнтеграцияЦентраЭДО.ЕдинственнаяУчетнаяЗаписьЦентраЭДО();
		Если Не ЗначениеЗаполнено(УчетнаяЗаписьЦентраЭДО) Тогда
			ТекущийЭлемент = Элементы.УчетнаяЗаписьЦентраЭДО;
		КонецЕсли;
	КонецЕсли;
	
	ТребоватьПриглашенияПередНачаломЭДО =
		УчетныеЗаписиЭДОКлиентСервер.ТребоватьПриглашенияПередНачаломЭДОЗначениеПоУмолчанию();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановкаСостоянияПолученияИдентификатораЭД(
		ОтправкаЗаявления, ОжиданиеОтвета = Неопределено, СозданиеУчетнойЗаписи = Неопределено)
	
	Элементы.ГруппаЗаявлениеВыполнение.Видимость = ОтправкаЗаявления = Ложь;
	Элементы.ГруппаЗаявлениеВыполнено.Видимость = ОтправкаЗаявления = Истина;
	Элементы.ГруппаЗаявлениеОшибка.Видимость = ОтправкаЗаявления = СостоянияПодключения().Ошибка;
	
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаЗаявлениеВыполнение, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаЗаявлениеВыполнено, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаЗаявлениеОшибка, Элементы.СтраницаРезультатПодключения);
	
	Элементы.ГруппаОжиданияОтветаОжидание.Видимость = ОжиданиеОтвета = Неопределено;
	Элементы.ГруппаОжиданияОтветаВыполнение.Видимость = ОжиданиеОтвета = Ложь;
	Элементы.ГруппаОжиданияОтветаВыполнено.Видимость = ОжиданиеОтвета = Истина;
	Элементы.ГруппаОжиданияОтветаОшибка.Видимость = ОжиданиеОтвета = СостоянияПодключения().Ошибка;
	
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаОжиданияОтветаОжидание, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаОжиданияОтветаВыполнение, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаОжиданияОтветаВыполнено, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаОжиданияОтветаОшибка, Элементы.СтраницаРезультатПодключения);
	
	Элементы.ГруппаСозданиеУчетнойЗаписиЭДООжидание.Видимость = СозданиеУчетнойЗаписи = Неопределено;
	Элементы.ГруппаСозданиеУчетнойЗаписиЭДОВыполнение.Видимость = СозданиеУчетнойЗаписи = Ложь;
	Элементы.ГруппаСозданиеУчетнойЗаписиЭДОВыполнено.Видимость = СозданиеУчетнойЗаписи = Истина;
	Элементы.ГруппаСозданиеУчетнойЗаписиЭДООшибка.Видимость = СозданиеУчетнойЗаписи = СостоянияПодключения().Ошибка;
	
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаСозданиеУчетнойЗаписиЭДООжидание, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаСозданиеУчетнойЗаписиЭДОВыполнение, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаСозданиеУчетнойЗаписиЭДОВыполнено, Элементы.СтраницаРезультатПодключения);
	УстановитьТекущийЭлементПоВидимостиГрупп(ЭтотОбъект, Элементы.ГруппаСозданиеУчетнойЗаписиЭДООшибка, Элементы.СтраницаРезультатПодключения);
	
	Если ОтправкаЗаявления = СостоянияПодключения().Ошибка
		Или ОжиданиеОтвета = СостоянияПодключения().Ошибка
		Или СозданиеУчетнойЗаписи = СостоянияПодключения().Ошибка Тогда
			ВыполняетсяРегистрация = Ложь;
	КонецЕсли;
	
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьВидаПодключения(Форма)
	
	Форма.Элементы.ГруппаИдентификаторЭДО.Видимость = Форма.ВидПодключения = ВидыПодключения().Существующий;
	Форма.Элементы.ОператорЭДО.Доступность = Не Форма.Элементы.ГруппаИдентификаторЭДО.Видимость;
	Форма.Элементы.ДекорацияСертификатОтступ.Видимость = Не Форма.Элементы.ГруппаИдентификаторЭДО.Видимость;
	
	Форма.Элементы.ГруппаРаботаБезПриглашений.Видимость = 
		Форма.ОператорПоддерживаетНастройкуТребованияПриглашений И Не Форма.ИспользоватьЦентрЭДО;
		
	Форма.Элементы.ГруппаКодыДокументов.Видимость = Форма.ОператорПоддерживаетНастройкуТребованияПриглашений
		И Не Форма.ИспользоватьЦентрЭДО;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовДиагностики(Форма)
	
	Форма.Элементы.ПовторитьДиагностику.Видимость = 
		Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаДиагностика
		И (Форма.ВыполняетсяПроверкаКриптографии
			Или Форма.ПроверкаКриптографииПровалена
			Или Форма.ВыполняетсяПроверкаНаличияСертификатов
			Или Форма.ПроверкаНаличияСертификатовПровалена
			Или Форма.ТребуетсяУстановкаРасширенияКриптографии);
	Форма.Элементы.ПовторитьДиагностику.КнопкаПоУмолчанию = Форма.Элементы.ПовторитьДиагностику.Видимость;
	
	Форма.Элементы.ГруппаПроверкиНаличияРасширения.Видимость = Форма.УстанавливатьРасширение;
	
	Форма.Элементы.ГруппаВыполнениеПроверкиНаличияРасширения.Видимость =
		Форма.ВыполняетсяПроверкаНаличияРасширенияКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаВыполнениеПроверкиНаличияРасширения, Форма.Элементы.СтраницаДиагностика);
	Форма.Элементы.ГруппаРезультатПроверкиРасширенияНеУспешно.Видимость =
		Форма.ТребуетсяУстановкаРасширенияКриптографии
		И Не Форма.ВыполняетсяПроверкаНаличияРасширенияКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаРезультатПроверкиРасширенияНеУспешно, Форма.Элементы.СтраницаДиагностика);
	Форма.Элементы.ГруппаРезультатПроверкиРасширенияУспешно.Видимость =
		Не Форма.ТребуетсяУстановкаРасширенияКриптографии
		И Не Форма.ВыполняетсяПроверкаНаличияРасширенияКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаРезультатПроверкиРасширенияУспешно, Форма.Элементы.СтраницаДиагностика);
	
	Форма.Элементы.ГруппаВыполнениеПроверкиКриптографии.Видимость =
		Форма.ВыполняетсяПроверкаКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаВыполнениеПроверкиКриптографии, Форма.Элементы.СтраницаДиагностика);
	Форма.Элементы.ГруппаРезультатПроверкиКриптографииНеУспешно.Видимость =
		Форма.ПроверкаКриптографииПровалена
		И Не Форма.ВыполняетсяПроверкаКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаРезультатПроверкиКриптографииНеУспешно, Форма.Элементы.СтраницаДиагностика);
	Форма.Элементы.ГруппаРезультатПроверкиКриптографииУспешно.Видимость =
		Не Форма.ПроверкаКриптографииПровалена
		И Не Форма.ВыполняетсяПроверкаКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаРезультатПроверкиКриптографииУспешно, Форма.Элементы.СтраницаДиагностика);
	
	Форма.Элементы.ГруппаВыполнениеПроверкиНаличияСертификатов.Видимость =
		Форма.ВыполняетсяПроверкаНаличияСертификатов
		Или Форма.ВыполняетсяПроверкаКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаВыполнениеПроверкиНаличияСертификатов, Форма.Элементы.СтраницаДиагностика);
	Форма.Элементы.ГруппаРезультатПроверкиНаличияСертификатовНеУспешно.Видимость =
		(Форма.ПроверкаНаличияСертификатовПровалена
			Или Форма.ПроверкаКриптографииПровалена)
		И Не Форма.ВыполняетсяПроверкаНаличияСертификатов
		И Не Форма.ВыполняетсяПроверкаКриптографии;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаРезультатПроверкиНаличияСертификатовНеУспешно, Форма.Элементы.СтраницаДиагностика);
	Форма.Элементы.ГруппаРезультатПроверкиНаличияСертификатовУспешно.Видимость =
		Не Форма.ПроверкаНаличияСертификатовПровалена
		И Не Форма.ВыполняетсяПроверкаНаличияСертификатов
		И Не Форма.ВыполняетсяПроверкаКриптографии
		И Не Форма.ПроверкаКриптографииПровалена;
	УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Форма.Элементы.ГруппаРезультатПроверкиНаличияСертификатовУспешно, Форма.Элементы.СтраницаДиагностика);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтображениеЗарегистрироватьЭДОКартинкаИТекст(Форма)
	
	Форма.Элементы.ЗарегистрироватьЭДО.Отображение = ОтображениеКнопки.КартинкаИТекст;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтображениеЗарегистрироватьЭДОТекст(Форма)
	
	Форма.Элементы.ЗарегистрироватьЭДО.Отображение = ОтображениеКнопки.Текст;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	Форма.Элементы.ГруппаСостояниеВыполнения.Видимость = Не Форма.РегистрацияВыполнена;
	Форма.Элементы.ГруппаШапкаИнформации.Видимость = Форма.РегистрацияВыполнена;
	
	Если ЗначениеЗаполнено(Форма.ИдентификаторОператораЭДО) Тогда
		Форма.ПредставлениеОператораЭДО =
			Форма.Элементы.ОператорЭДО.СписокВыбора.НайтиПоЗначению(Форма.ИдентификаторОператораЭДО).Представление;
	КонецЕсли;
	
	Форма.Элементы.ГруппаЗаголовокКПП.Видимость = Форма.ВидОрганизацииДляПодключения = ЮридическоеЛицо()
		И Не Форма.СозданиеУчетнойЗаписиИзСуществующейОрганизации;
	Форма.Элементы.ГруппаКодНалоговогоОргана.Видимость = Не ПоддержанаРегистрацияЧерезФормат_5_03(Форма);
	Форма.Элементы.ГруппаАдресОрганизации.Видимость = Не ПоддержанаРегистрацияЧерезФормат_5_03(Форма);
	
	ДляЮрЛицаВыбранСертификатНеЮрЛица = Форма.ВидОрганизацииДляПодключения = ЮридическоеЛицо()
		И (Форма.ВыбранСертификатФизЛица
			Или Форма.ВыбранСертификатИП);
	ДляИпВыбранСертификатНеИп = Форма.ВидОрганизацииДляПодключения = ИндивидуальныйПредприниматель()
		И Не Форма.ВыбранСертификатИП;
	
	Форма.Элементы.ГруппаЗаголовокИНН.Видимость =
		Не Форма.СозданиеУчетнойЗаписиИзСуществующейОрганизации
		И Форма.ИдентификаторОператораЭДО = СервисНастроекЭДОКлиентСервер.ИдентификаторТакскома()
		И (ДляЮрЛицаВыбранСертификатНеЮрЛица
			Или ДляИпВыбранСертификатНеИп);
	
	Форма.Элементы.ГруппаЗаголовокОГРН.Видимость = Форма.Элементы.ГруппаЗаголовокИНН.Видимость;
	Форма.Элементы.ГруппаЗаголовокНаименование.Видимость = Форма.Элементы.ГруппаЗаголовокИНН.Видимость;
	Форма.Элементы.ДекорацияЗаголовокОГРН.Заголовок = ?(Форма.ВидОрганизацииДляПодключения = ЮридическоеЛицо(), "ОГРН:","ОГРНИП:");
	
	Форма.Элементы.ГруппаЗаголовокДоверенность.Видимость = Не Форма.ВидОрганизацииДляПодключения = ФизическоеЛицо()
		И Не Форма.ИдентификаторОператораЭДО = СервисНастроекЭДОКлиентСервер.ИдентификаторТакскома();
	Форма.Элементы.Доверенность.АвтоОтметкаНезаполненного = Форма.ДоверенностьОбязательна;
	Если Форма.СозданиеУчетнойЗаписиИзСуществующейОрганизации Тогда
		Форма.Элементы.ГруппаЗаголовокДоверенность.Видимость = Форма.ДоверенностьОбязательна;
	КонецЕсли;
	
	Форма.Элементы.ЗарегистрироватьЭДО.Видимость =
		Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВводДанных
		И Не Форма.РегистрацияВыполнена
		И Не Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВыборВидаОрганизации;
	Форма.Элементы.ЗарегистрироватьЭДО.КнопкаПоУмолчанию = Форма.Элементы.ЗарегистрироватьЭДО.Видимость;
	
	Форма.Элементы.Далее.Видимость =
		Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВыборВидаОрганизации;
	Форма.Элементы.Далее.КнопкаПоУмолчанию = Форма.Элементы.Далее.Видимость;
	
	Форма.Элементы.Назад.Видимость =
		Не Форма.ВыполняетсяРегистрация
		И Не Форма.РегистрацияВыполнена
		И Не Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаДиагностика
		И Не Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВыборВидаОрганизации;
	
	Если Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВводДанных
			И Форма.Элементы.Назад.Видимость Тогда
		Форма.Элементы.Назад.Видимость = Не Форма.СозданиеУчетнойЗаписиИзСуществующейОрганизации
			И Форма.ПоддержанаРаботаСФизическимиЛицами
	КонецЕсли;
	
	Форма.Элементы.Закрыть.Видимость =
		Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаРезультатПодключения
		И Форма.РегистрацияВыполнена;
	Форма.Элементы.Закрыть.КнопкаПоУмолчанию = Форма.Элементы.Закрыть.Видимость;
	
	Форма.Элементы.ГруппаУсловияИспользования.Видимость =
		Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВводДанных;
	
	Форма.Элементы.ГруппаПодвалИнформации.Видимость =
		Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаВводДанных
		Или Форма.Элементы.Страницы.ТекущаяСтраница = Форма.Элементы.СтраницаРезультатПодключения;
	
	Форма.Элементы.ГруппаЗаголовокУчетнаяЗаписьЦентраЭДО.Видимость = Форма.ИспользоватьЦентрЭДО;
	
	Форма.Элементы.ГруппаРаботаБезПриглашений.Видимость = 
		Форма.ОператорПоддерживаетНастройкуТребованияПриглашений И Не Форма.ИспользоватьЦентрЭДО;
		
	Форма.Элементы.ГруппаКодыДокументов.Видимость = 
		Форма.ОператорПоддерживаетНастройкуТребованияПриглашений И Не Форма.ИспользоватьЦентрЭДО;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекущийЭлементПоВидимостиГрупп(Форма, Группа, ТекущаяСтраница)
	
	Если Форма.Элементы.Страницы.ТекущаяСтраница = ТекущаяСтраница
		И Группа.Видимость Тогда
		Форма.ТекущийЭлемент = Группа;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ОткрытьФормуОжидания(ТекстСообщенияОжидания, МетодОбработкиРезультата)
	
	ПараметрыОжиданияБЭД = ОжиданиеОперацийБЭДКлиент.НовыеПараметры();
	ПараметрыОжиданияБЭД.ТекстСообщения = ТекстСообщенияОжидания;
	
	КонтекстОжиданияОперации = ОжиданиеОперацийБЭДКлиент.НовыйКонтекст(ПараметрыОжиданияБЭД);
	ОжиданиеОперацийБЭДКлиент.ОткрытьФормуОжидания(ЭтотОбъект, КонтекстОжиданияОперации);
	
	ОписаниеОповещения = Новый ОписаниеОповещения(МетодОбработкиРезультата, ЭтотОбъект, КонтекстОжиданияОперации);
	
	Возврат ОписаниеОповещения;
	
КонецФункции

&НаКлиенте
Процедура ЗапуститьОжиданиеВыполненияДлительнойОперации(Оповещение, ДлительнаяОперация, ТекстСообщенияОжидания)
	
	Если ДлительнаяОперация = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Процедура СведенияПоРуководителю()
	
	Руководитель = "";
	СвойстваСубъекта = КриптографияБЭД.СвойстваСубъектаСертификатаПоСсылке(Сертификат);
	
	Если Не СозданиеУчетнойЗаписиИзСуществующейОрганизации Тогда
		Если ВидОрганизацииДляПодключения = ЮридическоеЛицо()
				И (ВыбранСертификатФизЛица
					Или ВыбранСертификатИП) Тогда
			Возврат;
		КонецЕсли;
		Если ВидОрганизацииДляПодключения = ИндивидуальныйПредприниматель()
				И Не ВыбранСертификатИП Тогда
			Возврат;
		КонецЕсли;
		Если ВидОрганизацииДляПодключения = ФизическоеЛицо()
				И Не ВыбранСертификатФизЛица Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если (СозданиеУчетнойЗаписиИзСуществующейОрганизации
				Или ЗначениеЗаполнено(Доверенность))
			И ЗначениеЗаполнено(ИНН)
			И Не (СвойстваСубъекта.ИНН = ИНН
					Или СвойстваСубъекта.ИННЮЛ = ИНН) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОрганизации = ИнтеграцияЭДО.РегистрационныеДанныеОрганизации(Организация);
	Если ЗначениеЗаполнено(ДанныеОрганизации.Фамилия)
			И ЗначениеЗаполнено(ДанныеОрганизации.Имя) Тогда
		Руководитель = СтрШаблон("%1 %2",
			ДанныеОрганизации.Фамилия,
			ДанныеОрганизации.Имя);
	ИначеЕсли ВыбранСертификатФизЛица Тогда
		Руководитель = СтрШаблон("%1 %2",
			СвойстваСубъекта.Фамилия,
			СвойстваСубъекта.Имя);
	Иначе
		ЗначенияРеквизитов = ИнтеграцияБСПБЭД.ЗначенияРеквизитовСертификатаПоФамилииИмениДолжности(Сертификат);
		Если ЗначениеЗаполнено(ЗначенияРеквизитов.Должность) Тогда
			Руководитель = СтрШаблон("%1 %2, %3",
				ЗначенияРеквизитов.Фамилия,
				ЗначенияРеквизитов.Имя,
				ЗначенияРеквизитов.Должность);
		Иначе
			Руководитель = СтрШаблон("%1 %2",
				ЗначенияРеквизитов.Фамилия,
				ЗначенияРеквизитов.Имя);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СостоянияПодключения()
	
	СостоянияПодключения = Новый Структура();
	СостоянияПодключения.Вставить("Выполнено", "Выполнено");
	СостоянияПодключения.Вставить("Завершить", "Завершить");
	СостоянияПодключения.Вставить("Ошибка", "Ошибка");
	
	Возврат СостоянияПодключения;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВидыПодключения()
	
	ВидыПодключения = Новый Структура();
	ВидыПодключения.Вставить("Новый", "Новый");
	ВидыПодключения.Вставить("Существующий", "Существующий");
	
	Возврат ВидыПодключения;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ФизическоеЛицо()
	
	Возврат ПредопределенноеЗначение("Перечисление.ВидУчетнойЗаписиЭДО.ФизическоеЛицо");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИндивидуальныйПредприниматель()
	
	Возврат ПредопределенноеЗначение("Перечисление.ВидУчетнойЗаписиЭДО.ИндивидуальныйПредприниматель");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЮридическоеЛицо()
	
	Возврат ПредопределенноеЗначение("Перечисление.ВидУчетнойЗаписиЭДО.ЮридическоеЛицо");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстОжиданияПоискаИдентификаторов()
	
	Возврат НСтр("ru='Выполняется получение идентификаторов ЭДО.'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстОжиданияПоискаСведенийПоОрганизации()
	
	Возврат НСтр("ru='Выполняется получение сведений по организации.'");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ТекстОжиданияПоискаИдентификаторовИСведенийПоОрганизации()
	
	Возврат НСтр("ru='Выполняется получение идентификаторов ЭДО и сведений по организации.'");
	
КонецФункции

&НаКлиенте
Асинх Процедура ПоказатьСписокВыбораИдентификаторов()
	
	Если Элементы.ИдентификаторЭДО.СписокВыбора.Количество() > 1
		И ВидПодключения = ВидыПодключения().Существующий Тогда
		Элементы.ИдентификаторЭДО.КнопкаВыпадающегоСписка = Истина;
		
		ТекущийЭлемент = Элементы.ИдентификаторЭДО;
		Обещание = ВыбратьИзСпискаАсинх(Элементы.ИдентификаторЭДО.СписокВыбора);
		Результат = Ждать Обещание;
		Если Результат <> Неопределено Тогда
			ИдентификаторЭДО = Результат.Значение;
			ПолучитьСпособОбменаПоИдентификатору();
			ПроверитьНеобходимостьДоверенности();
			УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
		КонецЕсли;
	Иначе
		Элементы.ИдентификаторЭДО.КнопкаВыпадающегоСписка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПоискИдентификаторовОрганизации()
	
	Если ВидПодключения = ВидыПодключения().Существующий
			И ЗначениеЗаполнено(ИНН)
			И НеобходимПоискИдентификаторов Тогда
		ЗапуститьОбновлениеКешОператоровИФорматов();
		ЗапуститьОжиданиеОбновленияКешОператоровИФорматов(ТекстОжиданияПоискаИдентификаторов());
	Иначе
		ПоказатьСписокВыбораИдентификаторов();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораОтпечаткаСертификата()
	
	СертификатНаСервере = СписокСертификатов.НайтиСтроки(Новый Структура("Отпечаток", ОтпечатокСертификата))[0].НаСервере;
	
	Если ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
		
		ПараметрыОжиданияБЭД = ОжиданиеОперацийБЭДКлиент.НовыеПараметры();
		ПараметрыОжиданияБЭД.ТекстСообщения = НСтр("ru = 'Идет загрузка сведений о выбранном сертификате.
		|Пожалуйста, подождите…'");
		
		КонтекстОжиданияОперации = ОжиданиеОперацийБЭДКлиент.НовыйКонтекст(ПараметрыОжиданияБЭД);
		ОжиданиеОперацийБЭДКлиент.ОткрытьФормуОжидания(ЭтотОбъект, КонтекстОжиданияОперации);
		
		Если Не СертификатНаСервере Тогда
			ОписаниеОповещения = Новый ОписаниеОповещения("СертификатПриИзмененииПослеПолученияСертификата", ЭтотОбъект, КонтекстОжиданияОперации);
			ЭлектроннаяПодписьКлиент.ПолучитьСертификатПоОтпечатку(ОписаниеОповещения, ОтпечатокСертификата, Ложь);
		Иначе
			ПолучитьСертификатНаСервере();
			ПослеПоискаСертификата(Сертификат, КонтекстОжиданияОперации);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТребованиеПриглашенияПоДаннымАбонента()
	
	Если Не ОператорПоддерживаетНастройкуТребованияПриглашений Или ИспользоватьЦентрЭДО Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидПодключения = ВидыПодключения().Новый Тогда
		ТребоватьПриглашенияПередНачаломЭДО =
			УчетныеЗаписиЭДОКлиентСервер.ТребоватьПриглашенияПередНачаломЭДОЗначениеПоУмолчанию();
		Возврат;
	КонецЕсли;
	
	Если АбонентыИТребованияПриглашений = Неопределено Тогда
		ТребоватьПриглашенияПередНачаломЭДО = 
			Не РаботаСАбонентамиЭДОВызовСервера.АбонентНеТребуетПриглашений(ИдентификаторЭДО);
		Возврат;
	КонецЕсли;
	
	Если АбонентыИТребованияПриглашений.Получить(ИдентификаторЭДО) = Неопределено Тогда
		ТребоватьПриглашенияПередНачаломЭДО = 
			Не РаботаСАбонентамиЭДОВызовСервера.АбонентНеТребуетПриглашений(ИдентификаторЭДО);
		Возврат;
	КонецЕсли;
	
	ТребоватьПриглашенияПередНачаломЭДО = Не АбонентыИТребованияПриглашений[ИдентификаторЭДО];
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПредставлениеПоддерживаемыхТиповДокументов()
	
	МассивНаименований = Новый Массив;
	
	Для Каждого СтрокаКода Из КодыТиповДокументов Цикл
		
		Если СтрокаКода.Используется Тогда
			МассивНаименований.Добавить(СтрокаКода.Наименование);
		КонецЕсли;
		
	КонецЦикла;
	
	ТипыДокументовВыбраны = Не МассивНаименований.Количество() = 0;
	НаименованиеТиповДокументов = ?(ТипыДокументовВыбраны, СтрСоединить(МассивНаименований, ", "),
		НСтр("ru = 'Не выбраны'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборТиповДокументов(ЗначенияЭлементов, ДополнительныеПараметры) Экспорт

	Если ЗначенияЭлементов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаКода Из КодыТиповДокументов Цикл
		СтрокаКода.Используется = ЗначенияЭлементов.НайтиПоЗначению(СтрокаКода.Код).Пометка;
	КонецЦикла;
	
	ЗаполнитьПредставлениеПоддерживаемыхТиповДокументов();
	
КонецПроцедуры

