&НаКлиенте
Функция КлючевыеПоляДляРегистрацииЗаполнены()
	
	ЕстьОшибки = Ложь;
	
	Если ВидОрганизацииДляПодключения = ЮридическоеЛицо()
			И СтрДлина(КПП) <> 9 Тогда
		Элементы.ГруппаЗаголовокКПП.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='КПП организации должен состоять из 9 цифр'"), , ,
			"КПП", ЕстьОшибки);
	КонецЕсли;
	
	Если ИдентификаторОператораЭДО = СервисНастроекЭДОКлиентСервер.ИдентификаторТакскома()
			И (ВидОрганизацииДляПодключения = ЮридическоеЛицо()
				Или ВидОрганизацииДляПодключения = ИндивидуальныйПредприниматель())
			И Не ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
		Элементы.ГруппаЗаголовокНаименование.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Наименование организации организации должно быть заполнено'"), , ,
			"НаименованиеОрганизации", ЕстьОшибки);
	КонецЕсли;
	
	Если ИдентификаторОператораЭДО = СервисНастроекЭДОКлиентСервер.ИдентификаторТакскома()
			И ВидОрганизацииДляПодключения = ЮридическоеЛицо()
			И СтрДлина(ИНН) <> 10 Тогда
		Элементы.ГруппаЗаголовокИНН.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='ИНН организации должен состоять из 10 цифр'"), , ,
			"ИНН", ЕстьОшибки);
	КонецЕсли;
	
	Если ИдентификаторОператораЭДО = СервисНастроекЭДОКлиентСервер.ИдентификаторТакскома()
			И ВидОрганизацииДляПодключения = ИндивидуальныйПредприниматель()
			И СтрДлина(ИНН) <> 12 Тогда
		Элементы.ГруппаЗаголовокИНН.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='ИНН организации должен состоять из 12 цифр'"), , ,
			"ИНН", ЕстьОшибки);
	КонецЕсли;
	
	Если ВидОрганизацииДляПодключения = ЮридическоеЛицо()
			И СтрДлина(ОГРН) <> 13 Тогда
		Элементы.ГруппаЗаголовокОГРН.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='ОГРН организации должен состоять из 13 цифр'"), , ,
			"ОГРН", ЕстьОшибки);
	КонецЕсли;
	
	Если ВидОрганизацииДляПодключения = ИндивидуальныйПредприниматель()
			И СтрДлина(ОГРН) <> 15 Тогда
		Элементы.ГруппаЗаголовокОГРН.Видимость = Истина;
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='ОГРНИП организации должен состоять из 15 цифр'"), , ,
			"ОГРН", ЕстьОшибки);
	КонецЕсли;
	
	ЕстьИдентификаторУчетнойЗаписи = ВидПодключения = ВидыПодключения().Новый
		Или ЗначениеЗаполнено(ИдентификаторЭДО);
	Если Не ЕстьИдентификаторУчетнойЗаписи Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не заполнен идентификатор ЭДО'"), , ,
			"ИдентификаторЭДО", ЕстьОшибки);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ОтпечатокСертификата) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не заполнен сертификат'"), , ,
		"ОтпечатокСертификата", ЕстьОшибки);
	КонецЕсли;
	
	Если ИспользоватьЦентрЭДО
			И Не ЗначениеЗаполнено(УчетнаяЗаписьЦентраЭДО) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена учетная запись Центра ЭДО'"), , ,
			"УчетнаяЗаписьЦентраЭДО", ЕстьОшибки);
	КонецЕсли;
	
	Если ДоверенностьОбязательна
			И Не ЗначениеЗаполнено(Доверенность)
			И Не ИдентификаторОператораЭДО = СервисНастроекЭДОКлиентСервер.ИдентификаторТакскома() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена доверенность'"), , ,
			"Доверенность", ЕстьОшибки);
	КонецЕсли;
	
	Если Элементы.ГруппаАдресОрганизации.Видимость
			И Не ЗначениеЗаполнено(АдресОрганизации)
			И Не ВидОрганизацииДляПодключения = ФизическоеЛицо() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнен адрес организации'"), , ,
			"АдресОрганизации", ЕстьОшибки);
	КонецЕсли;
	
	Если Элементы.ГруппаКодНалоговогоОргана.Видимость
			И (Не ЗначениеЗаполнено(СтроковыеФункцииКлиентСервер.СтрокаВЧисло(КодНалоговогоОргана))
				Или СтрДлина(СокрЛП(КодНалоговогоОргана)) <> 4) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Код налогового органа должен состоять из 4 цифр'"), , ,
			"КодНалоговогоОргана", ЕстьОшибки);
	КонецЕсли;
	
	Если Не СоглашаюсьСУсловиямиИспользования Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Согласитесь с условиями использования'"), , ,
			"СоглашаюсьСУсловиямиИспользования", ЕстьОшибки);
	КонецЕсли;
	
	МинимальнаяДлина = УчетныеЗаписиЭДОКлиентСервер.МинимальнаяДопустимаяДлинаНазначенияУчетнойЗаписи();
	ДлинаНазначения = СтрДлина(СокрЛП(НазначениеУчетнойЗаписи));
	
	Если ДлинаНазначения = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Не заполнено назначение учетной записи'"), , "НазначениеУчетнойЗаписи", , ЕстьОшибки);
	ИначеЕсли ДлинаНазначения < МинимальнаяДлина Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			СтрШаблон(НСтр("ru = 'Длина назначения должна быть не менее %1 символов'"), МинимальнаяДлина), ,
			"Запись.НазначениеУчетнойЗаписи", , ЕстьОшибки);
	КонецЕсли;
	
	Если КодыТиповДокументов.НайтиСтроки(Новый Структура("Используется", Истина)).Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран ни один документ для обмена'"),,,
			"НаименованиеТиповДокументов", ЕстьОшибки);
	КонецЕсли;
		
	Возврат Не ЕстьОшибки;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьПолеПароля()
	
	Элементы.Пароль.РежимПароля = Не Элементы.Пароль.РежимПароля;
	Если Элементы.Пароль.РежимПароля Тогда
		Элементы.Пароль.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыВидны;
	Иначе
		Элементы.Пароль.КартинкаКнопкиВыбора = БиблиотекаКартинок.ВводимыеСимволыСкрыты;
	КонецЕсли;
	
	СкрытьКоличествоСимволовУПароля();
	
КонецПроцедуры

&НаКлиенте
Процедура СкрытьКоличествоСимволовУПароля()
	
	Если ЗначениеЗаполнено(Пароль) И Элементы.Пароль.РежимПароля Тогда
		Пароль = СкрытыйПароль();
	Иначе
		Пароль = СвойстваПароля.Пароль;
	КонецЕсли;
	
КонецПроцедуры

