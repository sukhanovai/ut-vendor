// Возвращает коды поддерживаемых типов документов
// 
// Возвращаемое значение:
//  ТаблицаЗначений - Получить коды поддерживаемых типов документов:
// * Используется - Булево - Тип используется по умолчанию
// * Наименование - Строка - Название типа
// * Код - Строка - Код типа
//
Функция КодыПоддерживаемыхТиповДокументов() Экспорт
	
	ТаблицаКодов = Новый ТаблицаЗначений();
	ТаблицаКодов.Колонки.Добавить("Используется", Новый ОписаниеТипов("Булево"));
	ТаблицаКодов.Колонки.Добавить("Наименование", ОбщегоНазначения.ОписаниеТипаСтрока(20));
	ТаблицаКодов.Колонки.Добавить("Код", ОбщегоНазначения.ОписаниеТипаСтрока(4));
	
	НоваяСтрока = ТаблицаКодов.Добавить();
	НоваяСтрока.Используется = Истина;
	НоваяСтрока.Наименование = Нстр("ru='Общеотраслевые'");
	НоваяСтрока.Код = "1000";
	
	НоваяСтрока = ТаблицаКодов.Добавить();
	НоваяСтрока.Используется = Истина;
	НоваяСтрока.Наименование = Нстр("ru='ЭПД'");
	НоваяСтрока.Код = "2000";
	
	НоваяСтрока = ТаблицаКодов.Добавить();
	НоваяСтрока.Наименование = Нстр("ru='Трансграничные'");
	НоваяСтрока.Код = "4000";
	
	Возврат ТаблицаКодов;
	
КонецФункции

// Получить представление о поддерживаемых типах документов.
// 
// Параметры:
//  КодыТипов - Строка, Массив из Строка - Коды типов документов
//  ТаблицаКодовТипов - см. КодыПоддерживаемыхТиповДокументов
// 
// Возвращаемое значение:
//  Строка - Описание поддерживаемых типов документов
//
Функция ПредставлениеПоддерживаемыхТиповДокументов(КодыТипов, ТаблицаКодовТипов = Неопределено) Экспорт
	
	Результат = "";
	
	Если Не ЗначениеЗаполнено(КодыТипов) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ТаблицаДанных = ?(ТаблицаКодовТипов = Неопределено, КодыПоддерживаемыхТиповДокументов(), ТаблицаКодовТипов);
	КодыТиповДокументов = ?(ТипЗнч(КодыТипов) = Тип("Массив"), КодыТипов, ОбщегоНазначения.JSONВЗначение(КодыТипов));
	
	ПредставленияДокументов = Новый Массив;
	
	Для Каждого КодТипа Из КодыТиповДокументов Цикл
			
		НайденнаяСтрока = ТаблицаДанных.Найти(КодТипа, "Код");
		Если Не НайденнаяСтрока = Неопределено Тогда
			ПредставленияДокументов.Добавить(НайденнаяСтрока.Наименование);
		КонецЕсли;
			
	КонецЦикла;
	
	Результат = ?(ПредставленияДокументов.Количество() = 0, Результат, СтрСоединить(ПредставленияДокументов, ", "));
	
	Возврат Результат;
	
КонецФункции

