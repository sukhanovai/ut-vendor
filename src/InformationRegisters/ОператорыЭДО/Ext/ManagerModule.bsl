// Возвращает информацию об операторе ЭДО по учетной записи ЭДО, указанной в параметре
//
// Параметры:
//   УчетнаяЗапись - Строка - идентификатор учетной записи ЭДО для поиска оператора ЭДО
//
// Возвращаемое значение:
//   Неопределено, Структура - данные оператора ЭДО с полями:
//     * ИдентификаторОператора - Строка - уникальный идентификатор оператора
//     * Представление - Строка - наименование оператора
//     * ИНН - Строка - ИНН оператора
//     * КПП - Строка - КПП оператора
//     * ОГРН - Строка - ОГРН оператора
//     * СпособОбменаЭД - ПеречислениеСсылка.СпособыОбменаЭД
//     * ОтпечатокСертификата - Строка - отпечаток сертификата оператора
//     * ДоступноПодключениеЧерез1С - Булево - флаг доступности подключения через сервисы 1С
//     * ОтправлятьДополнительныеСведения - Булево - флаг отправки дополнительных сведений
//     * СсылкаНаСтраницуТехническойПоддержки - Строка - ссылка на страницу технической поддержки оператора
Функция ИнформацияОбОператореЭДОУчетнойЗаписи(УчетнаяЗапись) Экспорт
	
	ТаблицаОператоровЭДО = ТаблицаОператоровЭДО();
	ОператорЭДО = Неопределено;
	
	Для Каждого Оператор Из ТаблицаОператоровЭДО Цикл
		
		Если Лев(ВРег(УчетнаяЗапись), СтрДлина(Оператор.ИдентификаторОператора)) = ВРег(Оператор.ИдентификаторОператора) Тогда
			ОператорЭДО = Оператор.ИдентификаторОператора;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(ОператорЭДО) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОператорыЭДО.ИдентификаторОператора КАК ИдентификаторОператора,
		|	ОператорыЭДО.Представление КАК Представление,
		|	ОператорыЭДО.ИНН КАК ИНН,
		|	ОператорыЭДО.КПП КАК КПП,
		|	ОператорыЭДО.ОГРН КАК ОГРН,
		|	ОператорыЭДО.СпособОбменаЭД КАК СпособОбменаЭД,
		|	ОператорыЭДО.ОтпечатокСертификата КАК ОтпечатокСертификата,
		|	ОператорыЭДО.ДоступноПодключениеЧерез1С КАК ДоступноПодключениеЧерез1С,
		|	ОператорыЭДО.ОтправлятьДополнительныеСведения КАК ОтправлятьДополнительныеСведения,
		|	ОператорыЭДО.СсылкаНаСтраницуТехническойПоддержки КАК СсылкаНаСтраницуТехническойПоддержки
		|ИЗ
		|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
		|ГДЕ
		|	ОператорыЭДО.ИдентификаторОператора = &ОператорЭДО";
	
	Запрос.УстановитьПараметр("ОператорЭДО", ОператорЭДО);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаДанныхОбОператореЭДО = РезультатЗапроса.Выгрузить();
	
	Результат = Неопределено;
	
	Если ТаблицаДанныхОбОператореЭДО.Количество() > 0 Тогда
		Результат = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаДанныхОбОператореЭДО[0]);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Получает данные оператора ЭДО по идентификатору
// 
// Параметры:
//  ОператорЭДО - Строка
// 
// Возвращаемое значение:
//  Структура:
//  * ИНН - Строка
//  * КПП - Строка
//  * ОГРН - Строка
//  * Сертификат - Строка
//  * СпособОбмена - ПеречислениеСсылка.СпособыОбменаЭД
//  * Код - Строка
//  * Наименование - Строка
Функция АктуальныеДанныеОператораЭДО(ОператорЭДО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОператорыЭДО.ИНН КАК ИНН,
		|	ОператорыЭДО.КПП КАК КПП,
		|	ОператорыЭДО.ОГРН КАК ОГРН,
		|	ОператорыЭДО.ОтпечатокСертификата КАК Сертификат,
		|	ОператорыЭДО.СпособОбменаЭД КАК СпособОбмена,
		|	ОператорыЭДО.ИдентификаторОператора КАК Код,
		|	ОператорыЭДО.Представление КАК Наименование
		|ИЗ
		|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
		|ГДЕ
		|	ОператорыЭДО.ИдентификаторОператора = &ИдентификаторОператора";
	
	Запрос.УстановитьПараметр("ИдентификаторОператора", ОператорЭДО);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	СтрокаРезультат = РезультатЗапроса.Выгрузить()[0];
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаРезультат);
	
КонецФункции

// Параметры:
//  ОператорЭДО - Строка
// 
// Возвращаемое значение:
//  Булево
Функция ПриРегистрацииПредставителяТребуетсяМЧД(ОператорЭДО) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОператорыЭДО.ПриРегистрацииПредставителяТребуетсяМЧД КАК ПриРегистрацииПредставителяТребуетсяМЧД
		|ИЗ
		|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
		|ГДЕ
		|	ОператорыЭДО.ИдентификаторОператора = &ИдентификаторОператора
		|	И ОператорыЭДО.ПриРегистрацииПредставителяТребуетсяМЧД = &ПризнакТребуется";
		
	Запрос.УстановитьПараметр("ИдентификаторОператора", ОператорЭДО);
	Запрос.УстановитьПараметр("ПризнакТребуется", "Требуется");
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат Не РезультатЗапроса.Пустой();
	
КонецФункции

// Параметры:
//  ИдентификаторОператора - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ВерсияПоддерживаемогоРегистрационногоПакета(ИдентификаторОператора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОператорыЭДО.ВерсияПоддерживаемогоРегистрационногоПакета КАК ВерсияПоддерживаемогоРегистрационногоПакета
		|ИЗ
		|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
		|ГДЕ
		|	ОператорыЭДО.ДоступноПодключениеЧерез1С
		|	И ОператорыЭДО.ИдентификаторОператора = &ИдентификаторОператора";
		
	Запрос.УстановитьПараметр("ИдентификаторОператора", ИдентификаторОператора);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		
		МинимальнаяВерсияРегПакета = "5.02"; // Минимальная версия, которая поддержана в текущей версии конифгурации
		МаксимальнаяВерсияРегПакета = "5.03"; // Максимальная версия, которая поддержана в текущей версии конфигурации
		
		Версия = Выборка.ВерсияПоддерживаемогоРегистрационногоПакета;
		Если Не ЗначениеЗаполнено(Версия) Тогда
			Версия = МинимальнаяВерсияРегПакета;
		ИначеЕсли СервисЭДОКлиентСервер.СравнитьВерсииФорматовРегистрации(Версия, МинимальнаяВерсияРегПакета) < 0 Тогда
			Версия = МинимальнаяВерсияРегПакета;
		ИначеЕсли СервисЭДОКлиентСервер.СравнитьВерсииФорматовРегистрации(Версия, МаксимальнаяВерсияРегПакета) > 0 Тогда
			Версия = МаксимальнаяВерсияРегПакета;
		КонецЕсли;
		
		Возврат Версия;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

// Параметры:
//  ИдентификаторОператора - Строка
// 
// Возвращаемое значение:
//  Строка
Функция ОператорПоддерживаетОбменБезПриглашений(ИдентификаторОператора) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ОператорыЭДО.ПоддерживаетсяОбменБезПриглашений КАК ПоддерживаетсяОбменБезПриглашений
		|ИЗ
		|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО
		|ГДЕ
		|	ОператорыЭДО.ДоступноПодключениеЧерез1С
		|	И ОператорыЭДО.ИдентификаторОператора = &ИдентификаторОператора";
		
	Запрос.УстановитьПараметр("ИдентификаторОператора", ИдентификаторОператора);
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.ПоддерживаетсяОбменБезПриглашений;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

// Возвращаемое значение:
//  ТаблицаЗначений:
//	* ИдентификаторОператора - Строка
//	* Представление - Строка
//	* СпособОбменаЭД - ПеречислениеСсылка.СпособыОбменаЭД
//	* СсылкаНаСтраницуТехническойПоддержки - Строка
Функция ТаблицаОператоровЭДО() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОператорыЭДО.ИдентификаторОператора КАК ИдентификаторОператора,
		|	ОператорыЭДО.Представление КАК Представление,
		|	ОператорыЭДО.СпособОбменаЭД КАК СпособОбменаЭД,
		|	ОператорыЭДО.СсылкаНаСтраницуТехническойПоддержки КАК СсылкаНаСтраницуТехническойПоддержки
		|ИЗ
		|	РегистрСведений.ОператорыЭДО КАК ОператорыЭДО";
	
	РезультатЗапроса = Запрос.Выполнить();
	
