// @strict-types

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Метод-конструктор сведении о сообщении ЭДО.
// 
// Возвращаемое значение:
//  Структура - Новые сведения о сообщении:
// * ИмяФайла - Строка - Имя файла сообщения ЭДО
// * ИдентификаторДокументооборота - Строка - Идентификатор документооборота сообщения ЭДО
// * ФайлСообщенияЭДО - СправочникСсылка.СообщениеЭДОПрисоединенныеФайлы - Ссылка на сообщение ЭДО
Функция НовыеСведенияОСообщении() Экспорт
	
	Результат = Новый Структура;
	
	Результат.Вставить("ИмяФайла"                      , "");
	Результат.Вставить("ИдентификаторДокументооборота" , "");
	Результат.Вставить("ФайлСообщенияЭДО"              , Справочники.СообщениеЭДОПрисоединенныеФайлы.ПустаяСсылка());

	Возврат Результат;
	
КонецФункции

// Фиксирует сведения о сообщении ЭДО для дальнейшего поиска.
// 
// Параметры:
//  Сведения - См. НовыеСведенияОСообщении
Процедура Зафиксировать(Знач Сведения) Экспорт
	
	// Проверка входных параметров	
	КонтекстПроверки = "РегистрСведений.СведенияОФайлахСообщенийЭДО.Зафиксировать";
	
	ПроверитьНеПустаяСтрока(
		КонтекстПроверки, 
		"Сведения.ИмяФайла",
		Сведения.ИмяФайла); 
	ПроверитьНеПустаяСтрока(
		КонтекстПроверки, 
		"Сведения.ИдентификаторДокументооборота",
		Сведения.ИдентификаторДокументооборота); 
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		КонтекстПроверки, 
		"Сведения.ФайлСообщенияЭДО",
		Сведения.ФайлСообщенияЭДО, 
		Тип("СправочникСсылка.СообщениеЭДОПрисоединенныеФайлы"));
	
	Хеш = Хеш(Сведения.ИмяФайла);
	
	НачатьТранзакцию();
	Попытка
		УстановитьБлокировку(Хеш);
		
		НаборЗаписей = СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Хеш.Установить(Хеш);
		
		Запись = НаборЗаписей.Добавить();
		
		Запись.Хеш                           = Хеш;
		Запись.ИдентификаторДокументооборота = Сведения.ИдентификаторДокументооборота;
		Запись.ИмяФайла                      = Сведения.ИмяФайла;
		Запись.ФайлСообщенияЭДО              = Сведения.ФайлСообщенияЭДО;
		
		// Записываем данные
		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать(Истина);
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Получает сведения о сообщении ЭДО по имени файла
// 
// Параметры:
//  ИмяФайла - Строка - Имя файла сообщения ЭДО
// 
// Возвращаемое значение:
//  Неопределено
//  См. НовыеСведенияОСообщении
Функция СведенияОСообщении(Знач ИмяФайла) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Хеш", Хеш(ИмяФайла));
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Сведения.ИдентификаторДокументооборота КАК ИдентификаторДокументооборота,
		|	Сведения.ФайлСообщенияЭДО КАК ФайлСообщенияЭДО
		|ИЗ
		|	РегистрСведений.СведенияОФайлахСообщенийЭДО КАК Сведения
		|ГДЕ
		|	Сведения.Хеш = &Хеш";
	
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		Результат = НовыеСведенияОСообщении();
		
		ИдентификаторДокументооборота = Выборка.ИдентификаторДокументооборота; // Строка
		ФайлСообщенияЭДО              = Выборка.ФайлСообщенияЭДО; // СправочникиСсылка.СообщениеЭДОПрисоединенныеФайлы
		
		Результат.ИдентификаторДокументооборота = ИдентификаторДокументооборота;
		Результат.ИмяФайла                      = ИмяФайла;
		Результат.ФайлСообщенияЭДО              = ФайлСообщенияЭДО;
		
		Возврат Результат;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

#Область ОбновлениеВерсииИБ

// См. ОбновлениеИнформационнойБазыБСП.ПриДобавленииОбработчиковОбновления.
Процедура ПриДобавленииОбработчиковОбновления(Обработчики) Экспорт
	
	Обработчик = Обработчики.Добавить();
	Обработчик.Идентификатор = Новый УникальныйИдентификатор("b4e1f7a2-3c8d-4e6f-9a1b-7d5c2e8f4a09");
	Обработчик.Версия = "1.9.16.73";
	Обработчик.РежимВыполнения = "Отложенно";
	Обработчик.Многопоточный = Истина;
	Обработчик.Процедура = "РегистрыСведений.СведенияОФайлахСообщенийЭДО.ОбработатьДанныеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураЗаполненияДанныхОбновления =
		"РегистрыСведений.СведенияОФайлахСообщенийЭДО.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию";
	Обработчик.ПроцедураПроверки = "ОбновлениеИнформационнойБазы.ДанныеОбновленыНаНовуюВерсиюПрограммы";
	Обработчик.ЧитаемыеОбъекты = "РегистрСведений.СведенияОФайлахСообщенийЭДО";
	Обработчик.ИзменяемыеОбъекты = "РегистрСведений.СведенияОФайлахСообщенийЭДО";
	Обработчик.БлокируемыеОбъекты = "РегистрСведений.СведенияОФайлахСообщенийЭДО";
	Обработчик.Комментарий = //@skip-check module-nstr-camelcase 
		НСтр(
			"ru= 'Сервис 1С:EDI.
			|Заполнение ведущего измерения ФайлСообщенияЭДО в регистре СведенияОФайлахСообщенийЭДО.
			|Требуется для каскадного удаления записей при очистке присоединенных файлов сообщений ЭДО.'",
			ОбщегоНазначения.КодОсновногоЯзыка());
	
КонецПроцедуры

// Регистрирует записи регистра, для которых требуется заполнить
// новое ведущее измерение ФайлСообщенияЭДО значениями из реквизита УдалитьФайлСообщенияЭДО.
//
// Параметры:
//  Параметры - См. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
//
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПолноеИмяРегистра = Метаданные.РегистрыСведений.СведенияОФайлахСообщенийЭДО.ПолноеИмя();
	
	ПараметрыВыборки = Параметры.ПараметрыВыборки;
	ПараметрыВыборки.СпособВыборки        = ОбновлениеИнформационнойБазы.СпособВыборкиИзмеренияНезависимогоРегистраСведений();
	ПараметрыВыборки.ПолныеИменаРегистров = ПолноеИмяРегистра;
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	ДополнительныеПараметры.ЭтоНезависимыйРегистрСведений = Истина;
	ДополнительныеПараметры.ПолноеИмяРегистра             = ПолноеИмяРегистра;
	
	РазмерПорции = 1000;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ ПЕРВЫЕ 999
		|	Сведения.Хеш КАК Хеш
		|ИЗ
		|	РегистрСведений.СведенияОФайлахСообщенийЭДО КАК Сведения
		|ГДЕ
		|	Сведения.ФайлСообщенияЭДО = ЗНАЧЕНИЕ(Справочник.СообщениеЭДОПрисоединенныеФайлы.ПустаяСсылка)
		|	И Сведения.УдалитьФайлСообщенияЭДО <> ЗНАЧЕНИЕ(Справочник.СообщениеЭДОПрисоединенныеФайлы.ПустаяСсылка)
		|	И Сведения.Хеш > &Хеш
		|
		|УПОРЯДОЧИТЬ ПО
		|	Хеш";
	
	Запрос.Текст = СтрЗаменить(
		Запрос.Текст, 
		"ПЕРВЫЕ 999", 
		СтрШаблон(
			"ПЕРВЫЕ %1", 
			Формат(РазмерПорции, "ЧГ=0")));
	
	Хеш = "";
	
	Пока Истина Цикл
		
		Запрос.УстановитьПараметр("Хеш", Хеш);
		//@skip-check query-in-loop - Порционная обработка данных
		Выгрузка = Запрос.Выполнить().Выгрузить();
		
		КоличествоСтрок = Выгрузка.Количество();
		
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Выгрузка, ДополнительныеПараметры);
		
		Если КоличествоСтрок < РазмерПорции Тогда
			Прервать;
		КонецЕсли;
		
		//@skip-check property-return-type - Особенность работы с выборкой из запроса
		Хеш = Выгрузка[КоличествоСтрок - 1].Хеш; // Строка
		
	КонецЦикла;
	
КонецПроцедуры

// Обработчик обновления: переносит значение из реквизита УдалитьФайлСообщенияЭДО
// в новое ведущее измерение ФайлСообщенияЭДО для зарегистрированных ранее записей.
//
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазыСлужебный.НовоеОписаниеОбрабатываемыхДанных
//
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	МетаданныеОбъекта = Метаданные.РегистрыСведений.СведенияОФайлахСообщенийЭДО;
	ПолноеИмяОбъекта  = МетаданныеОбъекта.ПолноеИмя();
	ЕстьЗаблокированные = ОбновлениеИнформационнойБазы.ЕстьЗаблокированныеПредыдущимиОчередямиДанные(
		Параметры.Очередь,
		ПолноеИмяОбъекта);

	Если ЕстьЗаблокированные Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, 
			ПолноеИмяОбъекта);
		Возврат;
	КонецЕсли;
	
	ДанныеДляОбновления = ОбновлениеИнформационнойБазы.ДанныеДляОбновленияВМногопоточномОбработчике(Параметры);
	
	Если ДанныеДляОбновления.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
			Параметры.Очередь, ПолноеИмяОбъекта);
		Возврат;
	КонецЕсли;
	
	ПараметрыОтметкиВыполнения = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыОтметкиОбработки();
	
	ОбработанныхОбъектов = 0;
	ПроблемныхОбъектов   = 0;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Для Каждого КлючЗаписи Из ДанныеДляОбновления Цикл
		
		НачатьТранзакцию();
		Попытка
			
			//@skip-check property-return-type - Универсальная коллекция 
			Хеш = КлючЗаписи.Хеш; // Строка
			Записывать = Ложь;
			
			УстановитьБлокировку(Хеш);
			
			НаборЗаписей = СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Хеш.Установить(Хеш);
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				ОбработатьФайлСообщенияЭДО(Запись, Записывать);
			КонецЦикла;
			
			Если Записывать Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(НаборЗаписей, ПараметрыОтметкиВыполнения);
			КонецЕсли;
			
			ОбработанныхОбъектов = ОбработанныхОбъектов + 1;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			
			ОтменитьТранзакцию();
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ТекстСообщения = СтрШаблон(
				НСтр(
					"ru = 'Не удалось заполнить измерение Файл сообщения ЭДО по записи %1 по причине:
					|%2'", 
					ОбщегоНазначения.КодОсновногоЯзыка()),
				Хеш,
				ТекстОшибки);
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
				УровеньЖурналаРегистрации.Ошибка, , ,
				ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ОбработанныхОбъектов = 0 И ПроблемныхОбъектов <> 0 Тогда
		ШаблонСообщения = НСтр("ru = 'Не удалось обработать некоторые Сведения о файлах сообщений ЭДО: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ПроблемныхОбъектов);
		ВызватьИсключение ТекстСообщения;
	Иначе
		ШаблонСообщения = НСтр("ru = 'Обработана очередная порция Сведения о файлах сообщений ЭДО: %1'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОбработанныхОбъектов);
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			МетаданныеОбъекта,, ТекстСообщения);
	КонецЕсли;
	
	//@skip-check property-return-type - Отсутствует документация БСП
	Параметры.ПрогрессВыполнения.ОбработаноОбъектов =
		Параметры.ПрогрессВыполнения.ОбработаноОбъектов + ОбработанныхОбъектов;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(
		Параметры.Очередь, ПолноеИмяОбъекта);

КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Вычисляет Хеш имени файла
// 
// Параметры:
//  ИмяФайла - Строка - Имя файла
// 
// Возвращаемое значение:
//  Строка - Хеш имени файла
Функция Хеш(Знач ИмяФайла)
	Возврат ОбщегоНазначения.КонтрольнаяСуммаСтрокой(ИмяФайла);
КонецФункции

// Параметры:
//  Контекст          - Строка
//  ИмяПараметра      - Строка
//  ЗначениеПараметра - Строка
Процедура ПроверитьНеПустаяСтрока(Знач Контекст, Знач ИмяПараметра, Знач ЗначениеПараметра)
	
	ОбщегоНазначенияКлиентСервер.ПроверитьПараметр(
		Контекст,
		ИмяПараметра,
		ЗначениеПараметра,
		Тип("Строка"));
	ОбщегоНазначенияКлиентСервер.Проверить(
		Не ПустаяСтрока(ЗначениеПараметра),
		СтрШаблон(
			НСтр(
				"ru = 'Значение параметра %1 не может содержать пустую строку'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			ИмяПараметра),
		Контекст);
	
КонецПроцедуры

// Параметры:
//  Хеш - Строка
Процедура УстановитьБлокировку(Знач Хеш)
	
	ИмяПространстваБлокировки = Метаданные.РегистрыСведений.СведенияОФайлахСообщенийЭДО.ПолноеИмя();
	
	БлокировкаДанных = Новый БлокировкаДанных;
	
	ЭлементБлокировки = БлокировкаДанных.Добавить(ИмяПространстваБлокировки);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.УстановитьЗначение("Хеш", Хеш);

	//@skip-check lock-out-of-try - особенность реализации метода
	БлокировкаДанных.Заблокировать();
	
КонецПроцедуры

// Параметры:
//  Запись     - РегистрСведенийЗапись.СведенияОФайлахСообщенийЭДО
//  Записывать - Булево
Процедура ОбработатьФайлСообщенияЭДО(Запись, Записывать)
	
	Если Не Запись.ФайлСообщенияЭДО.Пустая()
		Или Запись.УдалитьФайлСообщенияЭДО.Пустая() Тогда
		Возврат; // Ранее обработанная запись
	КонецЕсли;
	
	Запись.ФайлСообщенияЭДО        = Запись.УдалитьФайлСообщенияЭДО;
	Запись.УдалитьФайлСообщенияЭДО = Справочники.СообщениеЭДОПрисоединенныеФайлы.ПустаяСсылка();
	Записывать                     = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
