КонецФункции

Функция ТекстЗапросаДокументыРеализации()
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТоварыПереданные.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ТоварыПереданные.Соглашение КАК Соглашение,
	|	ТоварыПереданные.Организация КАК Организация,
	|	ТоварыПереданные.ВидЗапасов КАК ВидЗапасов,
	|	ТоварыПереданные.НомерГТД КАК НомерГТД,
	|	ТоварыПереданные.КоличествоОстаток КАК КоличествоОстаток,
	|	ТоварыПереданные.КоличествоПоРНПТОстаток КАК КоличествоПоРНПТОстаток
	|ПОМЕСТИТЬ ТоварыПереданные
	|ИЗ
	|	РегистрНакопления.ТоварыПереданныеНаКомиссию.Остатки(
	|			,
	|			АналитикаУчетаНоменклатуры.МестоХранения <> ЗНАЧЕНИЕ(Справочник.Партнеры.НашеПредприятие)
	|				И АналитикаУчетаНоменклатуры.ТипМестаХранения = ЗНАЧЕНИЕ(Перечисление.ТипыМестХранения.Партнер)) КАК ТоварыПереданные
	|ГДЕ
	|	ТоварыПереданные.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТоварыПереданные.Соглашение КАК Соглашение,
	|	ТоварыПереданные.Организация КАК Организация,
	|	ТоварыПереданные.АналитикаУчетаНоменклатуры КАК АналитикаУчетаНоменклатуры,
	|	ТоварыПереданные.АналитикаУчетаНоменклатуры.Номенклатура КАК Номенклатура,
	|	ТоварыПереданные.АналитикаУчетаНоменклатуры.Характеристика КАК Характеристика,
	|	ТоварыПереданные.ВидЗапасов КАК ВидЗапасов,
	|	ТоварыПереданные.НомерГТД КАК НомерГТД,
	|	ТоварыПереданные.КоличествоОстаток КАК КоличествоОстаток,
	|	ТоварыПереданные.КоличествоПоРНПТОстаток КАК КоличествоПоРНПТОстаток,
	|	ТоварыПереданныеДвижения.Регистратор КАК Регистратор,
	|	(ТоварыПереданныеДвижения.Количество - ЕСТЬNULL(ТоварыПереданныеДвиженияВозвратов.Количество,0)) КАК Количество,
	|	(ТоварыПереданныеДвижения.КоличествоПоРНПТ - ЕСТЬNULL(ТоварыПереданныеДвиженияВозвратов.КоличествоПоРНПТ,0)) КАК КоличествоПоРНПТ
	|ИЗ
	|	ТоварыПереданные КАК ТоварыПереданные
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыПереданныеНаКомиссию КАК ТоварыПереданныеДвижения
	|		ПО ТоварыПереданные.АналитикаУчетаНоменклатуры = ТоварыПереданныеДвижения.АналитикаУчетаНоменклатуры
	|			И ТоварыПереданные.Соглашение = ТоварыПереданныеДвижения.Соглашение
	|			И ТоварыПереданные.Организация = ТоварыПереданныеДвижения.Организация
	|			И ТоварыПереданные.ВидЗапасов = ТоварыПереданныеДвижения.ВидЗапасов
	|			И ТоварыПереданные.НомерГТД = ТоварыПереданныеДвижения.НомерГТД
	|			И (ТоварыПереданныеДвижения.ХозяйственнаяОперация = &ХозяйственнаяОперация)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ТоварыПереданныеНаКомиссию КАК ТоварыПереданныеДвиженияВозвратов
	|		ПО ТоварыПереданные.АналитикаУчетаНоменклатуры = ТоварыПереданныеДвиженияВозвратов.АналитикаУчетаНоменклатуры
	|			И (ТоварыПереданныеДвиженияВозвратов.ХозяйственнаяОперация = &ХозяйственнаяОперацияВозврата)
	|			И (ТоварыПереданныеДвиженияВозвратов.Регистратор.ДокументРеализации = ТоварыПереданныеДвижения.Регистратор)
	|			И (ТоварыПереданныеДвиженияВозвратов.ВидЗапасов = ТоварыПереданныеДвижения.ВидЗапасов)
	|			И (ТоварыПереданныеДвиженияВозвратов.НомерГТД = ТоварыПереданныеДвижения.НомерГТД)
	|ГДЕ
	|	(ТоварыПереданныеДвижения.Количество - ЕСТЬNULL(ТоварыПереданныеДвиженияВозвратов.Количество,0)) > 0
	|УПОРЯДОЧИТЬ ПО ТоварыПереданныеДвижения.Регистратор.Дата УБЫВ";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Процедура ЗаписатьОшибкуСозданияОбъектаВЖурнал(СобытиеЖурналаРегистрации, ПредставлениеОшибки, ПредставлениеЭлемента)
	
	ШаблонСообщения = НСтр("ru = 'Не удалось скопировать %1 по причине:
								 |%2'");
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		ПредставлениеЭлемента,
		ПредставлениеОшибки);
	
	ЗаписьЖурналаРегистрации(
		СобытиеЖурналаРегистрации,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

Процедура ЗаписатьОшибкуПроведенияДокументаВЖурнал(СобытиеЖурналаРегистрации, ПредставлениеОшибки, Элемент1, Элемент2)
	
	ШаблонСообщения = НСтр("ru = 'Не удалось провести пару документов возврата (%1) и передачи (%2) по причине:
								 |%3.
								 |Необходимо вручную провести документы, устранив ошибки.'");
	
	ПредставлениеЭлемента1 = ОбщегоНазначения.ПредметСтрокой(Элемент1);
	ПредставлениеЭлемента2 = ОбщегоНазначения.ПредметСтрокой(Элемент2);
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		ПредставлениеЭлемента1,
		ПредставлениеЭлемента2,
		ПредставлениеОшибки);
	
	ЗаписьЖурналаРегистрации(
		СобытиеЖурналаРегистрации,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

Процедура ЗаписатьОшибкуЗаписиДокументаВЖурнал(СобытиеЖурналаРегистрации, ПредставлениеОшибки)
	
	ШаблонСообщения = НСтр("ru = 'Не удалось записать пару документов по причине:
								 |%1.
								 |Неперенесенные остатки необходимо отразить вручную.'");
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		ПредставлениеОшибки);
	
	ЗаписьЖурналаРегистрации(
		СобытиеЖурналаРегистрации,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

Процедура ЗаписатьОшибкуПоискаДокументаВЖурнал(СобытиеЖурналаРегистрации, ПартнерПредставление, СоглашениеПредставление)
	
	ШаблонСообщения = НСтр("ru = 'Не удалось найти документ реализации для формирования возврата от %1 по соглашению %2.
								 |Необходимо отразить возврат и передачу вручную.'");
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонСообщения,
		ПартнерПредставление,
		СоглашениеПредставление);
	
	ЗаписьЖурналаРегистрации(
		СобытиеЖурналаРегистрации,
		УровеньЖурналаРегистрации.Ошибка,
		,
		,
		ТекстСообщения);
	
КонецПроцедуры

Процедура ЗаполнитьКомментарий(Комментарий, Очищать = Ложь, ДопСведения = "")
	
	Если ЗначениеЗаполнено(Комментарий) И Не Очищать Тогда
		Комментарий = Комментарий + Символы.ПС;
	КонецЕсли;
	
	Комментарий = Комментарий + НСтр("ru = '[Объект создан помощником перехода%1]'");
	
	Комментарий = СтрШаблон(Комментарий, ДопСведения);
	
КонецПроцедуры

