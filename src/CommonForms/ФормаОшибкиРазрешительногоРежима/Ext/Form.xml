							</Events>
						</LabelDecoration>
						<LabelDecoration name="Пункт3Токен" id="64">
							<AutoMaxWidth>false</AutoMaxWidth>
							<Title formatted="true">
								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>3. &lt;color #1c55ae&gt;&lt;link АктуализацияСпискаCDNПлощадок&gt;Актуализируйте&lt;/&gt;&lt;/&gt; список CDN-площадок.</v8:content>
